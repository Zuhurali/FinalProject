@{
    ViewData["Title"] = "Blog Two - AutoVault";
}

<!-- Content based on blog-2.html -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Blog Two</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Blog</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-blog-area rts-section-gap">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="blog-wrapper">
                    <div class="image-area">
                        <a asp-controller="Blog" asp-action="Details" asp-route-id="1"><img src="~/assets/images/blog/01.webp" alt=""></a>
                    </div>
                    <div class="blog-content-area">
                        <div class="blog-meta">
                            <a href="#" class="date">March 26, 2024</a>
                            <a href="#" class="tag">Automotive</a>
                        </div>
                        <h4 class="title"><a asp-controller="Blog" asp-action="Details" asp-route-id="1">Latest Trends in Electric Vehicles</a></h4>
                        <p class="desc">Explore the cutting-edge developments in electric vehicle technology and what the future holds for sustainable transportation.</p>
                        <a asp-controller="Blog" asp-action="Details" asp-route-id="1" class="rts-btn">Read More</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="blog-sidebar">
                    <div class="sidebar-widget">
                        <h4>Recent Posts</h4>
                        <ul class="recent-posts">
                            <li><a asp-controller="Blog" asp-action="Details" asp-route-id="2">Car Maintenance Tips</a></li>
                            <li><a asp-controller="Blog" asp-action="Details" asp-route-id="3">Best Cars for 2024</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>