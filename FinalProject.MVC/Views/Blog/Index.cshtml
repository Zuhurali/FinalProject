@{
    ViewData["Title"] = "Blog - AutoVault";

    var posts = new[]
    {
        new { Id = 1, Image = "01.webp", Meta = "Dealership events", Title = "Seasonal Car Care Tips to Keep Your Vehicle Running Smoothly", AuthorImage = "author-01.svg" },
        new { Id = 2, Image = "02.webp", Meta = "March 26, 2024", Title = "How Regular Maintenance Can Save You Thousands in Repairs", AuthorImage = "author-02.svg" },
        new { Id = 3, Image = "02.webp", Meta = "Car detailing tips", Title = "Top 5 Reasons to Buy a Certified Pre-Owned Vehicle", AuthorImage = "author-02.svg" },
        new { Id = 4, Image = "06.webp", Meta = "Upcoming releases", Title = "What to Expect During Your Next Test Drive", AuthorImage = "author-02.svg" },
        new { Id = 5, Image = "07.webp", Meta = "Family Cars", Title = "The Best Cars for Road Trips: Comfort, Safety, and Reliability", AuthorImage = "author-02.svg" },
        new { Id = 6, Image = "08.webp", Meta = "Luxury Cars", Title = "Certified Pre-Owned vs. Used Cars: What's the Difference", AuthorImage = "author-02.svg" },
        new { Id = 7, Image = "09.webp", Meta = "Trade-In Value", Title = "Leasing vs. Buying: Which Option is Right for You", AuthorImage = "author-02.svg" },
        new { Id = 8, Image = "10.webp", Meta = "Hybrid Vehicles", Title = "The Latest Trends in Car You Should Know About", AuthorImage = "author-02.svg" }
    };
}

<!-- rts breadcrumb area start -->
<div class="rts-breadcrumb-area portfolio jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Blog</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Blog</a>
            </div>
        </div>
    </div>
</div>
<!-- rts breadcrumb area end -->

<div class="rts-blog-area inner rts-section-gapTop">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="left">
                    <div class="row g-5" id="blogPostGrid">
                        @for (var i = 0; i < posts.Length; i++)
                        {
                            var post = posts[i];
                            <div class="col-lg-6 blog-load-card@(i >= 4 ? " d-none" : "")">
                                <div class="blog-wrapper">
                                    <div class="image-area">
                                        <a asp-controller="Blog" asp-action="Details" asp-route-id="@post.Id"><img src="~/assets/images/blog/@post.Image" alt=""></a>
                                    </div>
                                    <div class="content">
                                        <p class="blog-meta">@post.Meta</p>
                                        <h6><a asp-controller="Blog" asp-action="Details" asp-route-id="@post.Id">@post.Title</a></h6>
                                        <div class="author-date">
                                            <div class="person">
                                                <img src="~/assets/images/blog/@post.AuthorImage" alt="">
                                                Jack Alexander
                                            </div>
                                            <div class="date">March 26, 2024</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <a href="#" id="blogLoadMore" class="rts-btn load-more-btn btn-border">Load More</a>
            </div>
            <div class="col-lg-4">
                <div class="sticky-top">
                    <div class="right-side-bar">
                        <div class="search-area side-box">
                            <h2>Cars Search</h2>
                            <form id="blogCarSearch" action="#">
                                <div class="input-wrapper">
                                    <input type="text" placeholder="Search Vehicles" required>
                                    <button type="submit"><i class="fa-regular fa-magnifying-glass"></i></button>
                                </div>
                            </form>
                        </div>
                        <div class="car-make side-box">
                            <h2>Car Categories</h2>
                            <ul class="checkbox-list">
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox" checked>
                                        <span>Mercedes-Benz</span>
                                    </label>
                                    <span>(130)</span>
                                </li>
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox">
                                        <span>Volkswagen</span>
                                    </label>
                                    <span>(80)</span>
                                </li>
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox">
                                        <span>Mitsubishi</span>
                                    </label>
                                    <span>(199)</span>
                                </li>
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox">
                                        <span>Honda</span>
                                    </label>
                                    <span>(70)</span>
                                </li>
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox">
                                        <span>Lamborghini</span>
                                    </label>
                                    <span>(160)</span>
                                </li>
                            </ul>
                        </div>
                        <div class="recent-post side-box">
                            <h2>Recent Post</h2>
                            <ul class="blog-list">
                                <li>
                                    <div class="image-area">
                                        <a asp-controller="Blog" asp-action="Details" asp-route-id="1">
                                            <img src="~/assets/images/blog/sm-01.webp" width="100" alt="">
                                        </a>
                                    </div>
                                    <div class="content">
                                        <h6><a asp-controller="Blog" asp-action="Details" asp-route-id="1">10 Tips for First-Time Car What You Need to Know</a></h6>
                                        <p class="blog-meta">May 26, 2024</p>
                                    </div>
                                </li>
                                <li>
                                    <div class="image-area">
                                        <a asp-controller="Blog" asp-action="Details" asp-route-id="2">
                                            <img src="~/assets/images/blog/sm-02.webp" width="100" alt="">
                                        </a>
                                    </div>
                                    <div class="content">
                                        <h6><a asp-controller="Blog" asp-action="Details" asp-route-id="2">Top 5 Reasons to Buy a for Pre-Owned Vehicle</a></h6>
                                        <p class="blog-meta">May 26, 2024</p>
                                    </div>
                                </li>
                                <li>
                                    <div class="image-area">
                                        <a asp-controller="Blog" asp-action="Details" asp-route-id="3">
                                            <img src="~/assets/images/blog/sm-03.webp" width="100" alt="">
                                        </a>
                                    </div>
                                    <div class="content">
                                        <h6><a asp-controller="Blog" asp-action="Details" asp-route-id="3">How to Choose the Perfect Car for Your Lifestyle</a></h6>
                                        <p class="blog-meta">May 26, 2024</p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="tag-area side-box">
                            <h2>Fuel</h2>
                            <ul>
                                <li>Gasoline</li>
                                <li>Diesel</li>
                                <li>Plug-in Hybrid</li>
                                <li>Hybrid</li>
                                <li>Electric</li>
                            </ul>
                        </div>
                        <div class="ad-area">
                            <img src="~/assets/images/blog/ad.webp" alt="">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_DealershipCallCta" />

@section Scripts {
    <script>
        (function () {
            var grid = document.getElementById("blogPostGrid");
            var button = document.getElementById("blogLoadMore");
            var searchForm = document.getElementById("blogCarSearch");
            var batchSize = 2;

            if (searchForm) {
                searchForm.addEventListener("submit", function (event) {
                    event.preventDefault();
                });
            }

            if (!grid || !button) {
                return;
            }

            function hiddenCards() {
                return grid.querySelectorAll(".blog-load-card.d-none");
            }

            if (hiddenCards().length === 0) {
                button.style.display = "none";
            }

            button.addEventListener("click", function (event) {
                event.preventDefault();
                var cards = hiddenCards();
                var count = Math.min(batchSize, cards.length);

                for (var i = 0; i < count; i++) {
                    cards[i].classList.remove("d-none");
                }

                if (hiddenCards().length === 0) {
                    button.style.display = "none";
                }
            });
        })();
    </script>
}
