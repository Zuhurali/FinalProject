        new { Id = 2, Meta = "March 26, 2024", Title = "How Regular Maintenance Can Save You Thousands in Repairs", Image = "~/assets/images/blog/02.webp", CardImage = "02.webp", CardTitle = "How Regular Maintenance Can Save You Thousands in Repairs", AuthorImage = "author-02.svg" },
