                            <a href="#" class="reply-btn"><img src="~/assets/images/icon/reply.svg" alt="">Reply</a>
                        </div>
                        <div class="comment-box mb--30">
                            <div class="author">
                                <div class="image"><img src="~/assets/images/testimonials/author-02.svg" alt=""></div>
                                <div class="content">
