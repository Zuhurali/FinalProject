        new { Id = 4, Meta = "Upcoming releases", Title = "What to Expect During Your Next Test Drive", Image = "~/assets/images/blog/06.webp", CardImage = "06.webp", CardTitle = "What to Expect During Your Next Test Drive", AuthorImage = "author-02.svg" },
        new { Id = 5, Meta = "Family Cars", Title = "The Best Cars for Road Trips: Comfort, Safety, and Reliability", Image = "~/assets/images/blog/07.webp", CardImage = "07.webp", CardTitle = "The Best Cars for Road Trips: Comfort, Safety, and Reliability", AuthorImage = "author-02.svg" },
        new { Id = 6, Meta = "Luxury Cars", Title = "Certified Pre-Owned vs. Used Cars: What's the Difference", Image = "~/assets/images/blog/08.webp", CardImage = "08.webp", CardTitle = "Certified Pre-Owned vs. Used Cars: What's the Difference", AuthorImage = "author-02.svg" },
        new { Id = 7, Meta = "Trade-In Value", Title = "Leasing vs. Buying: Which Option is Right for You", Image = "~/assets/images/blog/09.webp", CardImage = "09.webp", CardTitle = "Leasing vs. Buying: Which Option is Right for You", AuthorImage = "author-02.svg" },
        new { Id = 8, Meta = "Hybrid Vehicles", Title = "The Latest Trends in Car You Should Know About", Image = "~/assets/images/blog/10.webp", CardImage = "10.webp", CardTitle = "The Latest Trends in Car You Should Know About", AuthorImage = "author-02.svg" }
