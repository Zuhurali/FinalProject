                                                Jack Alexander
                                            </div>
                                            <div class="date">March 26, 2024</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 related-blog">
                                <div class="blog-wrapper">
                                    <div class="image-area">
                                        <a asp-controller="Blog" asp-action="Details" asp-route-id="2"><img src="~/assets/images/blog/02.webp" alt=""></a>
                                    </div>
                                    <div class="content">
                                        <p class="blog-meta">March 26, 2024</p>
                                        <h6><a asp-controller="Blog" asp-action="Details" asp-route-id="2">How Regular Maintenance Can Save You Thousands in Repairs</a></h6>
