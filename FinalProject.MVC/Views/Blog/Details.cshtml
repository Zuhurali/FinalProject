<!-- rts breadcrumb area start -->
<div class="rts-breadcrumb-area blog-details jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <div class="left">
                <p>@post.Meta</p>
                <h1 class="title">@Html.Raw(post.Title)</h1>
                <div class="author-area">
                    <div class="image">
                        <img src="~/assets/images/testimonials/author-01.svg" alt="">
                    </div>
                    <ul>
                        <li>Jack Alexander </li>
                        <li>March 26, 2024</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- rts breadcrumb area end -->

