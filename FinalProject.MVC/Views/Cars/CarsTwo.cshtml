@model IReadOnlyList<FinalProject.MVC.Models.Car>
@{
    ViewData["Title"] = "Cars Two - AutoVault";
    var makes = Model.GroupBy(car => car.Make).OrderBy(group => group.Key).Select(group => new { Name = group.Key, Count = group.Count() }).ToList();
    var brandIds = ViewData["BrandIds"] as IReadOnlyDictionary<string, int> ?? new Dictionary<string, int>();
    var fuels = Model.GroupBy(car => car.Fuel).OrderBy(group => group.Key).Select(group => group.Key).ToList();
    var minPrice = Model.Count == 0 ? 0 : Model.Min(car => car.Price);
    var maxPrice = Model.Count == 0 ? 0 : Model.Max(car => car.Price);
    var seatOptions = ViewData["SeatOptions"] as IReadOnlyList<FinalProject.MVC.Controllers.CarsTwoSeatOption> ?? Array.Empty<FinalProject.MVC.Controllers.CarsTwoSeatOption>();
    var selectedSeats = ViewData["SelectedSeats"] as IReadOnlyList<int> ?? Array.Empty<int>();
    var gridCars = ViewData["CarsTwoGrid"] as IReadOnlyList<FinalProject.MVC.Models.Car> ?? Model;
    const int pageSize = 9;
}

<style>
    .side-box.tag-area ul li { cursor: pointer; }
    .side-box.tag-area ul li.is-active { background: var(--color-primary); color: #fff; }

    /* Desktop: sidebar scrolls inside the viewport; page height follows the car grid. */
    @@media (min-width: 992px) {
        .cars-two-sidebar-sticky {
            top: 120px;
        }
        .cars-two-filters-scroll {
            max-height: min(75vh, calc(100vh - 140px));
            overflow-y: auto;
            overscroll-behavior: contain;
            padding-right: 6px;
            scrollbar-gutter: stable;
        }
        .cars-two-filters-scroll::-webkit-scrollbar {
            width: 8px;
        }
        .cars-two-filters-scroll::-webkit-scrollbar-thumb {
            background: rgba(85, 85, 85, 0.35);
            border-radius: 8px;
        }
        .cars-two-filters-scroll::-webkit-scrollbar-track {
            background: rgba(85, 85, 85, 0.08);
            border-radius: 8px;
        }
    }

    #carLoadMore[hidden] {
        display: none !important;
    }

    .cars-two-seat-badge {
        display: flex;
        align-items: center;
        background: #252525;
        border-radius: 30px;
        padding: 8px 14px;
        line-height: 1;
        position: absolute;
        z-index: 1;
        left: 30px;
        bottom: 58px;
        color: var(--color-white);
        pointer-events: none;
        white-space: nowrap;
        font-size: 13px;
        font-weight: 600;
    }
</style>

<div class="rts-breadcrumb-area portfolio jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Cars</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Cars</a>
            </div>
        </div>
    </div>
</div>

<div class="rts-portfolio-area inner rts-section-gapNew">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-4">
                <div class="sticky-top cars-two-sidebar-sticky">
                    <div class="left-side-bar cars-two-filters-scroll">
                        <div class="search-area side-box">
                            <h2>Cars Search</h2>
                            <form action="#" id="carSearchForm">
                                <div class="input-wrapper">
                                    <input type="text" id="carSearch" placeholder="Search Vehicles">
                                    <button type="submit"><i class="fa-regular fa-magnifying-glass"></i></button>
                                </div>
                            </form>
                        </div>
                        <div class="car-make side-box">
                            <h2>Car Make</h2>
                            <ul class="checkbox-list">
                                @foreach (var make in makes)
                                {
                                    <li class="checkbox-item">
                                        <label class="checkbox-label">
                                            <input type="checkbox" class="make-filter" value="@make.Name" data-brand-id="@(brandIds.TryGetValue(make.Name, out var brandId) ? brandId : null)" />
                                            <span>@make.Name</span>
                                        </label>
                                        <span>(@make.Count)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="car-make side-box">
                            <h2>Car Model</h2>
                            <ul class="checkbox-list" id="carModelList">
                                <li class="cars-two-model-hint">Select a brand first</li>
                            </ul>
                        </div>
                        <div class="price-box side-box">
                            <h2>Price</h2>
                            <div class="slider-container">
                                <div class="histogram">
                                    <div class="histogram-bar" style="height: 67px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 52px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 99px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 99px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 98px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 107px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 102px;"></div>
                                    <div class="histogram-bar" style="height: 52px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 94px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                </div>
                                <div class="range-slider">
                                    <div class="track"></div>
                                    <div class="range" id="range"></div>
                                    <input type="range" id="minRange" min="0" max="100" value="0">
                                    <input type="range" id="maxRange" min="0" max="100" value="100">
                                </div>
                                <div class="price-labels">
                                    <span id="minPrice">$@minPrice.ToString("N0")</span>
                                    <span id="maxPrice">$@maxPrice.ToString("N0")</span>
                                </div>
                            </div>
                        </div>
                        <div class="car-make side-box">
                            <h2>Car Color</h2>
                            <ul class="checkbox-list" id="carColorList">
                                <li class="cars-two-model-hint">Select a brand first</li>
                            </ul>
                        </div>
                        <div class="tag-area side-box">
                            <h2>Fuel</h2>
                            <ul id="fuelFilters">
                                @foreach (var fuel in fuels)
                                {
                                    <li class="fuel-filter" data-fuel="@fuel">@fuel</li>
                                }
                            </ul>
                        </div>
                        <div class="car-make side-box">
                            <h2>Car Seats</h2>
                            <ul class="checkbox-list" id="carSeatList">
                                @foreach (var option in seatOptions)
                                {
                                    <li class="checkbox-item">
                                        <label class="checkbox-label">
                                            <input type="checkbox" class="seat-filter" value="@option.Seats" @(selectedSeats.Contains(option.Seats) ? "checked" : null) />
                                            <span>@option.Seats seats</span>
                                        </label>
                                        <span>(@option.Count)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="right">
                    <div class="row g-5" id="carGrid">
                        <partial name="_CarsTwoCards" model="gridCars" />
                    </div>
                    <h6 id="carEmpty" class="d-none text-center mt--40">No cars match this filter.</h6>
                    <button type="button" class="rts-btn load-more-btn btn-border" id="carLoadMore">Load More</button>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_DealershipCallCta" />

@section Scripts {
    <script>
        (function () {
            var pageSize = @pageSize;
            var shown = pageSize;
            var priceFloor = @minPrice;
            var priceCeil = @maxPrice;
            var minRange = document.getElementById("minRange");
            var maxRange = document.getElementById("maxRange");
            var range = document.getElementById("range");
            var bars = document.querySelectorAll(".histogram-bar");
            var minLabel = document.getElementById("minPrice");
            var maxLabel = document.getElementById("maxPrice");
            var search = document.getElementById("carSearch");
            var empty = document.getElementById("carEmpty");
            var loadMore = document.getElementById("carLoadMore");
            var grid = document.getElementById("carGrid");
            var cards = Array.prototype.slice.call(grid.querySelectorAll(".car-card"));
            var modelList = document.getElementById("carModelList");
            var colorList = document.getElementById("carColorList");
            var seatList = document.getElementById("carSeatList");
            var modelsUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("BrandModels", "Cars")));
            var resultsUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("CarsTwoResults", "Cars")));
            var facetCatalog = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Select(car => new
                {
                    make = car.Make,
                    model = car.Model,
                    color = car.Color,
                    fuel = car.Fuel,
                    price = car.Price,
                    search = $"{car.Name} {car.Make} {car.Model}",
                    seats = CarsTwoSeatCount.Resolve(car.Seats, car.Description)
                })));
            var modelRequest = 0;
            var seatRequest = 0;

            grid.addEventListener("click", function (event) {
                var link = event.target.closest("a");
                if (link && link.getAttribute("href") === "#") {
                    event.preventDefault();
                }
            });

            function selected(selector) {
                return Array.prototype.slice.call(document.querySelectorAll(selector + ":checked")).map(function (input) {
                    return input.value;
                });
            }

            function priceBounds() {
                var minValue = parseInt(minRange.value, 10);
                var maxValue = parseInt(maxRange.value, 10);
                return {
                    min: Math.round((minValue / 100) * (priceCeil - priceFloor) + priceFloor),
                    max: Math.round((maxValue / 100) * (priceCeil - priceFloor) + priceFloor)
                };
            }

            function updateRange() {
                var minValue = parseInt(minRange.value, 10);
                var maxValue = parseInt(maxRange.value, 10);
                range.style.left = minValue + "%";
                range.style.right = (100 - maxValue) + "%";
                bars.forEach(function (bar, index) {
                    var barValue = (index / (bars.length - 1)) * 100;
                    bar.classList.toggle("active", barValue >= minValue && barValue <= maxValue);
                });
                var bounds = priceBounds();
                minLabel.textContent = "$" + bounds.min.toLocaleString();
                maxLabel.textContent = "$" + bounds.max.toLocaleString();
            }

            function matchingCards() {
                var query = search.value.trim().toLowerCase();
                var makes = selected(".make-filter");
                var models = selected(".model-filter");
                var seatValues = selected(".seat-filter");
                var colorValues = selected(".color-filter");
                var fuelValues = Array.prototype.slice.call(document.querySelectorAll(".fuel-filter.is-active")).map(function (item) {
                    return item.getAttribute("data-fuel");
                });
                var bounds = priceBounds();
                return cards.filter(function (card) {
                    var price = parseFloat(card.getAttribute("data-price"));
                    if (query && card.getAttribute("data-search").toLowerCase().indexOf(query) === -1) return false;
                    if (makes.length && makes.indexOf(card.getAttribute("data-make")) === -1) return false;
                    if (models.length && models.indexOf(card.getAttribute("data-model")) === -1) return false;
                    if (seatValues.length && seatValues.indexOf(card.getAttribute("data-seats")) === -1) return false;
                    if (colorValues.length && colorValues.indexOf(card.getAttribute("data-color")) === -1) return false;
                    if (fuelValues.length && fuelValues.indexOf(card.getAttribute("data-fuel")) === -1) return false;
                    return price >= bounds.min && price <= bounds.max;
                }).sort(function (left, right) {
                    var leftCreated = parseInt(left.getAttribute("data-created") || "0", 10);
                    var rightCreated = parseInt(right.getAttribute("data-created") || "0", 10);
                    if (rightCreated !== leftCreated) return rightCreated - leftCreated;
                    return parseInt(right.getAttribute("data-id") || "0", 10) - parseInt(left.getAttribute("data-id") || "0", 10);
                });
            }

            // Toggle visibility in place (no hide-all pass) so Load More does not collapse page height / jump scroll.
            function apply() {
                var matches = matchingCards();
                var matchIndex = new Map();
                matches.forEach(function (card, index) {
                    matchIndex.set(card, index);
                });
                cards.forEach(function (card) {
                    var index = matchIndex.has(card) ? matchIndex.get(card) : -1;
                    var shouldShow = index >= 0 && index < shown;
                    card.classList.toggle("d-none", !shouldShow);
                });
                empty.classList.toggle("d-none", matches.length > 0);
                var hasMore = matches.length > shown;
                loadMore.hidden = !hasMore;
                loadMore.disabled = !hasMore;
            }

            function resetPagingAndApply() {
                shown = pageSize;
                apply();
            }

            minRange.addEventListener("input", function () {
                if (parseInt(minRange.value, 10) > parseInt(maxRange.value, 10) - 5) {
                    minRange.value = parseInt(maxRange.value, 10) - 5;
                }
                updateRange();
                refreshSeatFilters();
                resetPagingAndApply();
            });
            maxRange.addEventListener("input", function () {
                if (parseInt(maxRange.value, 10) < parseInt(minRange.value, 10) + 5) {
                    maxRange.value = parseInt(minRange.value, 10) + 5;
                }
                updateRange();
                refreshSeatFilters();
                resetPagingAndApply();
            });
            document.getElementById("carSearchForm").addEventListener("submit", function (event) {
                event.preventDefault();
                refreshSeatFilters();
                resetPagingAndApply();
            });
            search.addEventListener("input", function () {
                refreshSeatFilters();
                resetPagingAndApply();
            });
            function selectedMakes() {
                return Array.prototype.slice.call(document.querySelectorAll(".make-filter:checked"));
            }

            function cardsForFacetScope() {
                var makes = selectedMakes();
                if (!makes.length) return [];
                var models = selected(".model-filter");
                return cards.filter(function (card) {
                    if (!makes.some(function (input) {
                        return input.value === card.getAttribute("data-make");
                    })) return false;
                    if (models.length && models.indexOf(card.getAttribute("data-model")) === -1) return false;
                    return true;
                });
            }

            function catalogForSeatFacets() {
                var makes = selected(".make-filter");
                var models = selected(".model-filter");
                var colorValues = selected(".color-filter");
                var fuelValues = Array.prototype.slice.call(document.querySelectorAll(".fuel-filter.is-active")).map(function (item) {
                    return item.getAttribute("data-fuel");
                });
                var query = search.value.trim().toLowerCase();
                var bounds = priceBounds();
                return facetCatalog.filter(function (car) {
                    if (makes.length && makes.indexOf(car.make) === -1) return false;
                    if (models.length && models.indexOf(car.model) === -1) return false;
                    if (colorValues.length && colorValues.indexOf(car.color) === -1) return false;
                    if (fuelValues.length && fuelValues.indexOf(car.fuel) === -1) return false;
                    if (query && String(car.search || "").toLowerCase().indexOf(query) === -1) return false;
                    if (car.price < bounds.min || car.price > bounds.max) return false;
                    return car.seats != null;
                });
            }

            function renderListPlaceholder(list, text) {
                list.innerHTML = "";
                var hint = document.createElement("li");
                hint.className = "cars-two-model-hint";
                hint.textContent = text;
                list.appendChild(hint);
            }

            function renderModelPlaceholder(text) {
                renderListPlaceholder(modelList, text);
            }

            function appendCheckboxItem(list, className, value, labelText, count, checked) {
                var item = document.createElement("li");
                item.className = "checkbox-item";
                var label = document.createElement("label");
                label.className = "checkbox-label";
                var input = document.createElement("input");
                input.type = "checkbox";
                input.className = className;
                input.value = value;
                if (checked) input.checked = true;
                var title = document.createElement("span");
                title.textContent = labelText;
                label.appendChild(input);
                label.appendChild(title);
                var total = document.createElement("span");
                total.textContent = "(" + count + ")";
                item.appendChild(label);
                item.appendChild(total);
                list.appendChild(item);
            }

            function renderModels(names, makes) {
                modelList.innerHTML = "";
                if (!names.length) {
                    renderModelPlaceholder("No models for this brand");
                    return;
                }

                names.forEach(function (name) {
                    var count = cards.filter(function (card) {
                        if (card.getAttribute("data-model") !== name) return false;
                        return makes.some(function (input) {
                            return input.value === card.getAttribute("data-make");
                        });
                    }).length;
                    appendCheckboxItem(modelList, "model-filter", name, name, count, false);
                });
            }

            function sameValues(left, right) {
                if (left.length !== right.length) return false;
                var copy = left.slice().sort();
                var other = right.slice().sort();
                for (var index = 0; index < copy.length; index++) {
                    if (copy[index] !== other[index]) return false;
                }
                return true;
            }

            function refreshSeatFilters() {
                var previous = selected(".seat-filter");
                var scoped = catalogForSeatFacets();
                var seatCounts = {};
                scoped.forEach(function (car) {
                    var seats = String(car.seats);
                    seatCounts[seats] = (seatCounts[seats] || 0) + 1;
                });
                var seatNames = Object.keys(seatCounts).sort(function (left, right) {
                    return parseInt(left, 10) - parseInt(right, 10);
                });
                seatList.innerHTML = "";
                if (!seatNames.length) {
                    renderListPlaceholder(
                        seatList,
                        selectedMakes().length ? "No seats for this brand" : "No seat counts available");
                } else {
                    seatNames.forEach(function (name) {
                        appendCheckboxItem(
                            seatList,
                            "seat-filter",
                            name,
                            name + " seats",
                            seatCounts[name],
                            previous.indexOf(name) !== -1);
                    });
                }

                var next = selected(".seat-filter");
                if (!sameValues(previous, next)) {
                    syncSeatQuery();
                    reloadSeatResults();
                }
            }

            function refreshColorAndSeatFilters() {
                var makes = selectedMakes();
                var keepColors = selected(".color-filter");
                if (!makes.length) {
                    renderListPlaceholder(colorList, "Select a brand first");
                    refreshSeatFilters();
                    return;
                }

                var scoped = cardsForFacetScope();
                var colorCounts = {};
                scoped.forEach(function (card) {
                    var color = (card.getAttribute("data-color") || "").trim();
                    if (color) {
                        colorCounts[color] = (colorCounts[color] || 0) + 1;
                    }
                });

                var emptyHint = selected(".model-filter").length
                    ? "No options for this model"
                    : "No options for this brand";

                var colorNames = Object.keys(colorCounts).sort(function (left, right) {
                    return left.localeCompare(right);
                });
                colorList.innerHTML = "";
                if (!colorNames.length) {
                    renderListPlaceholder(colorList, emptyHint);
                } else {
                    colorNames.forEach(function (name) {
                        appendCheckboxItem(
                            colorList,
                            "color-filter",
                            name,
                            name,
                            colorCounts[name],
                            keepColors.indexOf(name) !== -1);
                    });
                }
                refreshSeatFilters();
            }

            function loadModels() {
                var makes = selectedMakes();
                var requestId = ++modelRequest;
                refreshColorAndSeatFilters();
                if (!makes.length) {
                    renderModelPlaceholder("Select a brand first");
                    resetPagingAndApply();
                    return;
                }

                var brandIds = makes.map(function (input) {
                    return input.getAttribute("data-brand-id");
                }).filter(function (id) {
                    return id && id !== "0";
                });
                if (!brandIds.length) {
                    renderModelPlaceholder("Select a brand first");
                    resetPagingAndApply();
                    return;
                }

                Promise.all(brandIds.map(function (brandId) {
                    return fetch(modelsUrl + "?brandId=" + encodeURIComponent(brandId), {
                        headers: { Accept: "application/json" },
                        credentials: "same-origin"
                    }).then(function (response) {
                        if (!response.ok) throw new Error("Model request failed.");
                        return response.json();
                    });
                })).then(function (groups) {
                    if (requestId !== modelRequest) return;
                    var seen = {};
                    var names = [];
                    groups.forEach(function (group) {
                        (group || []).forEach(function (name) {
                            var key = String(name).trim().toLowerCase();
                            if (!key || seen[key]) return;
                            seen[key] = true;
                            names.push(String(name).trim());
                        });
                    });
                    names.sort(function (left, right) {
                        return left.localeCompare(right);
                    });
                    renderModels(names, makes);
                    resetPagingAndApply();
                }).catch(function () {
                    if (requestId !== modelRequest) return;
                    renderModelPlaceholder("Models are temporarily unavailable.");
                    resetPagingAndApply();
                });
            }

            document.querySelectorAll(".make-filter").forEach(function (input) {
                input.addEventListener("change", loadModels);
            });
            modelList.addEventListener("change", function (event) {
                if (event.target && event.target.classList.contains("model-filter")) {
                    refreshColorAndSeatFilters();
                    resetPagingAndApply();
                }
            });
            colorList.addEventListener("change", function (event) {
                if (event.target && event.target.classList.contains("color-filter")) {
                    refreshSeatFilters();
                    resetPagingAndApply();
                }
            });
            function syncSeatQuery() {
                var params = new URLSearchParams(window.location.search);
                params.delete("seats");
                selected(".seat-filter").forEach(function (value) {
                    params.append("seats", value);
                });
                var query = params.toString();
                history.replaceState(null, "", window.location.pathname + (query ? "?" + query : "") + window.location.hash);
            }

            function bindResultGallery() {
                if (!(window.jQuery && jQuery.fn && jQuery.fn.magnificPopup)) {
                    return;
                }
                var $links = jQuery(grid).find("a.gallery-image");
                if (!$links.length) {
                    return;
                }
                $links.magnificPopup({
                    type: "image",
                    gallery: {
                        enabled: true
                    }
                });
            }

            function reloadSeatResults() {
                var requestId = ++seatRequest;
                var params = new URLSearchParams();
                selected(".seat-filter").forEach(function (value) {
                    params.append("seats", value);
                });
                syncSeatQuery();
                fetch(resultsUrl + (params.toString() ? "?" + params.toString() : ""), {
                    headers: { Accept: "text/html" },
                    credentials: "same-origin"
                }).then(function (response) {
                    if (!response.ok) {
                        throw new Error("Seat filter failed.");
                    }
                    return response.text();
                }).then(function (html) {
                    if (requestId !== seatRequest) {
                        return;
                    }
                    grid.innerHTML = html;
                    cards = Array.prototype.slice.call(grid.querySelectorAll(".car-card"));
                    bindResultGallery();
                    resetPagingAndApply();
                }).catch(function () {
                    if (requestId !== seatRequest) {
                        return;
                    }
                    resetPagingAndApply();
                });
            }

            seatList.addEventListener("change", function (event) {
                if (!(event.target && event.target.classList.contains("seat-filter"))) {
                    return;
                }
                reloadSeatResults();
            });
            document.querySelectorAll(".fuel-filter").forEach(function (item) {
                item.addEventListener("click", function () {
                    item.classList.toggle("is-active");
                    refreshSeatFilters();
                    resetPagingAndApply();
                });
            });
            loadMore.addEventListener("click", function () {
                shown += pageSize;
                apply();
            });
            updateRange();
            refreshColorAndSeatFilters();
            apply();
        })();
    </script>
}
