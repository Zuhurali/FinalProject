@{
    ViewData["Title"] = "Car Single Two - AutoVault";
    var slides = new[] { "30", "31", "32", "33", "34", "35", "30", "31", "32", "33", "34", "35" };
}

<div class="rts-breadcrumb-area portfolio-details2 jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <div class="left">
                <div class="nav-bread-crumb">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a href="#" class="current">Cars</a>
                </div>
                <h1 class="title">Mercedes-Benz E-Class</h1>
                <ul class="feature-area">
                    <li>
                        <img src="~/assets/images/portfolio/feature-icon/10.svg" alt="">
                        100 Miles
                    </li>
                    <li>
                        <img src="~/assets/images/portfolio/feature-icon/11.svg" alt="">
                        Petrol
                    </li>
                    <li>
                        <img src="~/assets/images/portfolio/feature-icon/12.svg" alt="">
                        Autometic
                    </li>
                    <li>
                        <img src="~/assets/images/portfolio/feature-icon/13.svg" alt="">
                        Person
                    </li>
                </ul>
            </div>
            <div class="price-area">
                <h5>$1200,00</h5>
                <ul class="price-meta">
                    <li><img src="~/assets/images/portfolio/calender.svg" alt=""> Feb 23, 2025</li>
                    <li><img src="~/assets/images/portfolio/view.svg" alt=""> View</li>
                    <li><img src="~/assets/images/portfolio/heart.svg" alt=""> Favourite</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="rts-portfolio-area inner">
    <div class="container">
        <div class="portfolio-slider-area2 details mb--40">
            <div class="swiper rts-heroSlider">
                <div class="swiper-wrapper">
                    @foreach (var slide in slides)
                    {
                        <div class="swiper-slide">
                            <div class="image"><img src="@Url.Content($"~/assets/images/portfolio/{slide}.webp")" alt=""></div>
                        </div>
                    }
                </div>
            </div>
            <div class="pagination-area mt--50">
                <div class="swiper SlideThumb">
                    <div class="swiper-wrapper">
                        @foreach (var slide in slides)
                        {
                            <div class="swiper-slide">
                                <div class="single-thumb">
                                    <div class="thumbnail">
                                        <img src="@Url.Content($"~/assets/images/portfolio/{slide}.webp")" alt="">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="thumb-controls">
                        <button class="thumb-prev"><i class="fa-solid fa-chevron-left"></i></button>
                        <button class="thumb-next"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-8">
                <div class="portfolio-details-area">
                    <h2 class="mb--30">Car Description</h2>
                    <p class="mb--30">A car is a motorized vehicle designed primarily for the transportation of passengers, typically seating between one
                        to eight people. It consists of a metal or composite body structure mounted on a set of wheels, usually four, and is
                        powered by an internal combustion engine, an electric motor, or a hybrid system that combines both. The car’s it is
                        main components include the engine, transmission, drivetrain, suspension, and braking system, all of which work
                        together to provide motion and control.</p>
                    <p>Cars come in a variety of body styles and sizes, such as sedans, SUVs, hatchbacks, coupes, convertibles, and for pickup trucks, each serving different needs and preferences.</p>
                    <h2 class="mb--30">Car Features</h2>
                    <ul class="feature-list mb--40">
                        <li><i class="fa-regular fa-circle-check"></i> Engine Type</li>
                        <li><i class="fa-regular fa-circle-check"></i> Horsepower</li>
                        <li><i class="fa-regular fa-circle-check"></i> Automatic Climate Control</li>
                        <li><i class="fa-regular fa-circle-check"></i> Touchscreen Display</li>
                        <li><i class="fa-regular fa-circle-check"></i> Navigation System</li>
                        <li><i class="fa-regular fa-circle-check"></i> Fog Lights</li>
                        <li><i class="fa-regular fa-circle-check"></i> Start-Stop Technology</li>
                        <li><i class="fa-regular fa-circle-check"></i> Automatic Headlights</li>
                        <li><i class="fa-regular fa-circle-check"></i> Navigation System</li>
                    </ul>
                    <h2 class="mb--30">Key Specs</h2>
                    <ul class="specs-list mb--40">
                        <li>
                            <span class="number">1</span>
                            <div class="text">
                                <h6>Car Transmission</h6>
                                <p>Fuel type</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">2</span>
                            <div class="text">
                                <h6>15 hrs</h6>
                                <p>Level Two Charging</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">3</span>
                            <div class="text">
                                <h6>100 kWh</h6>
                                <p>Battery Capacity</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">4</span>
                            <div class="text">
                                <h6>30 mins</h6>
                                <p>Dc Fast Changing</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">5</span>
                            <div class="text">
                                <h6>Battery</h6>
                                <p>96 month/150000 miles</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">6</span>
                            <div class="text">
                                <h6>Powertrain</h6>
                                <p>96 month/unlimited</p>
                            </div>
                        </li>
                    </ul>
                    <h2 class="mb--30">Car Engine </h2>
                    <ul class="feature-list2 mb--40">
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Displacement</p>
                                <p>3L</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Torque</p>
                                <p>350 lb.-ft</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Horespower</p>
                                <p>210 kW / 286 hp</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Number of cylinders</p>
                                <p>4</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Engine Layout</p>
                                <p>First-Engine</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Engine Configurations</p>
                                <p>V Engine (V6, V8)</p>
                            </div>
                        </li>
                    </ul>
                    <form action="#" class="message-form mb--100" id="carTwoMessageForm">
                        <h2>Send Message</h2>
                        <div class="form-inner">
                            <div class="input-wrapper">
                                <input type="text" name="Name" placeholder="Your Name" required>
                                <input type="email" name="Email" placeholder="Your Email*" required>
                                <input type="text" name="Phone" placeholder="Phone" required>
                            </div>
                            <textarea name="message" id="message" placeholder="Type a message*"></textarea>
                            <div class="form-bottom">
                                <label class="checkbox-label">
                                    <input type="checkbox" />
                                    <span>I accept The <a href="#">Privacy Policy</a></span>
                                </label>
                                <button class="rts-btn btn-primary radius-small" type="submit"><img src="~/assets/images/portfolio/send.svg" alt="">Submit Message</button>
                            </div>
                        </div>
                    </form>
                    <div class="related-project">
                        <h3 class="mb--40 text-center">Related listings</h3>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="project-wrapper2">
                                    <div class="image-area">
                                        <a asp-controller="Cars" asp-action="Details" asp-route-id="1"><img src="~/assets/images/portfolio/04.webp" alt=""></a>
                                        <span class="tag">Stocks</span>
                                        <a href="#" class="wishlist"><i class="fa-regular fa-heart"></i></a>
                                        <a href="~/assets/images/portfolio/04.webp" class="gallery-image">
                                            <img src="~/assets/images/icon/image.svg" alt="">
                                            7
                                        </a>
                                    </div>
                                    <span class="price">14,000$</span>
                                    <div class="content-area">
                                        <h6 class="title "><a asp-controller="Cars" asp-action="Details" asp-route-id="1">Thunderbolt Car</a></h6>
                                        <ul class="feature-area">
                                            <li>
                                                <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                                                100 Miles
                                            </li>
                                            <li>
                                                <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                                                Petrol
                                            </li>
                                            <li>
                                                <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                                                Autometic
                                            </li>
                                        </ul>
                                        <div class="button-area">
                                            <p class="">$400</p>
                                            <a asp-controller="Cars" asp-action="Details" asp-route-id="1" class="rts-btn btn-primary radius-small">View Details</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="project-wrapper2">
                                    <div class="image-area">
                                        <a asp-controller="Cars" asp-action="Details" asp-route-id="6"><img src="~/assets/images/portfolio/05.webp" alt=""></a>
                                        <span class="tag">New</span>
                                        <a href="#" class="wishlist"><i class="fa-regular fa-heart"></i></a>
                                        <a href="~/assets/images/portfolio/05.webp" class="gallery-image">
                                            <img src="~/assets/images/icon/image.svg" alt="">
                                            5
                                        </a>
                                    </div>
                                    <span class="price">14,000$</span>
                                    <div class="content-area">
                                        <h6 class="title "><a asp-controller="Cars" asp-action="Details" asp-route-id="6">Mercedes-Benz E-Class</a></h6>
                                        <ul class="feature-area">
                                            <li>
                                                <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                                                100 Miles
                                            </li>
                                            <li>
                                                <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                                                Petrol
                                            </li>
                                            <li>
                                                <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                                                Autometic
                                            </li>
                                        </ul>
                                        <div class="button-area">
                                            <p class="">$400</p>
                                            <a asp-controller="Cars" asp-action="Details" asp-route-id="6" class="rts-btn btn-primary radius-small">View Details</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="sticky-top">
                    <div class="left-side-bar">
                        <div class="overview side-box">
                            <h2>Car Overview</h2>
                            <ul class="feature-list2 mb--40">
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/09.svg" alt="">
                                    <div class="text">
                                        <p>Car Type</p>
                                        <p>Mercedes - Benz</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/10.svg" alt="">
                                    <div class="text">
                                        <p>Mileage</p>
                                        <p>100 Miles</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/11.svg" alt="">
                                    <div class="text">
                                        <p>Fuel Type</p>
                                        <p>Petrol</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/12.svg" alt="">
                                    <div class="text">
                                        <p>Transmission</p>
                                        <p>Autometic</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/13.svg" alt="">
                                    <div class="text">
                                        <p>Person</p>
                                        <p>5 Person</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/14.svg" alt="">
                                    <div class="text">
                                        <p>Drive Type</p>
                                        <p>Race Car Drivers</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/15.svg" alt="">
                                    <div class="text">
                                        <p>Engine</p>
                                        <p>Mazda RX-7</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/16.svg" alt="">
                                    <div class="text">
                                        <p>Color</p>
                                        <p>Red Color</p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="map-area side-box">
                            <h2>Location</h2>
                            <partial name="_ShowroomMap" model="250" />
                        </div>
                        <div class="contact side-box">
                            <h2>Contacts</h2>
                            <div class="contact-inner">
                                <div class="author-img">
                                    <img src="~/assets/images/portfolio/author.webp" alt="">
                                </div>
                                <h5>Jonathon Doe</h5>
                                <p>Car Dealer</p>
                                <div class="contact-button-area">
                                    <partial name="_DealershipContactButtons" />
                                    <a href="#carTwoMessageForm" class="rts-btn radius-small telegram"><img src="~/assets/images/portfolio/send.svg" alt=""> Send Message</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_DealershipCallCta" />

@section Scripts {
    <script>
        document.getElementById("carTwoMessageForm")?.addEventListener("submit", function (event) {
            event.preventDefault();
        });
    </script>
}
