@model CarListingResult
@{
    ViewData["Title"] = "Cars - AutoVault";
    var query = Model.Query;
}

<style>
    @@media (min-width: 768px) {
        .rts-select-area.inner.car-listing-filters .select-area-down .filter-field {
            width: 17%;
        }
    }
    .rts-select-area.inner.car-listing-filters .select-area-down .filter-field {
        border-radius: 6px;
        background: var(--color-gray);
    }
    .rts-select-area.inner.car-listing-filters .filter-field .nice-select {
        background: none;
        width: 100%;
        height: 48px;
        padding-top: 6px;
    }
    @@media (max-width: 767px) {
        .rts-select-area.inner.car-listing-filters .select-area-down .filter-field,
        .rts-select-area.inner.car-listing-filters .select-area-down .rts-btn {
            width: 48%;
        }
    }
</style>

<div class="rts-breadcrumb-area portfolio jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">@(Model.CategoryRequested ? Model.CategoryDisplay : "Cars")</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-action="Index" class="@(Model.CategoryRequested ? null : "current")">Cars</a>
                @if (Model.CategoryRequested)
                {
                    <a href="#" class="current">@Model.CategoryDisplay</a>
                }
            </div>
        </div>
    </div>
</div>

<div class="rts-select-area inner car-listing-filters">
    <div class="container">
        <div class="select-inner">
            <form method="get" asp-action="Index" class="select-area-down wow fadeInUp" data-wow-delay=".8s" data-wow-duration="1s">
                <div class="filter-field">
                    <select name="category" class="mySelect">
                        <option value="">Car Type</option>
                        @foreach (var category in CarCategories.All)
                        {
                            <option value="@category.Slug" selected="@(category.Slug == Model.CategorySlug)">@category.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <select name="make" class="my_select2">
                        <option value="">Car Make</option>
                        @foreach (var make in Model.Makes)
                        {
                            <option value="@make" selected="@(make == query.Make)">@make</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <select name="model" class="my_select2">
                        <option value="">Car Model</option>
                        @foreach (var carModel in Model.Models)
                        {
                            <option value="@carModel" selected="@(carModel == query.Model)">@carModel</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <select name="priceRange" class="my_select2">
                        <option value="">Price</option>
                        <option value="0-25000" selected="@(query.PriceRange == "0-25000")">$0 - $25,000</option>
                        <option value="10000-20000" selected="@(query.PriceRange == "10000-20000")">$10,000 - $20,000</option>
                        <option value="25000-35000" selected="@(query.PriceRange == "25000-35000")">$25,000 - $35,000</option>
                        <option value="35000-50000" selected="@(query.PriceRange == "35000-50000")">$35,000 - $50,000</option>
                        <option value="50000-70000" selected="@(query.PriceRange == "50000-70000")">$50,000 - $70,000</option>
                        <option value="70000+" selected="@(query.PriceRange == "70000+")">$70,000+</option>
                    </select>
                </div>
                <input type="hidden" name="fuel" value="@query.Fuel" />
                <input type="hidden" name="transmission" value="@query.Transmission" />
                <button type="submit" class="rts-btn radius-small icon btn-primary">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10.69 10.69L13 13M12.3333 6.68575C12.3333 9.826 9.796 12.3715 6.667 12.3715C3.53725 12.3715 1 9.826 1 6.6865C1 3.54475 3.53725 1 6.66625 1C9.796 1 12.3333 3.5455 12.3333 6.68575Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Search
                </button>
                @if (Model.HasActiveFilters)
                {
                    <a asp-action="Index" class="rts-btn radius-small btn-border">Clear Filters</a>
                }
            </form>
        </div>
    </div>
</div>

<div class="rts-portfolio-area inner rts-section-gapNew">
    <div class="container">
        <div class="row g-5">
            @if (Model.Cars.Count == 0)
            {
                <div class="col-12">
                    <h3 class="title text-center">@(Model.CategoryRequested ? "No cars found for this category." : "No cars found.")</h3>
                </div>
            }
            @foreach (var car in Model.Cars)
            {
                <div class="col-lg-4">
                    <div class="project-wrapper2">
                        <div class="image-area">
                            <a asp-action="Details" asp-route-id="@car.Id"><img src="@Url.Content(car.ImagePath)" alt="@car.Name"></a>
                            <span class="tag">@car.Badge</span>
                            <a href="#" class="wishlist"><i class="fa-regular fa-heart"></i></a>
                            <a href="@Url.Content(car.ImagePath)" class="gallery-image">
                                <img src="~/assets/images/icon/image.svg" alt="">
                                @car.ImageCount
                            </a>
                        </div>
                        <span class="price">$@car.Price.ToString("N0")</span>
                        <div class="content-area">
                            <h6 class="title"><a asp-action="Details" asp-route-id="@car.Id">@car.Name</a></h6>
                            <ul class="feature-area">
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                                    @car.Mileage.ToString("N0") Miles
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                                    @car.Fuel
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                                    @car.Transmission
                                </li>
                            </ul>
                            <div class="button-area">
                                <p class="">$@car.Price.ToString("N0")</p>
                                <a asp-action="Details" asp-route-id="@car.Id" class="rts-btn btn-primary radius-small">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="row">
                <div class="col-lg-12">
                    <div class="pagination-area">
                        <nav aria-label="Page navigation">
                            <ul class="pagination">
                                <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                                    <a class="page-link" asp-action="Index" asp-route-category="@Model.CategorySlug" asp-route-make="@query.Make" asp-route-model="@query.Model" asp-route-priceRange="@query.PriceRange" asp-route-fuel="@query.Fuel" asp-route-transmission="@query.Transmission" asp-route-page="@(Model.Page - 1)" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                @for (var i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.Page ? "active" : null)">
                                        <a class="page-link" asp-action="Index" asp-route-category="@Model.CategorySlug" asp-route-make="@query.Make" asp-route-model="@query.Model" asp-route-priceRange="@query.PriceRange" asp-route-fuel="@query.Fuel" asp-route-transmission="@query.Transmission" asp-route-page="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                                    <a class="page-link" asp-action="Index" asp-route-category="@Model.CategorySlug" asp-route-make="@query.Make" asp-route-model="@query.Model" asp-route-priceRange="@query.PriceRange" asp-route-fuel="@query.Fuel" asp-route-transmission="@query.Transmission" asp-route-page="@(Model.Page + 1)" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
