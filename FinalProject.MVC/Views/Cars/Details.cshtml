@model Car
@{
    ViewData["Title"] = $"{Model.Name} - AutoVault";
    var slides = (Model.GalleryImages ?? Array.Empty<string>())
        .Where(path => !string.IsNullOrWhiteSpace(path))
        .ToList();
    if (slides.Count == 0 && !string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        slides.Add(Model.ImagePath);
    }
    var relatedCars = ViewData["RelatedCars"] as IReadOnlyList<Car> ?? Array.Empty<Car>();
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isOwner = !string.IsNullOrWhiteSpace(Model.OwnerId) && Model.OwnerId == currentUserId;
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var favoriteUnavailable = ViewData["FavoriteServiceUnavailable"] as bool? == true;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var messageReturnUrl = returnUrl.Contains('?', StringComparison.Ordinal)
        ? $"{returnUrl}&openMessage=1"
        : $"{returnUrl}?openMessage=1";
    var isStoreListing = string.IsNullOrWhiteSpace(Model.OwnerId);
    var dealerLabel = isStoreListing ? "AutoVault Store" : (Model.OwnerDisplayName ?? "Seller");
    var defaultSubject = $"Inquiry about {Model.Name}";
    var defaultMessage = $"Hi, I'm interested in the {Model.Name}.\n\nI'd like to ask about pricing, availability, or a possible discount.";
    var openMessage = string.Equals(Context.Request.Query["openMessage"], "1", StringComparison.Ordinal);
    var mileageText = Model.MileageText;
    var isElectric = string.Equals(Model.Fuel, "Electric", StringComparison.OrdinalIgnoreCase);
    var engineLabel = isElectric ? "Motor" : "Engine";
    var listedOn = Model.CreatedAt.Year >= 2000 ? Model.CreatedAt.ToString("MMM dd, yyyy") : string.Empty;

    var overview = new List<(string Icon, string Label, string Value)>();
    if (!string.IsNullOrWhiteSpace(Model.Category)) overview.Add(("09", "Car Type", Model.Category));
    overview.Add(("10", "Mileage", mileageText));
    if (!string.IsNullOrWhiteSpace(Model.Fuel)) overview.Add(("11", "Fuel Type", Model.Fuel));
    if (!string.IsNullOrWhiteSpace(Model.Transmission)) overview.Add(("12", "Transmission", Model.Transmission));
    if (Model.Seats > 0) overview.Add(("13", "Seating Capacity", $"{Model.Seats} seats"));
    if (!string.IsNullOrWhiteSpace(Model.DriveType)) overview.Add(("14", "Drive Type", Model.DriveType));
    if (!string.IsNullOrWhiteSpace(Model.Engine)) overview.Add(("15", engineLabel, Model.Engine));
    if (!string.IsNullOrWhiteSpace(Model.Color)) overview.Add(("16", "Color", string.IsNullOrWhiteSpace(Model.ColorHex) ? Model.Color : $"{Model.Color} ({Model.ColorHex})"));
    if (Model.Horsepower > 0) overview.Add(("17", "Horsepower", $"{Model.Horsepower} HP"));
    if (Model.Doors > 0) overview.Add(("18", "Doors", Model.Doors.ToString()));
    if (Model.Cylinders > 0) overview.Add(("19", "Cylinders", Model.Cylinders.ToString()));
    if (!string.IsNullOrWhiteSpace(Model.Steering)) overview.Add(("04", "Steering", Model.Steering == "RHD" ? "Right-hand drive" : "Left-hand drive"));

    var keySpecs = new List<(string Value, string Label)>();
    if (!string.IsNullOrWhiteSpace(Model.Transmission)) keySpecs.Add((Model.Transmission, "Transmission"));
    if (Model.Year > 0) keySpecs.Add((Model.Year.ToString(), "Model Year"));
    if (!string.IsNullOrWhiteSpace(Model.Fuel)) keySpecs.Add((Model.Fuel, "Fuel Type"));
    keySpecs.Add((mileageText, "Mileage"));
    if (Model.Seats > 0) keySpecs.Add(($"{Model.Seats} seats", "Seating"));
    if (!string.IsNullOrWhiteSpace(Model.Color)) keySpecs.Add((string.IsNullOrWhiteSpace(Model.ColorHex) ? Model.Color : $"{Model.Color} ({Model.ColorHex})", "Exterior Color"));

    var engineRows = new List<(string Label, string Value)>();
    if (!string.IsNullOrWhiteSpace(Model.Make)) engineRows.Add(("Make", Model.Make));
    if (!string.IsNullOrWhiteSpace(Model.Model)) engineRows.Add(("Model", Model.Model));
    if (!string.IsNullOrWhiteSpace(Model.Category)) engineRows.Add(("Category", Model.Category));
    if (!string.IsNullOrWhiteSpace(Model.Engine)) engineRows.Add((engineLabel, Model.Engine));
    if (Model.Horsepower > 0) engineRows.Add(("Horsepower", $"{Model.Horsepower} HP"));
    if (Model.Cylinders > 0) engineRows.Add(("Cylinders", Model.Cylinders.ToString()));
    if (!string.IsNullOrWhiteSpace(Model.DriveType)) engineRows.Add(("Drive Type", Model.DriveType));
    if (Model.Doors > 0) engineRows.Add(("Doors", Model.Doors.ToString()));
    if (!string.IsNullOrWhiteSpace(Model.Vin)) engineRows.Add(("VIN", Model.Vin));
    if (!string.IsNullOrWhiteSpace(Model.MarketOrigin)) engineRows.Add(("Market", Model.MarketOrigin));
    if (!string.IsNullOrWhiteSpace(Model.AccidentHistory)) engineRows.Add(("Accident history", Model.AccidentHistory));
    if (!string.IsNullOrWhiteSpace(Model.CustomsStatus)) engineRows.Add(("Customs", Model.CustomsStatus));
    if (!string.IsNullOrWhiteSpace(Model.RepaintedParts)) engineRows.Add(("Repainted parts", Model.RepaintedParts));
    if (!string.IsNullOrWhiteSpace(Model.ReplacedParts)) engineRows.Add(("Replaced parts", Model.ReplacedParts));
}

<link rel="stylesheet" href="~/css/car-details.css" asp-append-version="true">

<div class="rts-breadcrumb-area portfolio details vehicle-details-hero" style="--vehicle-image: url('@Url.Content(Model.ImagePath)');">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <div class="left">
                <h1 class="title">@Model.Name</h1>
                <ul class="feature-area">
                    <li>
                        <img src="~/assets/images/portfolio/feature-icon/05.svg" alt="">
                        @mileageText
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Model.Fuel))
                    {
                        <li>
                            <img src="~/assets/images/portfolio/feature-icon/06.svg" alt="">
                            @Model.Fuel
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Transmission))
                    {
                        <li>
                            <img src="~/assets/images/portfolio/feature-icon/07.svg" alt="">
                            @Model.Transmission
                        </li>
                    }
                    @if (Model.Seats > 0)
                    {
                        <li>
                            <img src="~/assets/images/portfolio/feature-icon/08.svg" alt="">
                            @Model.Seats seats
                        </li>
                    }
                </ul>
            </div>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Cars" asp-action="Index" class="current">Cars</a>
            </div>
        </div>
    </div>
</div>

<div class="rts-portfolio-area inner rts-section-gapNew av-car-details">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="portfolio-details-area">
                    @if (slides.Count > 0)
                    {
                        <section class="portfolio-slider-area vertical details av-gallery" data-car-gallery aria-label="@Model.Name photos">
                            <button type="button" class="av-gallery__main" data-gallery-open aria-label="Open photo 1 of @slides.Count full size">
                                <img src="@Url.Content(slides[0])" alt="@Model.Name, photo 1 of @slides.Count" data-gallery-main>
                            </button>
                            @if (slides.Count > 1)
                            {
                                <div class="av-gallery__thumbs">
                                    @for (var index = 0; index < slides.Count; index++)
                                    {
                                        <button type="button"
                                                class="av-gallery__thumb@(index == 0 ? " is-active" : string.Empty)"
                                                data-gallery-thumb
                                                data-index="@index"
                                                data-src="@Url.Content(slides[index])"
                                                aria-label="Show photo @(index + 1) of @slides.Count"
                                                aria-pressed="@(index == 0 ? "true" : "false")">
                                            <img src="@Url.Content(slides[index])" alt="">
                                        </button>
                                    }
                                </div>
                            }
                        </section>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <h2 class="mb--30">Car Description</h2>
                        <p class="mb--30">@Model.Description</p>
                    }

                    @if (Model.Features.Count > 0)
                    {
                        <h2 class="mb--30">Car Features</h2>
                        <ul class="feature-list mb--40">
                            @foreach (var feature in Model.Features)
                            {
                                <li><i class="fa-regular fa-circle-check"></i> @feature</li>
                            }
                        </ul>
                    }

                    @if (keySpecs.Count > 0)
                    {
                        <h2 class="mb--30">Key Specs</h2>
                        <ul class="specs-list mb--40">
                            @for (var index = 0; index < keySpecs.Count; index++)
                            {
                                <li>
                                    <span class="number">@(index + 1)</span>
                                    <div class="text">
                                        <h6>@keySpecs[index].Value</h6>
                                        <p>@keySpecs[index].Label</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    }

                    @if (engineRows.Count > 0)
                    {
                        <h2 class="mb--30">Car Engine</h2>
                        <ul class="feature-list2 mb--40">
                            @foreach (var row in engineRows)
                            {
                                <li>
                                    <i class="fa-regular fa-circle-check"></i>
                                    <div class="text">
                                        <p>@row.Label</p>
                                        <p>@row.Value</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    }

                    <div class="message-form mb--60" id="carMessageForm">
                        <h2>Message Dealer</h2>
                        <p class="mb-3">Ask @dealerLabel about discounts, pricing, availability, or more details for this @(Model.Name).</p>
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger">@TempData["Error"]</div>
                        }
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">@TempData["Success"]</div>
                        }
                        @if (isOwner)
                        {
                            <div class="alert alert-info">This is your listing. Buyer messages appear under Account → Messages.</div>
                        }
                        else if (!isSignedIn)
                        {
                            <p>Sign in to send a message about this car. You will return here afterward.</p>
                            <a asp-controller="Account" asp-action="SignIn" asp-route-returnUrl="@messageReturnUrl" class="rts-btn btn-primary radius-small">Sign In to Message Dealer</a>
                        }
                        else
                        {
                            <form asp-action="ContactSeller" asp-route-id="@Model.Id" method="post" class="form-inner">
                                @Html.AntiForgeryToken()
                                <input type="text" name="subject" value="@defaultSubject" placeholder="Subject" maxlength="200" required>
                                <textarea name="message" placeholder="Ask about price, discounts, availability, or request more information*" required maxlength="4000">@defaultMessage</textarea>
                                <button class="rts-btn btn-primary radius-small" type="submit"><img src="~/assets/images/portfolio/send.svg" alt=""> Send Message</button>
                            </form>
                            <p class="mt-3 mb-0"><a asp-controller="Account" asp-action="Messages">View your conversations</a></p>
                        }
                    </div>

                    @if (relatedCars.Count > 0)
                    {
                        <div class="related-project">
                            <h3 class="mb--40 text-center">Related listings</h3>
                            <div class="row g-5">
                                @foreach (var relatedCar in relatedCars)
                                {
                                    <div class="col-md-6">
                                        <div class="project-wrapper2">
                                            <div class="image-area">
                                                <a asp-controller="Cars" asp-action="Details" asp-route-id="@relatedCar.Id"><img src="@Url.Content(relatedCar.ImagePath)" alt="@relatedCar.Name"></a>
                                                <span class="tag">@relatedCar.Badge</span>
                                            </div>
                                            <span class="price">$@relatedCar.Price.ToString("N0")</span>
                                            <div class="content-area">
                                                <h6 class="title "><a asp-controller="Cars" asp-action="Details" asp-route-id="@relatedCar.Id">@relatedCar.Name</a></h6>
                                                <ul class="feature-area">
                                                    <li>
                                                        <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                                                        @relatedCar.MileageText
                                                    </li>
                                                    <li>
                                                        <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                                                        @relatedCar.Fuel
                                                    </li>
                                                    <li>
                                                        <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                                                        @relatedCar.Transmission
                                                    </li>
                                                </ul>
                                                <div class="button-area">
                                                    <p class="">$@relatedCar.Price.ToString("N0")</p>
                                                    <a asp-controller="Cars" asp-action="Details" asp-route-id="@relatedCar.Id" class="rts-btn btn-primary radius-small">View Details</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="sticky-top av-sidebar">
                    <div class="left-side-bar">
                        <div class="price-area side-box">
                            <h5>$@Model.Price.ToString("N0")</h5>
                            <ul class="price-meta">
                                @if (!string.IsNullOrWhiteSpace(listedOn))
                                {
                                    <li><img src="~/assets/images/portfolio/calender.svg" alt=""> @listedOn</li>
                                }
                                <li>
                                    @if (isSignedIn)
                                    {
                                        <form method="post"
                                              class="av-favorite"
                                              asp-action="@(Model.IsFavorite ? "RemoveFavorite" : "AddFavorite")"
                                              asp-route-id="@Model.Id"
                                              data-favorite-form
                                              data-add-url="@Url.Action("AddFavorite", "Cars", new { id = Model.Id })"
                                              data-remove-url="@Url.Action("RemoveFavorite", "Cars", new { id = Model.Id })">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@returnUrl">
                                            <button type="submit"
                                                    class="av-favorite__button@(Model.IsFavorite ? " is-active" : string.Empty)"
                                                    aria-pressed="@(Model.IsFavorite ? "true" : "false")"
                                                    title="@(Model.IsFavorite ? "Remove this car from your favourites" : "Save this car to your favourites")"
                                                    data-favorite-button
                                                    @(favoriteUnavailable ? "disabled" : null)>
                                                <i class="@(Model.IsFavorite ? "fa-solid" : "fa-regular") fa-heart" aria-hidden="true" data-favorite-icon></i>
                                                <span data-favorite-label>@(Model.IsFavorite ? "Saved" : "Favourite")</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="SignIn" asp-route-returnUrl="@returnUrl"
                                           class="av-favorite__button"
                                           title="Sign in to save this car to your favourites">
                                            <i class="fa-regular fa-heart" aria-hidden="true"></i>
                                            <span>Favourite</span>
                                        </a>
                                    }
                                </li>
                            </ul>
                            <p class="av-favorite__status" role="status" aria-live="polite" data-favorite-status>@(favoriteUnavailable ? "Favourites are temporarily unavailable." : TempData["FavoriteError"])</p>
                            <div class="price-btn d-flex flex-column gap-2">
                                @if (isOwner)
                                {
                                    <a asp-controller="Account" asp-action="Messages" class="rts-btn btn-primary radius-small">View Messages</a>
                                }
                                else if (isSignedIn)
                                {
                                    <a href="#carMessageForm" class="rts-btn btn-primary radius-small">Message Dealer</a>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="SignIn" asp-route-returnUrl="@messageReturnUrl" class="rts-btn btn-primary radius-small">Message Dealer</a>
                                }
                                <partial name="_DealershipContactButtons" />
                            </div>
                        </div>
                        <div class="overview side-box">
                            <h2>Car Overview</h2>
                            <ul>
                                @foreach (var row in overview)
                                {
                                    <li>
                                        <img src="~/assets/images/portfolio/feature-icon/@(row.Icon).svg" alt="">
                                        <div class="text">
                                            <p>@row.Label</p>
                                            <p>@row.Value</p>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="map-area side-box">
                            <h2>Location</h2>
                            <partial name="_ShowroomMap" model="250" />
                        </div>
                        <div class="contact side-box">
                            <h2>Seller</h2>
                            <div class="contact-inner">
                                @if (isStoreListing)
                                {
                                    <h5>AutoVault Store</h5>
                                    <p>@DealershipContactOptions.Value.AddressLine</p>
                                }
                                else
                                {
                                    <h5>@Model.OwnerDisplayName</h5>
                                    <p>AutoVault Seller</p>
                                }
                                @if (!isOwner)
                                {
                                    <div class="contact-button-area">
                                        @if (isSignedIn)
                                        {
                                            <a href="#carMessageForm" class="rts-btn radius-small telegram"><img src="~/assets/images/portfolio/send.svg" alt=""> Message Dealer</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Account" asp-action="SignIn" asp-route-returnUrl="@messageReturnUrl" class="rts-btn radius-small telegram"><img src="~/assets/images/portfolio/send.svg" alt=""> Message Dealer</a>
                                        }
                                        <partial name="_DealershipContactButtons" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_DealershipCallCta" />

@if (slides.Count > 0)
{
    <div id="vehicle-lightbox" class="vehicle-lightbox" role="dialog" aria-modal="true" aria-label="@Model.Name photos" hidden>
        <div class="vehicle-lightbox__backdrop" data-lightbox-close></div>
        <button type="button" class="vehicle-lightbox__close" data-lightbox-close aria-label="Close photo viewer">&times;</button>
        @if (slides.Count > 1)
        {
            <button type="button" class="vehicle-lightbox__nav vehicle-lightbox__prev" data-lightbox-prev aria-label="Previous photo">&lsaquo;</button>
            <button type="button" class="vehicle-lightbox__nav vehicle-lightbox__next" data-lightbox-next aria-label="Next photo">&rsaquo;</button>
        }
        <figure class="vehicle-lightbox__stage">
            <img class="vehicle-lightbox__image" alt="@Model.Name">
            <figcaption class="vehicle-lightbox__caption"></figcaption>
        </figure>
    </div>
}

@section Scripts {
    <script src="~/js/car-details.js" asp-append-version="true"></script>
    @if (openMessage)
    {
        <script>
            document.getElementById('carMessageForm')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        </script>
    }
}
