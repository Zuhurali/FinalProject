@model Car
@{
    ViewData["Title"] = $"{Model.Name} - AutoVault";
    var slides = Enumerable.Repeat(Model.ImagePath, 6).ToArray();
    var relatedCars = ViewData["RelatedCars"] as IReadOnlyList<Car> ?? Array.Empty<Car>();
}

<div class="rts-breadcrumb-area portfolio details jarallax" style="background-image: url('@Url.Content(Model.ImagePath)'); background-size: cover; background-position: center;">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <div class="left">
                <h1 class="title">@Model.Name</h1>
                <ul class="feature-area">
                    <li>
                        <img src="~/assets/images/portfolio/feature-icon/05.svg" alt="">
                        @Model.Mileage.ToString("N0") Miles
                    </li>
                    <li>
                        <img src="~/assets/images/portfolio/feature-icon/06.svg" alt="">
                        @Model.Fuel
                    </li>
                    <li>
                        <img src="~/assets/images/portfolio/feature-icon/07.svg" alt="">
                        @Model.Transmission
                    </li>
                    <li>
                        <img src="~/assets/images/portfolio/feature-icon/08.svg" alt="">
                        @(Model.Seats > 0 ? $"{Model.Seats} Person" : "—")
                    </li>
                </ul>
            </div>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Cars</a>
            </div>
        </div>
    </div>
</div>

<div class="rts-portfolio-area inner rts-section-gapNew">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="portfolio-details-area">
                    <div class="portfolio-slider-area vertical details mb--40">
                        <div class="swiper rts-heroSlider2">
                            <div class="swiper-wrapper">
                                @foreach (var slide in slides)
                                {
                                    <div class="swiper-slide">
                                        <div class="image"><img src="@Url.Content(slide)" alt="@Model.Name"></div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="pagination-area mt_md--30 mt_sm--30">
                            <div class="swiper SlideThumb2">
                                <div class="swiper-wrapper">
                                    @foreach (var slide in slides)
                                    {
                                        <div class="swiper-slide">
                                            <div class="single-thumb">
                                                <div class="thumbnail">
                                                    <img src="@Url.Content(slide)" alt="@Model.Name">
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="thumb-controls">
                                <button class="thumb-prev"><i class="fa-solid fa-chevron-up"></i></button>
                                <button class="thumb-next"><i class="fa-solid fa-chevron-down"></i></button>
                            </div>
                        </div>
                    </div>
                    <h2 class="mb--30">Car Description</h2>
                    <p class="mb--30">A car is a motorized vehicle designed primarily for the transportation of passengers, typically seating between one
                        to eight people. It consists of a metal or composite body structure mounted on a set of wheels, usually four, and is
                        powered by an internal combustion engine, an electric motor, or a hybrid system that combines both. The car’s it is
                        main components include the engine, transmission, drivetrain, suspension, and braking system, all of which work
                        together to provide motion and control.</p>
                    <p>Cars come in a variety of body styles and sizes, such as sedans, SUVs, hatchbacks, coupes, convertibles, and for pickup trucks, each serving different needs and preferences.</p>
                    <h2 class="mb--30">Car Features</h2>
                    <ul class="feature-list mb--40">
                        <li><i class="fa-regular fa-circle-check"></i> Engine Type</li>
                        <li><i class="fa-regular fa-circle-check"></i> Horsepower</li>
                        <li><i class="fa-regular fa-circle-check"></i> Automatic Climate Control</li>
                        <li><i class="fa-regular fa-circle-check"></i> Touchscreen Display</li>
                        <li><i class="fa-regular fa-circle-check"></i> Navigation System</li>
                        <li><i class="fa-regular fa-circle-check"></i> Fog Lights</li>
                        <li><i class="fa-regular fa-circle-check"></i> Start-Stop Technology</li>
                        <li><i class="fa-regular fa-circle-check"></i> Automatic Headlights</li>
                        <li><i class="fa-regular fa-circle-check"></i> Navigation System</li>
                    </ul>
                    <h2 class="mb--30">Key Specs</h2>
                    <ul class="specs-list mb--40">
                        <li>
                            <span class="number">1</span>
                            <div class="text">
                                <h6>@Model.Transmission</h6>
                                <p>Transmission</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">2</span>
                            <div class="text">
                                <h6>@Model.Year</h6>
                                <p>Model Year</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">3</span>
                            <div class="text">
                                <h6>@Model.Fuel</h6>
                                <p>Fuel Type</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">4</span>
                            <div class="text">
                                <h6>@Model.Mileage.ToString("N0") Miles</h6>
                                <p>Mileage</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">5</span>
                            <div class="text">
                                <h6>@(Model.Seats > 0 ? $"{Model.Seats} Person" : "—")</h6>
                                <p>Seating</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">6</span>
                            <div class="text">
                                <h6>@Model.Color</h6>
                                <p>Exterior Color</p>
                            </div>
                        </li>
                    </ul>
                    <h2 class="mb--30">Video</h2>
                    <div class="rts-video-area video-2 bg-video-five bg_image jarallax mb--40">
                        <video muted loop id="myVideo">
                            <source src="~/assets/images/portfolio/video-01.webm">
                        </video>
                        <div class="content">
                            <div id="myBtn">
                                <img src="~/assets/images/video/round-text.svg" alt="">
                                <img src="~/assets/images/video/play.svg" alt="">
                            </div>
                        </div>
                    </div>
                    <h2 class="mb--30">Car Engine </h2>
                    <ul class="feature-list2 mb--30">
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Make</p>
                                <p>@Model.Make</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Model</p>
                                <p>@Model.Model</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Category</p>
                                <p>@Model.Category</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Drive Type</p>
                                <p>@(string.IsNullOrWhiteSpace(Model.DriveType) ? "—" : Model.DriveType)</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Year</p>
                                <p>@Model.Year</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Fuel</p>
                                <p>@Model.Fuel</p>
                            </div>
                        </li>
                    </ul>
                    <form action="#" class="message-form mb--100" id="carMessageForm">
                        <h2>Send Message</h2>
                        <div class="form-inner">
                            <div class="input-wrapper">
                                <input type="text" name="Name" placeholder="Your Name" required>
                                <input type="email" name="Email" placeholder="Your Email*" required>
                                <input type="text" name="Phone" placeholder="Phone" required>
                            </div>
                            <textarea name="message" id="message" placeholder="Type a message*"></textarea>
                            <div class="form-bottom">
                                <label class="checkbox-label">
                                    <input type="checkbox" />
                                    <span>I accept The <a href="#">Privacy Policy</a></span>
                                </label>
                                <button class="rts-btn btn-primary radius-small" type="submit"><img src="~/assets/images/portfolio/send.svg" alt="">Submit Message</button>
                            </div>
                        </div>
                    </form>
                    <div class="related-project">
                        <h3 class="mb--40 text-center">Related listings</h3>
                        <div class="row g-5">
                            @foreach (var relatedCar in relatedCars)
                            {
                                <div class="col-lg-6">
                                    <div class="project-wrapper2">
                                        <div class="image-area">
                                            <a asp-controller="Cars" asp-action="Details" asp-route-id="@relatedCar.Id"><img src="@Url.Content(relatedCar.ImagePath)" alt="@relatedCar.Name"></a>
                                            <span class="tag">@relatedCar.Badge</span>
                                            <a href="#" class="wishlist"><i class="fa-regular fa-heart"></i></a>
                                            <a href="@Url.Content(relatedCar.ImagePath)" class="gallery-image">
                                                <img src="~/assets/images/icon/image.svg" alt="">
                                                @relatedCar.ImageCount
                                            </a>
                                        </div>
                                        <span class="price">$@relatedCar.Price.ToString("N0")</span>
                                        <div class="content-area">
                                            <h6 class="title "><a asp-controller="Cars" asp-action="Details" asp-route-id="@relatedCar.Id">@relatedCar.Name</a></h6>
                                            <ul class="feature-area">
                                                <li>
                                                    <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                                                    @relatedCar.Mileage.ToString("N0") Miles
                                                </li>
                                                <li>
                                                    <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                                                    @relatedCar.Fuel
                                                </li>
                                                <li>
                                                    <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                                                    @relatedCar.Transmission
                                                </li>
                                            </ul>
                                            <div class="button-area">
                                                <p class="">$@relatedCar.Price.ToString("N0")</p>
                                                <a asp-controller="Cars" asp-action="Details" asp-route-id="@relatedCar.Id" class="rts-btn btn-primary radius-small">View Details</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="sticky-top">
                    <div class="left-side-bar">
                        <div class="price-area side-box">
                            <h5>$@Model.Price.ToString("N0")</h5>
                            <ul class="price-meta">
                                <li><img src="~/assets/images/portfolio/calender.svg" alt=""> Feb 23, 2025</li>
                                <li><img src="~/assets/images/portfolio/view.svg" alt=""> View</li>
                                <li><img src="~/assets/images/portfolio/heart.svg" alt=""> Favourite</li>
                            </ul>
                            <div class="price-btn">
                                <a href="#" class="rts-btn btn-primary radius-small">Call For Final Price</a>
                            </div>
                        </div>
                        <div class="overview side-box">
                            <h2>Car Overview</h2>
                            <ul class="feature-list2">
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/09.svg" alt="">
                                    <div class="text">
                                        <p>Car Type</p>
                                        <p>@Model.Category</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/10.svg" alt="">
                                    <div class="text">
                                        <p>Mileage</p>
                                        <p>@Model.Mileage.ToString("N0") Miles</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/11.svg" alt="">
                                    <div class="text">
                                        <p>Fuel Type</p>
                                        <p>@Model.Fuel</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/12.svg" alt="">
                                    <div class="text">
                                        <p>Transmission</p>
                                        <p>@Model.Transmission</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/13.svg" alt="">
                                    <div class="text">
                                        <p>Person</p>
                                        <p>@(Model.Seats > 0 ? $"{Model.Seats} Person" : "—")</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/14.svg" alt="">
                                    <div class="text">
                                        <p>Drive Type</p>
                                        <p>@(string.IsNullOrWhiteSpace(Model.DriveType) ? "—" : Model.DriveType)</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/15.svg" alt="">
                                    <div class="text">
                                        <p>Engine</p>
                                        <p>@Model.Model</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/16.svg" alt="">
                                    <div class="text">
                                        <p>Color</p>
                                        <p>@Model.Color</p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="map-area side-box">
                            <h2>Location</h2>
                            <div class="contact-map-area-fluid">
                                <iframe class="contact-map" height="250" src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d14602.288851207937!2d90.47855065!3d23.798243149999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sbd!4v1663151706353!5m2!1sen!2sbd" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                            </div>
                        </div>
                        <div class="contact side-box">
                            <h2>Contacts</h2>
                            <div class="contact-inner">
                                <div class="author-img">
                                    <img src="~/assets/images/portfolio/author.webp" alt="">
                                </div>
                                <h5>Jonathon Doe</h5>
                                <p>Car Dealer</p>
                                <div class="contact-button-area">
                                    <a href="#" class="rts-btn radius-small whatsapp"><img src="~/assets/images/portfolio/whatsapp.svg" alt=""> +14844578513</a>
                                    <a href="#" class="rts-btn radius-small btn-primary phone"><img src="~/assets/images/portfolio/phone.svg" alt=""> +18143511443</a>
                                    <a href="#carMessageForm" class="rts-btn radius-small telegram"><img src="~/assets/images/portfolio/send.svg" alt=""> Send Message</a>
                                </div>
                            </div>
                        </div>
                        <div class="social-area side-box">
                            <h2>Share</h2>
                            <ul>
                                <li><i class="fa-brands fa-facebook-f"></i></li>
                                <li><i class="fa-brands fa-twitter"></i></li>
                                <li><i class="fa-brands fa-instagram"></i></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="rts-cta-area area-2">
    <div class="container">
        <div class="cta-inner">
            <h2 class="title">If you have any questions Please Call.</h2>
            <div class="contact">
                <a href="call-to:+16544521505">
                    <img src="~/assets/images/cta/call.svg" alt="">
                    +1-654-452-1505
                </a>
            </div>
            <img class="shape one" src="~/assets/images/cta/round.svg" alt="">
            <img class="shape two" src="~/assets/images/cta/line.svg" alt="">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("carMessageForm")?.addEventListener("submit", function (event) {
            event.preventDefault();
        });
    </script>
}
