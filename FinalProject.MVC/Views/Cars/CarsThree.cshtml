@section Scripts {
    <script>
        const minRange = document.getElementById('minRange');
        const maxRange = document.getElementById('maxRange');
        const range = document.getElementById('range');
        const histogramBars = document.querySelectorAll('.histogram-bar');
        const minPrice = document.getElementById('minPrice');
        const maxPrice = document.getElementById('maxPrice');

        function updateRange() {
            const minValue = parseInt(minRange.value);
            const maxValue = parseInt(maxRange.value);

            range.style.left = `${minValue}%`;
            range.style.right = `${100 - maxValue}%`;

            histogramBars.forEach((bar, index) => {
                const barValue = (index / (histogramBars.length - 1)) * 100;
                if (barValue >= minValue && barValue <= maxValue) {
                    bar.classList.add('active');
                } else {
                    bar.classList.remove('active');
                }
            });

            const minPriceValue = Math.round((minValue / 100) * (5000 - 500) + 500);
            const maxPriceValue = Math.round((maxValue / 100) * (5000 - 500) + 500);
            minPrice.textContent = `$${minPriceValue}`;
            maxPrice.textContent = `$${maxPriceValue}`;
        }

        minRange.addEventListener('input', () => {
            if (parseInt(minRange.value) > parseInt(maxRange.value) - 10) {
                minRange.value = maxRange.value - 10;
            }
            updateRange();
        });

        maxRange.addEventListener('input', () => {
            if (parseInt(maxRange.value) < parseInt(minRange.value) + 10) {
                maxRange.value = parseInt(minRange.value) + 10;
            }
            updateRange();
        });

        updateRange();
    </script>
}
