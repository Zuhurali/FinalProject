@model CarsThreePageModel
@{
    ViewData["Title"] = "Cars Three - AutoVault";
    var makes = Model.Makes;
    var models = Model.Models;
    var types = Model.Types;
    var fuels = Model.Fuels;
    var transmissions = Model.Transmissions;
    var seats = Model.SeatsOptions;
    var minPrice = Model.MinPriceBound;
    var maxPrice = Model.MaxPriceBound;
    var minYear = Model.MinYearBound;
    var maxYear = Model.MaxYearBound;
    var pageSize = Model.PageSize > 0 ? Model.PageSize : CarsThreeFilterQuery.PageSize;
    var resultsUrl = Url.Action("CarsThreeResults", "Cars") ?? "/Cars/CarsThreeResults";
}

<style>
    .cars3-advanced {
        --c3-bg: #f3f4f7;
        --c3-panel: #ffffff;
        --c3-line: rgba(85, 85, 85, 0.14);
        --c3-ink: var(--color-heading-1, #050B20);
        --c3-muted: var(--color-body, #555555);
        --c3-accent: var(--color-primary, #FF3600);
        background: linear-gradient(180deg, #eef0f4 0%, var(--c3-bg) 28%, #f7f8fa 100%);
        padding-bottom: 72px;
    }

    .cars3-advanced .cars3-shell {
        display: grid;
        grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
        gap: 28px;
        align-items: start;
    }

    .cars3-panel {
        background: var(--c3-panel);
        border: 1px solid var(--c3-line);
        border-radius: 18px;
        box-shadow: 0 18px 40px rgba(5, 11, 32, 0.06);
    }

    .cars3-filters {
        padding: 22px 20px 20px;
        position: sticky;
        top: 110px;
        max-height: calc(100vh - 130px);
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: rgba(85, 85, 85, 0.35) transparent;
    }

    .cars3-filters::-webkit-scrollbar {
        width: 6px;
    }

    .cars3-filters::-webkit-scrollbar-track {
        background: transparent;
    }

    .cars3-filters::-webkit-scrollbar-thumb {
        background: rgba(85, 85, 85, 0.28);
        border-radius: 999px;
    }

    .cars3-filters__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--c3-line);
    }

    .cars3-filters__head h2 {
        margin: 0;
        font-size: 20px;
        line-height: 1.2;
        color: var(--c3-ink);
        font-weight: 600;
        white-space: nowrap;
        flex: 1 1 auto;
        min-width: 0;
    }

    .cars3-clear {
        border: 0;
        background: transparent;
        color: var(--c3-accent);
        font-size: 13px;
        font-weight: 600;
        padding: 0;
        cursor: pointer;
        flex: 0 0 auto;
        width: auto;
        white-space: nowrap;
    }

    .cars3-field {
        margin-bottom: 14px;
        clear: both;
    }

    .cars3-field label {
        display: block;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--c3-muted);
    }

    .cars3-field input[type="text"],
    .cars3-field input[type="number"],
    .cars3-field select {
        width: 100%;
        border: 1px solid var(--c3-line);
        border-radius: 10px;
        background: #fafbfc;
        color: var(--c3-ink);
        font-size: 14px;
        line-height: 1.2;
        padding: 11px 12px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    /* Override global .nice-select { float: left } only inside CarsThree filters. */
    .cars3-filters .nice-select {
        float: none;
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
        line-height: 1.2;
        border: 1px solid var(--c3-line);
        border-radius: 10px;
        background: #fafbfc;
        color: var(--c3-ink);
        font-size: 14px;
        padding: 11px 36px 11px 12px;
        margin: 0;
    }

    .cars3-filters .nice-select:after {
        right: 14px;
    }

    .cars3-filters .nice-select .list {
        width: 100%;
        border-radius: 10px;
    }

    /* Closed dropdown lists are opacity:0 but still expand overflow:auto scrollHeight. */
    .cars3-filters .nice-select:not(.open) .list {
        height: 0 !important;
        max-height: 0 !important;
        margin: 0;
        padding: 0;
        overflow: hidden;
        border: 0;
        box-shadow: none;
        transform: none;
    }

    .cars3-filters .nice-select.open .list {
        height: 200px;
        max-height: 200px;
        overflow-y: auto;
    }

    .cars3-field input:focus,
    .cars3-field select:focus,
    .cars3-filters .nice-select:focus,
    .cars3-filters .nice-select.open {
        border-color: rgba(255, 54, 0, 0.45);
        box-shadow: 0 0 0 3px rgba(255, 54, 0, 0.12);
        background: #fff;
    }

    .cars3-range {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .cars3-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 16px 18px;
        margin-bottom: 18px;
    }

    .cars3-toolbar__count {
        margin: 0;
        font-size: 15px;
        color: var(--c3-ink);
        font-weight: 600;
    }

    .cars3-toolbar__count span {
        color: var(--c3-accent);
    }

    .cars3-toolbar__sort {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
        z-index: 5;
    }

    .cars3-toolbar__sort label {
        margin: 0;
        font-size: 13px;
        color: var(--c3-muted);
        font-weight: 500;
        white-space: nowrap;
    }

    .cars3-toolbar__sort select {
        min-width: 220px;
        border: 1px solid var(--c3-line);
        border-radius: 10px;
        background: #fff;
        padding: 10px 12px;
        font-size: 14px;
        color: var(--c3-ink);
    }

    /* Global .nice-select { float:left } clips Sort options — scope override for CarsThree toolbar. */
    .cars3-toolbar__sort .nice-select {
        float: none !important;
        display: block;
        clear: none;
        min-width: 240px;
        width: 240px;
        max-width: min(100vw - 48px, 280px);
        height: auto;
        line-height: 1.25;
        border: 1px solid var(--c3-line);
        border-radius: 10px;
        background: #fff;
        color: var(--c3-ink);
        font-size: 14px;
        padding: 10px 36px 10px 14px;
        margin: 0;
        overflow: visible;
        white-space: nowrap;
        z-index: 6;
    }

    .cars3-toolbar__sort .nice-select .current {
        display: block;
        overflow: visible;
        text-overflow: clip;
        white-space: nowrap;
    }

    .cars3-toolbar__sort .nice-select:after {
        right: 14px;
    }

    .cars3-toolbar__sort .nice-select .list,
    .cars3-toolbar__sort .nice-select.open .list {
        width: 260px !important;
        min-width: 260px !important;
        left: 0 !important;
        right: auto !important;
        margin-top: 6px;
        border-radius: 10px;
        overflow-x: hidden;
        overflow-y: auto;
        height: auto !important;
        max-height: 280px;
        z-index: 30;
        box-shadow: 0 14px 32px rgba(5, 11, 32, 0.14);
    }

    .cars3-toolbar__sort .nice-select .option {
        line-height: 1.3;
        min-height: 40px;
        padding: 10px 16px;
        white-space: nowrap;
    }

    .cars3-toolbar__sort .nice-select.open {
        z-index: 40;
    }

    .cars3-results {
        min-width: 0;
        position: relative;
        z-index: 1;
    }

    .cars3-results .cars3-toolbar {
        position: relative;
        z-index: 8;
    }

    .cars3-card {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr) 180px;
        gap: 0;
        overflow: hidden;
        margin-bottom: 16px;
        transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
    }

    .cars3-card:hover {
        transform: translateY(-2px);
        border-color: transparent;
        box-shadow: 0 22px 44px rgba(5, 11, 32, 0.1);
    }

    .cars3-card__media {
        position: relative;
        background: #eceef2;
        min-height: 168px;
    }

    .cars3-card__media a {
        display: block;
        height: 100%;
    }

    .cars3-card__media img {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 168px;
        object-fit: cover;
    }

    .cars3-card__badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: var(--c3-accent);
        color: #fff;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1;
        padding: 7px 10px;
    }

    .cars3-card__body {
        padding: 18px 20px 16px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
        border-left: 1px solid var(--c3-line);
        border-right: 1px solid var(--c3-line);
    }

    .cars3-card__title {
        margin: 0;
        font-size: 20px;
        line-height: 1.25;
        color: var(--c3-ink);
        font-weight: 600;
    }

    .cars3-card__title a {
        color: inherit;
        text-decoration: none;
    }

    .cars3-card__title a:hover {
        color: var(--c3-accent);
    }

    .cars3-card__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .cars3-card__meta li {
        font-size: 13px;
        color: var(--c3-muted);
        line-height: 1.3;
    }

    .cars3-card__meta li strong {
        color: var(--c3-ink);
        font-weight: 600;
    }

    .cars3-card__aside {
        padding: 18px 18px 16px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        text-align: right;
        background: linear-gradient(180deg, #fff 0%, #fafbfc 100%);
    }

    .cars3-card__price {
        margin: 0;
        font-size: 26px;
        line-height: 1;
        font-weight: 700;
        color: var(--c3-accent);
        font-family: var(--font-primary, inherit);
    }

    .cars3-card__actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .cars3-card__actions .rts-btn {
        width: 100%;
        justify-content: center;
        text-align: center;
        font-size: 13px;
        padding: 11px 14px;
    }

    .cars3-fav {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        border: 1px solid var(--c3-line);
        border-radius: 8px;
        background: #fff;
        color: var(--c3-ink);
        font-size: 13px;
        font-weight: 600;
        padding: 10px 12px;
        text-decoration: none;
        cursor: pointer;
    }

    .cars3-fav:hover,
    .cars3-fav button {
        color: var(--c3-accent);
    }

    .cars3-fav form {
        margin: 0;
        width: 100%;
    }

    .cars3-fav button {
        width: 100%;
        border: 0;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font: inherit;
        font-weight: 600;
        color: inherit;
        cursor: pointer;
        padding: 0;
    }

    .cars3-empty {
        margin: 28px 0 10px;
        text-align: center;
        color: var(--c3-muted);
        font-size: 16px;
    }

    .cars3-load {
        margin: 28px auto 0;
        display: block;
    }

    #carLoadMore[hidden],
    #carEmpty[hidden] {
        display: none !important;
    }

    #favorite-card-status {
        position: fixed;
        left: 50%;
        bottom: 24px;
        transform: translateX(-50%);
        z-index: 40;
        margin: 0;
        padding: 10px 16px;
        border-radius: 999px;
        background: #050B20;
        color: #fff;
        font-size: 13px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    }

    #favorite-card-status.is-error {
        background: #8a1f1f;
    }

    @@media (max-width: 991.98px) {
        .cars3-advanced .cars3-shell {
            grid-template-columns: 1fr;
        }

        .cars3-filters {
            position: static;
            max-height: none;
            overflow: visible;
            overscroll-behavior: auto;
        }

        .cars3-card {
            grid-template-columns: 1fr;
        }

        .cars3-card__media img {
            min-height: 200px;
        }

        .cars3-card__body,
        .cars3-card__aside {
            border: 0;
            text-align: left;
        }

        .cars3-card__actions {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .cars3-card__actions .rts-btn,
        .cars3-fav,
        .cars3-fav form {
            width: auto;
            flex: 1 1 140px;
        }
    }
</style>

<div class="rts-breadcrumb-area portfolio-3 jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Advanced Search</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Cars Three</a>
            </div>
        </div>
    </div>
</div>

<p id="favorite-card-status" role="status" aria-live="polite" hidden></p>

<div class="rts-section-gapNew cars3-advanced cars-three-page">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Model.ApiError))
        {
            <h3 class="title text-center">@Model.ApiError</h3>
        }

        <div class="cars3-shell">
            <aside class="cars3-panel cars3-filters" aria-label="Advanced vehicle filters">
                <div class="cars3-filters__head">
                    <h2>Filters</h2>
                    <button type="button" class="cars3-clear" id="carClearFilters">Clear All</button>
                </div>

                <div class="cars3-field">
                    <label for="carSearch">Search</label>
                    <input type="text" id="carSearch" placeholder="Make, model, keyword" autocomplete="off" />
                </div>

                <div class="cars3-field">
                    <label for="filterBrand">Brand</label>
                    <select id="filterBrand">
                        <option value="">All brands</option>
                        @foreach (var make in makes)
                        {
                            <option value="@make">@make</option>
                        }
                    </select>
                </div>

                <div class="cars3-field">
                    <label for="filterModel">Model</label>
                    <select id="filterModel">
                        <option value="">All models</option>
                        @foreach (var carModel in models)
                        {
                            <option value="@carModel">@carModel</option>
                        }
                    </select>
                </div>

                <div class="cars3-field">
                    <label for="filterType">Vehicle Type</label>
                    <select id="filterType">
                        <option value="">All types</option>
                        @foreach (var type in types)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <div class="cars3-field">
                    <label>Price</label>
                    <div class="cars3-range">
                        <input type="number" id="filterMinPrice" min="@minPrice" max="@maxPrice" step="100" placeholder="Min" value="" />
                        <input type="number" id="filterMaxPrice" inputmode="decimal" placeholder="Max" value="" />
                    </div>
                </div>

                <div class="cars3-field">
                    <label>Year</label>
                    <div class="cars3-range">
                        <input type="number" id="filterMinYear" min="@minYear" max="@maxYear" step="1" placeholder="Min" value="" />
                        <input type="number" id="filterMaxYear" min="@minYear" max="@maxYear" step="1" placeholder="Max" value="" />
                    </div>
                </div>

                <div class="cars3-field">
                    <label for="filterFuel">Fuel Type</label>
                    <select id="filterFuel">
                        <option value="">All fuels</option>
                        @foreach (var fuel in fuels)
                        {
                            <option value="@fuel">@fuel</option>
                        }
                    </select>
                </div>

                <div class="cars3-field">
                    <label for="filterTransmission">Transmission</label>
                    <select id="filterTransmission">
                        <option value="">All transmissions</option>
                        @foreach (var transmission in transmissions)
                        {
                            <option value="@transmission">@transmission</option>
                        }
                    </select>
                </div>

                <div class="cars3-field">
                    <label>Mileage</label>
                    @* No min/max/step: browser number constraints make partial values invalid while typing. *@
                    <div class="cars3-range">
                        <input type="number" id="filterMinMileage" inputmode="numeric" placeholder="Min" value="" />
                        <input type="number" id="filterMaxMileage" inputmode="numeric" placeholder="Max" value="" />
                    </div>
                </div>

                <div class="cars3-field">
                    <label for="filterSeats">Seats</label>
                    <select id="filterSeats">
                        <option value="">Any</option>
                        @foreach (var seat in seats)
                        {
                            <option value="@seat">@seat seats</option>
                        }
                    </select>
                </div>
            </aside>

            <section class="cars3-results" aria-label="Vehicle results">
                <div class="cars3-panel cars3-toolbar">
                    <p class="cars3-toolbar__count"><span id="carResultCount">@Model.TotalCount</span> vehicles found</p>
                    <div class="cars3-toolbar__sort">
                        <label for="carSort">Sort</label>
                        <select id="carSort">
                            <option value="latest">Latest</option>
                            <option value="price-asc">Price: Low to High</option>
                            <option value="price-desc">Price: High to Low</option>
                            <option value="year-desc">Newest Year</option>
                            <option value="year-asc">Oldest Year</option>
                        </select>
                    </div>
                </div>

                <div id="carList">
                    <partial name="_CarsThreeCards" model="Model" />
                </div>

                <p id="carPriceRangeError" class="cars3-empty cars3-price-error" role="alert" hidden>Minimum price cannot be greater than maximum price.</p>
                <h6 id="carEmpty" class="cars3-empty" @(Model.TotalCount == 0 ? null : "hidden")>No vehicles match these filters.</h6>
                <button type="button" class="rts-btn load-more-btn btn-border cars3-load" id="carLoadMore" @(Model.HasMore ? null : "hidden")>Load More</button>
            </section>
        </div>
    </div>
</div>

<partial name="_DealershipCallCta" />

@section Scripts {
    <script src="~/js/car-favorites.js" asp-append-version="true"></script>
    <script>
        (function () {
            var pageSize = @pageSize;
            var currentPage = @Model.Page;
            var totalCount = @Model.TotalCount;
            var hasMore = @(Model.HasMore ? "true" : "false");
            var resultsUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(resultsUrl));
            var requestToken = 0;
            var loading = false;
            var seenIds = {};

            var search = document.getElementById("carSearch");
            var brand = document.getElementById("filterBrand");
            var model = document.getElementById("filterModel");
            var type = document.getElementById("filterType");
            var minPrice = document.getElementById("filterMinPrice");
            var maxPrice = document.getElementById("filterMaxPrice");
            var minYear = document.getElementById("filterMinYear");
            var maxYear = document.getElementById("filterMaxYear");
            var fuel = document.getElementById("filterFuel");
            var transmission = document.getElementById("filterTransmission");
            var minMileageInput = document.getElementById("filterMinMileage");
            var maxMileageInput = document.getElementById("filterMaxMileage");
            var seats = document.getElementById("filterSeats");
            var sort = document.getElementById("carSort");
            var clearBtn = document.getElementById("carClearFilters");
            var empty = document.getElementById("carEmpty");
            var priceRangeError = document.getElementById("carPriceRangeError");
            var loadMore = document.getElementById("carLoadMore");
            var resultCount = document.getElementById("carResultCount");
            var list = document.getElementById("carList");

            Array.prototype.forEach.call(list.querySelectorAll(".car-card[data-id]"), function (card) {
                seenIds[String(card.getAttribute("data-id"))] = true;
            });

            function parseNonNegativeFilter(raw) {
                var text = String(raw == null ? "" : raw).trim().replace(/\s/g, "").replace(/,/g, "");
                if (text === "") return null;
                var parsed = Number(text);
                if (!Number.isFinite(parsed) || parsed < 0) return null;
                return parsed;
            }

            function priceRangeInvalid() {
                var minEntered = parseNonNegativeFilter(minPrice.value);
                var maxEntered = parseNonNegativeFilter(maxPrice.value);
                return minEntered !== null && maxEntered !== null && minEntered > maxEntered;
            }

            function appendParam(params, name, value) {
                if (value === null || value === undefined) return;
                var text = String(value).trim();
                if (text !== "") params.set(name, text);
            }

            function buildQuery(page) {
                var params = new URLSearchParams();
                appendParam(params, "search", search.value);
                appendParam(params, "brand", brand.value);
                appendParam(params, "model", model.value);
                appendParam(params, "type", type.value);
                appendParam(params, "minPrice", parseNonNegativeFilter(minPrice.value));
                appendParam(params, "maxPrice", parseNonNegativeFilter(maxPrice.value));
                appendParam(params, "minYear", minYear.value);
                appendParam(params, "maxYear", maxYear.value);
                appendParam(params, "fuel", fuel.value);
                appendParam(params, "transmission", transmission.value);
                appendParam(params, "minMileage", parseNonNegativeFilter(minMileageInput.value));
                appendParam(params, "maxMileage", parseNonNegativeFilter(maxMileageInput.value));
                appendParam(params, "seats", seats.value);
                appendParam(params, "sort", sort.value || "latest");
                params.set("page", String(page));
                return params.toString();
            }

            function updateChrome() {
                resultCount.textContent = String(totalCount);
                empty.hidden = totalCount > 0;
                loadMore.hidden = !hasMore;
            }

            function appendUniqueCards(html) {
                var wrapper = document.createElement("div");
                wrapper.innerHTML = html;
                Array.prototype.forEach.call(wrapper.querySelectorAll(".car-card[data-id]"), function (card) {
                    var id = String(card.getAttribute("data-id"));
                    if (seenIds[id]) return;
                    seenIds[id] = true;
                    list.appendChild(card);
                });
            }

            function fetchPage(page, append) {
                if (loading) return;
                var token = ++requestToken;
                loading = true;
                loadMore.disabled = true;

                fetch(resultsUrl + "?" + buildQuery(page), {
                    method: "GET",
                    headers: {
                        Accept: "text/html",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    credentials: "same-origin"
                })
                    .then(function (response) {
                        if (!response.ok) throw new Error("Listing request failed.");
                        currentPage = Number(response.headers.get("X-Cars3-Page") || page) || page;
                        totalCount = Number(response.headers.get("X-Cars3-Total-Count") || "0") || 0;
                        hasMore = response.headers.get("X-Cars3-Has-More") === "1";
                        return response.text();
                    })
                    .then(function (html) {
                        if (token !== requestToken) return;
                        if (!append) {
                            list.innerHTML = "";
                            seenIds = {};
                        }
                        appendUniqueCards(html || "");
                        updateChrome();
                    })
                    .catch(function () {
                        if (token !== requestToken) return;
                        if (!append) {
                            list.innerHTML = "";
                            seenIds = {};
                            totalCount = 0;
                            hasMore = false;
                            updateChrome();
                        }
                    })
                    .finally(function () {
                        if (token !== requestToken) return;
                        loading = false;
                        loadMore.disabled = false;
                    });
            }

            function resetToFirstPage() {
                var invalidPriceRange = priceRangeInvalid();
                priceRangeError.hidden = !invalidPriceRange;
                if (invalidPriceRange) {
                    list.innerHTML = "";
                    seenIds = {};
                    totalCount = 0;
                    hasMore = false;
                    currentPage = 1;
                    updateChrome();
                    empty.hidden = true;
                    return;
                }

                currentPage = 1;
                fetchPage(1, false);
            }

            function onFilterChange() {
                resetToFirstPage();
            }

            // nice-select updates the <select> then fires jQuery .trigger("change"),
            // which does not reach native addEventListener handlers.
            function bindControl(el) {
                el.addEventListener("input", onFilterChange);
                el.addEventListener("change", onFilterChange);
                if (window.jQuery) {
                    window.jQuery(el).on("change", onFilterChange);
                }
            }

            [
                search, brand, model, type, minPrice, maxPrice, minYear, maxYear,
                fuel, transmission, minMileageInput, maxMileageInput, seats, sort
            ].forEach(bindControl);

            [minMileageInput, maxMileageInput].forEach(function (el) {
                el.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();
                    }
                });
            });

            function syncNiceSelect(selectEl) {
                if (!window.jQuery || !window.jQuery.fn || !window.jQuery.fn.niceSelect) return;
                var $select = window.jQuery(selectEl);
                if ($select.next(".nice-select").length) {
                    $select.niceSelect("update");
                }
            }

            clearBtn.addEventListener("click", function () {
                search.value = "";
                brand.value = "";
                model.value = "";
                type.value = "";
                minPrice.value = "";
                maxPrice.value = "";
                minYear.value = "";
                maxYear.value = "";
                fuel.value = "";
                transmission.value = "";
                minMileageInput.value = "";
                maxMileageInput.value = "";
                seats.value = "";
                sort.value = "latest";
                [brand, model, type, fuel, transmission, seats, sort].forEach(syncNiceSelect);
                resetToFirstPage();
            });

            loadMore.addEventListener("click", function (event) {
                event.preventDefault();
                event.stopPropagation();
                if (!hasMore || loading) return;
                var scrollY = window.scrollY || window.pageYOffset || 0;
                fetchPage(currentPage + 1, true);
                window.scrollTo(0, scrollY);
            });

            updateChrome();
        })();
    </script>
}
