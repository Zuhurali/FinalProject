@{
    ViewData["Title"] = "Cars Three - AutoVault";
}

<!-- Content based on portfolio-3.html -->
<div class="rts-breadcrumb-area portfolio jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Cars Three</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Cars</a>
            </div>
        </div>
    </div>
</div>

<div class="rts-portfolio-area inner rts-section-gapNew">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="project-wrapper2">
                    <div class="image-area">
                        <a asp-controller="Cars" asp-action="Details" asp-route-id="1"><img src="~/assets/images/portfolio/04.webp" alt=""></a>
                        <span class="tag">Featured</span>
                        <a href="#" class="wishlist"><i class="fa-regular fa-heart"></i></a>
                    </div>
                    <span class="price">$24,000</span>
                    <div class="content-area">
                        <h6 class="title"><a asp-controller="Cars" asp-action="Details" asp-route-id="1">Luxury Sedan</a></h6>
                        <ul class="feature-area">
                            <li>
                                <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                                120 Miles
                            </li>
                            <li>
                                <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                                Hybrid
                            </li>
                            <li>
                                <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                                Automatic
                            </li>
                        </ul>
                        <div class="button-area">
                            <p class="">$650/mo</p>
                            <a asp-controller="Cars" asp-action="Details" asp-route-id="1" class="rts-btn btn-primary radius-small">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="project-wrapper2">
                    <div class="image-area">
                        <a asp-controller="Cars" asp-action="Details" asp-route-id="2"><img src="~/assets/images/portfolio/05.webp" alt=""></a>
                        <span class="tag">Electric</span>
                        <a href="#" class="wishlist"><i class="fa-regular fa-heart"></i></a>
                    </div>
                    <span class="price">$32,000</span>
                    <div class="content-area">
                        <h6 class="title"><a asp-controller="Cars" asp-action="Details" asp-route-id="2">Electric Vehicle</a></h6>
                        <ul class="feature-area">
                            <li>
                                <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                                200 Miles
                            </li>
                            <li>
                                <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                                Electric
                            </li>
                            <li>
                                <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                                Automatic
                            </li>
                        </ul>
                        <div class="button-area">
                            <p class="">$850/mo</p>
                            <a asp-controller="Cars" asp-action="Details" asp-route-id="2" class="rts-btn btn-primary radius-small">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>