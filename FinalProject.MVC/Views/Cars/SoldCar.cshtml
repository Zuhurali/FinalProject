@model IReadOnlyList<Car>
@{
    ViewData["Title"] = "Sold Cars - AutoVault";
}

<div class="rts-breadcrumb-area portfolio-3 jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Sold</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Cars" asp-action="Index">Cars</a>
                <a href="#" class="current">Sold</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-portfolio-area sold-car rts-section-gap">
    <div class="container">
        <div class="section-inner">
            <div class="row g-5">
                @if (ViewData["CarApiUnavailable"] as bool? == true)
                {
                    <div class="col-12 text-center">
                        <h3 class="title">Sold inventory is temporarily unavailable.</h3>
                        <p>Please try again in a moment.</p>
                    </div>
                }
                else if (Model.Count == 0)
                {
                    <div class="col-12 text-center">
                        <h3 class="title">No sold vehicles are listed yet.</h3>
                        <p class="mb-0">When Admin marks a car as Sold, it appears here from SQL Server.</p>
                        <a asp-action="Index" class="rts-btn btn-primary radius-small mt-3">Browse available cars</a>
                    </div>
                }
                @foreach (var car in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="project-wrapper2">
                            <div class="image-area">
                                <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id">
                                    <img src="@Url.Content(car.ImagePath)" alt="@car.Name">
                                </a>
                                <span class="tag">Sold</span>
                                <a href="@Url.Content(car.ImagePath)" class="gallery-image">
                                    <img src="~/assets/images/icon/image.svg" alt="">
                                    @Math.Max(1, car.ImageCount)
                                </a>
                            </div>
                            <span class="price">@car.Price.ToString("C")</span>
                            <div class="content-area">
                                <h6 class="title">
                                    <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id">@car.Name</a>
                                </h6>
                                <ul class="feature-area">
                                    <li>
                                        <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                                        @car.MileageText
                                    </li>
                                    <li>
                                        <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                                        @car.Fuel
                                    </li>
                                    <li>
                                        <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                                        @car.Transmission
                                    </li>
                                </ul>
                                <div class="button-area">
                                    <p>@car.Year</p>
                                    <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" class="rts-btn btn-primary radius-small">View Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
