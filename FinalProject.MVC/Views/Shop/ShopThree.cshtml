@model FinalProject.MVC.Models.ShopFilterResponse
@{
    ViewData["Title"] = "Shop Three - AutoVault";
}

<!-- Breadcrumb area start -->
<div class="rts-breadcrumb-area portfolio jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Shop</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Shop</a>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb area end -->

<div class="rts-shop-area inner three rts-section-gapTop">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="sticky-top">
                    <div class="left-side-bar">
                        <!-- Search Area -->
                        <div class="search-area side-box">
                            <h2>Cars Search</h2>
                            <form action="#">
                                <div class="input-wrapper">
                                    <input type="text" id="search-input-shop3" placeholder="Search Vehicles" required>
                                    <button type="submit" id="search-btn-shop3"><i class="fa-regular fa-magnifying-glass"></i></button>
                                </div>
                            </form>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                        
                        <!-- Car Make -->
                        <div class="car-make side-box">
                            <h2>Car Make</h2>
                            <ul class="checkbox-list">
                                @foreach (var make in (Dictionary<string, int>)ViewBag.MakeCounts)
                                {
                                    <li class="checkbox-item">
                                        <label class="checkbox-label">
                                            <input type="checkbox" data-filter="make" data-value="@make.Key" />
                                            <span>@make.Key</span>
                                        </label>
                                        <span>(@make.Value)</span>
                                    </li>
                                }
                            </ul>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                        
                        <!-- Car Model -->
                        <div class="car-make side-box">
                            <h2>Car Model</h2>
                            <ul class="checkbox-list">
                                @foreach (var carModel in (Dictionary<string, int>)ViewBag.ModelCounts)
                                {
                                    <li class="checkbox-item">
                                        <label class="checkbox-label">
                                            <input type="checkbox" data-filter="model" data-value="@carModel.Key" />
                                            <span>@carModel.Key</span>
                                        </label>
                                        <span>(@carModel.Value)</span>
                                    </li>
                                }
                            </ul>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                        
                        <!-- Price Slider -->
                        <div class="price-box side-box">
                            <h2>Price</h2>
                            <div class="slider-container">
                                <!-- Histogram -->
                                <div class="histogram">
                                    <div class="histogram-bar" style="height: 67px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 52px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 99px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 99px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 98px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 107px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 102px;"></div>
                                    <div class="histogram-bar" style="height: 52px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 94px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                </div>

                                <!-- Range Slider -->
                                <div class="range-slider" id="price-slider-shop3">
                                    <div class="track"></div>
                                    <div class="range" id="range-shop3"></div>
                                    <input type="range" id="minRange-shop3" min="0" max="3000" value="0" step="50">
                                    <input type="range" id="maxRange-shop3" min="0" max="3000" value="3000" step="50">
                                </div>

                                <!-- Price Labels -->
                                <div class="price-labels">
                                    <span id="minPrice-shop3">$0</span>
                                    <span id="maxPrice-shop3">$3000</span>
                                </div>
                            </div>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                        
                        <!-- Car Color -->
                        <div class="car-make side-box">
                            <h2>Car Color</h2>
                            <ul class="checkbox-list">
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox" data-filter="color" data-value="Black" />
                                        <span>Black</span>
                                    </label>
                                    <span>(8)</span>
                                </li>
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox" data-filter="color" data-value="Silver" />
                                        <span>Silver</span>
                                    </label>
                                    <span>(7)</span>
                                </li>
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox" data-filter="color" data-value="White" />
                                        <span>White</span>
                                    </label>
                                    <span>(5)</span>
                                </li>
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox" data-filter="color" data-value="Blue" />
                                        <span>Blue</span>
                                    </label>
                                    <span>(2)</span>
                                </li>
                                <li class="checkbox-item">
                                    <label class="checkbox-label">
                                        <input type="checkbox" data-filter="color" data-value="Yellow" />
                                        <span>Yellow</span>
                                    </label>
                                    <span>(2)</span>
                                </li>
                            </ul>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                        
                        <!-- Fuel Tags -->
                        <div class="tag-area side-box">
                            <h2>Fuel</h2>
                            <ul>
                                <li><a href="#" data-fuel="Gasoline" style="color: var(--color-heading-1); display: block; text-decoration: none;">Gasoline</a></li>
                                <li><a href="#" data-fuel="Diesel" style="color: var(--color-heading-1); display: block; text-decoration: none;">Diesel</a></li>
                                <li><a href="#" data-fuel="Hybrid" style="color: var(--color-heading-1); display: block; text-decoration: none;">Hybrid</a></li>
                                <li><a href="#" data-fuel="Electric" style="color: var(--color-heading-1); display: block; text-decoration: none;">Electric</a></li>
                            </ul>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-8">
                <div class="right">
                    <div class="row g-5" id="products-container-shop3">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-lg-6 col-md-6">
                                <div class="project-wrapper4">
                                    <div class="image-area">
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">
                                            <img src="@Url.Content(product.ImagePath)" alt="@product.Name">
                                        </a>
                                    </div>
                                    <div class="content-area">
                                        <ul class="star-rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Floor(product.Rating))
                                                {
                                                    <li><i class="rt-icon-star"></i></li>
                                                }
                                                else if (i <= product.Rating)
                                                {
                                                    <li><i class="rt-icon-star-sharp-half-stroke"></i></li>
                                                }
                                                else
                                                {
                                                    <li><i class="rt-icon-star" style="color: #ddd;"></i></li>
                                                }
                                            }
                                        </ul>
                                        <small class="product-rating-summary">
                                            @(product.RatingCount == 0
                                                ? "No ratings"
                                                : $"{product.Rating:0.0} ({product.RatingCount})")
                                        </small>
                                        <h6 class="title">
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                        </h6>
                                        <div class="button-area">
                                            <p class="">$@product.Price</p>
                                            <a href="/Shop/Details/@product.Id#ask-showroom" class="rts-btn btn-primary radius-big">Ask About Product</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    @if (Model.HasMorePages)
                    {
                        <div class="load-more-container" style="text-align: center; margin-top: 50px;">
                            <a href="#" class="rts-btn load-more-btn btn-border" id="load-more-btn-shop3">Load More</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        let currentPage = @Model.CurrentPage;
        let selectedMakes = [];
        let selectedModels = [];
        let selectedColors = [];
        let selectedFuel = '';
        let searchText = '';
        let priceRange = { min: 0, max: 3000 };
        
        const minRange = document.getElementById('minRange-shop3');
        const maxRange = document.getElementById('maxRange-shop3');
        const minPrice = document.getElementById('minPrice-shop3');
        const maxPrice = document.getElementById('maxPrice-shop3');
        const range = document.getElementById('range-shop3');
        
        function updateSlider() {
            const minVal = parseInt(minRange.value);
            const maxVal = parseInt(maxRange.value);
            
            if (maxVal - minVal < 50) {
                if (event.target === minRange) {
                    minRange.value = maxVal - 50;
                } else {
                    maxRange.value = minVal + 50;
                }
            }
            
            priceRange.min = parseInt(minRange.value);
            priceRange.max = parseInt(maxRange.value);
            
            minPrice.textContent = '$' + priceRange.min;
            maxPrice.textContent = '$' + priceRange.max;
            
            const percent1 = (priceRange.min / 3000) * 100;
            const percent2 = (priceRange.max / 3000) * 100;
            range.style.left = percent1 + '%';
            range.style.right = (100 - percent2) + '%';
        }
        
        if (minRange && maxRange) {
            minRange.addEventListener('input', updateSlider);
            maxRange.addEventListener('input', updateSlider);
            minRange.addEventListener('change', applyFilters);
            maxRange.addEventListener('change', applyFilters);
            updateSlider();
        }
        
        function applyFilters() {
            const filterData = {
                searchText: searchText,
                minPrice: priceRange.min,
                maxPrice: priceRange.max,
                selectedMakes: selectedMakes,
                selectedModels: selectedModels,
                selectedColors: selectedColors,
                page: 1,
                pageSize: 12
            };

            $.ajax({
                url: '@Url.Action("FilterProducts", "Shop")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filterData),
                success: function(response) {
                    updateProductsContainer(response, false);
                    currentPage = response.currentPage;
                },
                error: function(xhr, status, error) {
                    console.error('Filter error:', error);
                }
            });
        }

        function updateProductsContainer(response, append = false) {
            let html = '';
            
            if (response.products.length === 0) {
                html = '<div class="col-12"><p class="text-center" style="padding: 50px 0; font-size: 18px;">No products found matching your filters.</p></div>';
                $('#products-container-shop3').html(html);
                $('.load-more-container').hide();
                return;
            }
            
            response.products.forEach(function(product) {
                html += generateProductHtml(product);
            });
            
            if (append) {
                $('#products-container-shop3').append(html);
            } else {
                $('#products-container-shop3').html(html);
            }
            
            if (response.hasMorePages) {
                $('.load-more-container').show();
            } else {
                $('.load-more-container').hide();
            }
        }

        function generateProductHtml(product) {
            let starsHtml = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= Math.floor(product.rating)) {
                    starsHtml += '<li><i class="rt-icon-star"></i></li>';
                } else if (i <= product.rating) {
                    starsHtml += '<li><i class="rt-icon-star-sharp-half-stroke"></i></li>';
                } else {
                    starsHtml += '<li><i class="rt-icon-star" style="color: #ddd;"></i></li>';
                }
            }
            const ratingSummary = product.ratingCount === 0
                ? 'No ratings'
                : Number(product.rating).toFixed(1) + ' (' + product.ratingCount + ')';

            let imagePath = product.imagePath;
            if (imagePath.startsWith('~/')) {
                imagePath = imagePath.substring(1);
            }

            return `
                <div class="col-lg-6 col-md-6">
                    <div class="project-wrapper4">
                        <div class="image-area">
                            <a href="/Shop/Details/${product.id}">
                                <img src="${imagePath}" alt="${product.name}">
                            </a>
                        </div>
                        <div class="content-area">
                            <ul class="star-rating">
                                ${starsHtml}
                            </ul>
                            <small class="product-rating-summary">${ratingSummary}</small>
                            <h6 class="title">
                                <a href="/Shop/Details/${product.id}">${product.name}</a>
                            </h6>
                            <div class="button-area">
                                <p class="">${product.hasOffer
                                    ? `<s>$${Number(product.price).toFixed(2)}</s> <strong>$${Number(product.salePrice).toFixed(2)}</strong> <span class="badge">${Number(product.discountPercent)}% OFF</span>${product.offerEndLabel ? ` <span class="av-card__offer-end">Ends ${product.offerEndLabel}</span>` : ''}`
                                    : `$${Number(product.price).toFixed(2)}`}</p>
                                <a href="/Shop/Details/${product.id}#ask-showroom" class="rts-btn btn-primary radius-big">Ask About Product</a>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        $('#search-input-shop3').on('input', function() {
            searchText = $(this).val().trim();
        });
        
        $('#search-btn-shop3').on('click', function(e) {
            e.preventDefault();
            applyFilters();
        });
        
        $('.search-area .cross').on('click', function() {
            searchText = '';
            $('#search-input-shop3').val('');
            applyFilters();
        });

        $('input[data-filter="make"]').on('change', function() {
            const value = $(this).data('value');
            if (this.checked) {
                if (!selectedMakes.includes(value)) {
                    selectedMakes.push(value);
                }
            } else {
                selectedMakes = selectedMakes.filter(m => m !== value);
            }
            applyFilters();
        });

        $('input[data-filter="model"]').on('change', function() {
            const value = $(this).data('value');
            if (this.checked) {
                if (!selectedModels.includes(value)) {
                    selectedModels.push(value);
                }
            } else {
                selectedModels = selectedModels.filter(m => m !== value);
            }
            applyFilters();
        });

        $('input[data-filter="color"]').on('change', function() {
            const value = $(this).data('value');
            if (this.checked) {
                if (!selectedColors.includes(value)) {
                    selectedColors.push(value);
                }
            } else {
                selectedColors = selectedColors.filter(c => c !== value);
            }
            applyFilters();
        });

        $('.tag-area a').on('click', function(e) {
            e.preventDefault();
            const fuel = $(this).data('fuel');
            
            if (selectedFuel === fuel) {
                selectedFuel = '';
                $(this).removeClass('active');
            } else {
                $('.tag-area a').removeClass('active');
                selectedFuel = fuel;
                $(this).addClass('active');
            }
            
            applyFilters();
        });

        $(document).on('click', '#load-more-btn-shop3', function(e) {
            e.preventDefault();
            
            const filterData = {
                searchText: searchText,
                minPrice: priceRange.min,
                maxPrice: priceRange.max,
                selectedMakes: selectedMakes,
                selectedModels: selectedModels,
                selectedColors: selectedColors,
                page: currentPage + 1,
                pageSize: 12
            };
            
            $.ajax({
                url: '@Url.Action("FilterProducts", "Shop")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filterData),
                success: function(response) {
                    updateProductsContainer(response, true);
                    currentPage = response.currentPage;
                },
                error: function(xhr, status, error) {
                    console.error('Load more error:', error);
                }
            });
        });

    });
</script>
}
