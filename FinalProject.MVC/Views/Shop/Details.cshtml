@model FinalProject.MVC.Models.ShopProduct
@using System.Text.Json
@using FinalProject.MVC.Commerce
@{
    ViewData["Title"] = $"{Model.Name} - AutoVault";
    var stockModifier = Model.StockStatus switch
    {
        "Out of Stock" => "out",
        "Low Stock" => "low",
        _ => "in"
    };
    var stockText = Model.Quantity <= 0
        ? "Out of stock"
        : Model.StockStatus == "Low Stock"
            ? $"Low stock · {Model.Quantity} left"
            : $"In stock · {Model.Quantity} available";
    var related = ViewBag.RelatedProducts as IReadOnlyList<ShopProduct> ?? Array.Empty<ShopProduct>();
    var photos = ProductImageCredits.Gallery(Model.ImagePath);
    var hasPhoto = photos.Count > 0;
    var hasGallery = photos.Count > 1;
    var signedInEmail = ViewBag.AskEmail as string ?? "";
    var signedInDisplayName = ViewBag.AskDisplayName as string ?? "";

    var form = new Dictionary<string, string?>();
    if (TempData["RequestForm"] is string formJson)
    {
        foreach (var property in JsonDocument.Parse(formJson).RootElement.EnumerateObject())
        {
            form[property.Name] = property.Value.ValueKind == JsonValueKind.Null ? null : property.Value.ToString();
        }
    }
    string? Field(string name, string? fallback = null) => form.TryGetValue(name, out var value) ? value : fallback;

    var maxRequestQuantity = Math.Min(Model.Quantity, ShowroomRequestRules.MaxQuantityPerRequest);
    var today = DateTime.Now.Date;
}

<!-- Breadcrumb area start -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Product Details</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Shop" asp-action="Index">Shop</a>
                <a href="#" class="current">@Model.Name</a>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb area end -->

<div class="av-detail-page rts-section-gapTop">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="av-detail">
            <div class="av-detail__media">
                <figure class="av-detail__figure" @(hasPhoto ? "data-car-gallery" : "")>
                    <a href="@Url.Content(Model.ImagePath)" class="av-detail__frame" data-gallery-open aria-label="Open photo 1 of @photos.Count full size">
                        <img src="@Url.Content(Model.ImagePath)" alt="@Model.Name, photo 1 of @photos.Count" width="1600" height="1200" fetchpriority="high" data-gallery-main>
                        @if (Model.Quantity <= 0)
                        {
                            <span class="av-card__badge av-card__badge--out">Out of stock</span>
                        }
                        else if (Model.HasOffer)
                        {
                            <span class="av-card__badge av-card__badge--offer">@Model.DiscountPercent% OFF</span>
                        }
                    </a>
                    @if (hasGallery)
                    {
                        <div class="av-detail__thumbs">
                            @for (var index = 0; index < photos.Count; index++)
                            {
                                <button type="button"
                                        class="av-detail__thumb@(index == 0 ? " is-active" : string.Empty)"
                                        data-gallery-thumb
                                        data-index="@index"
                                        data-src="@Url.Content(photos[index])"
                                        aria-label="Show photo @(index + 1) of @photos.Count"
                                        aria-pressed="@(index == 0 ? "true" : "false")">
                                    <img src="@Url.Content(photos[index])" alt="" loading="lazy">
                                </button>
                            }
                        </div>
                    }
                </figure>
            </div>

            <div class="av-detail__info">
                <p class="av-detail__eyebrow">
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="@Model.Category">@Model.Category</a>
                </p>
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <h2 class="av-detail__title mb-0">@Model.Name</h2>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-action="@(Model.IsFavorite ? "RemoveFavorite" : "AddFavorite")"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="mb-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit"
                                    class="btn btn-outline-dark btn-sm"
                                    title="@(Model.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                                    aria-pressed="@(Model.IsFavorite ? "true" : "false")">
                                <i class="@(Model.IsFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
                                @(Model.IsFavorite ? "Saved" : "Save")
                            </button>
                        </form>
                    }
                </div>
                @if (TempData["FavoriteError"] != null)
                {
                    <p class="text-danger small mt-2">@TempData["FavoriteError"]</p>
                }

                <div class="av-detail__rating">
                    <ul class="ms-rating-icon" id="averageRatingStars" aria-hidden="true">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <li><i class="@(i <= Math.Round(Model.Rating) ? "fa-sharp fa-solid fa-star" : "fa-light fa-star")"></i></li>
                        }
                    </ul>
                    <a href="#reviews" id="averageRatingText" rel="nofollow">
                        @if (Model.RatingCount == 0)
                        {
                            <text>No ratings</text>
                        }
                        else
                        {
                            <text>@Model.Rating.ToString("0.0") (@(Model.ReviewCount > 0 ? Model.ReviewCount : Model.RatingCount) @(Model.ReviewCount == 1 ? "Review" : Model.ReviewCount > 1 ? "Reviews" : Model.RatingCount == 1 ? "Rating" : "Ratings"))</text>
                        }
                    </a>
                </div>
                @if (Model.RealSalesCount > 0)
                {
                    <p class="av-detail__sales">In-Store Sales: @Model.RealSalesCount</p>
                }

                <div class="av-detail__price-row">
                    <p class="av-detail__price">
                        @if (Model.HasOffer)
                        {
                            <s>$@Model.Price.ToString("0.00")</s>
                            <strong>$@Model.SalePrice.ToString("0.00")</strong>
                        }
                        else
                        {
                            <span>$@Model.Price.ToString("0.00")</span>
                        }
                    </p>
                    <p class="av-detail__stock av-card__stock av-detail__stock--@stockModifier">@stockText</p>
                </div>
                @if (Model.HasOffer)
                {
                    <p class="av-detail__offer">@($"{Model.DiscountPercent}% OFF")@(string.IsNullOrWhiteSpace(Model.OfferEndLabel) ? "" : $" · Ends {Model.OfferEndLabel}")</p>
                }

                <p class="av-detail__description">@Model.Description</p>

                <dl class="av-detail__meta">
                    <div><dt>Category</dt><dd>@Model.Category</dd></div>
                    <div><dt>Availability</dt><dd>@Model.StockStatus</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.Brand))
                    {
                        <div><dt>Brand</dt><dd>@Model.Brand</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Compatibility))
                    {
                        <div><dt>Compatibility</dt><dd>@Model.Compatibility</dd></div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Color))
                    {
                        <div><dt>Color</dt><dd>@Model.Color</dd></div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Fuel))
                    {
                        <div><dt>Fuel type</dt><dd>@Model.Fuel</dd></div>
                    }
                </dl>

                <section class="av-request" id="request-to-buy" aria-labelledby="request-to-buy-title">
                    <div class="av-request__head">
                        <div>
                            <h3 id="request-to-buy-title">Buy in Store</h3>
                            <p class="av-request__lead">No online payment. Send a request and our team will contact you. You pay and collect in person.</p>
                        </div>
                    </div>

                    @if (TempData["RequestSuccess"] != null)
                    {
                        <div class="alert alert-success" role="status" id="request-success">@TempData["RequestSuccess"]</div>
                    }

                    @if (Model.Quantity > 0)
                    {
                        var requestError = TempData["RequestError"] as string;
                        <button type="button" class="av-btn av-btn--primary av-request__toggle" id="request-toggle" aria-expanded="@(requestError != null ? "true" : "false")" aria-controls="request-panel" @(requestError != null ? "hidden" : "")>Request to Buy</button>
                        <div class="av-request__panel" id="request-panel" @(requestError == null ? "hidden" : "")>
                        @if (requestError != null)
                        {
                            <div class="alert alert-danger" role="alert">@requestError</div>
                        }
                        <form asp-controller="Shop" asp-action="RequestToBuy" method="post" class="av-request__form" id="request-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ProductId" value="@Model.Id" />
                            <input type="hidden" name="SubmissionKey" value="@ViewBag.SubmissionKey" />
                            <div class="av-form-grid">
                                <label>
                                    <span>Name</span>
                                    <input class="form-control" type="text" name="CustomerName" minlength="2" maxlength="80" autocomplete="name" value="@Field("CustomerName")" required />
                                </label>
                                <label>
                                    <span>Phone</span>
                                    <input class="form-control" type="tel" name="Phone" maxlength="40" autocomplete="tel" placeholder="+994 ..." value="@Field("Phone")" required />
                                </label>
                                <label class="av-form-grid__wide">
                                    <span>Email</span>
                                    <input class="form-control" type="email" name="Email" maxlength="200" autocomplete="email" value="@Field("Email", signedInEmail)" required />
                                </label>
                                <label>
                                    <span>Quantity (max @maxRequestQuantity)</span>
                                    <input class="form-control" type="number" name="Quantity" min="1" max="@maxRequestQuantity" step="1" value="@Field("Quantity", "1")" required />
                                </label>
                                <label>
                                    <span>Preferred visit date <em>(optional)</em></span>
                                    <input class="form-control" type="date" name="PreferredVisitDate" min="@today.ToString("yyyy-MM-dd")" max="@today.AddDays(ShowroomRequestRules.MaxVisitDaysAhead).ToString("yyyy-MM-dd")" value="@Field("PreferredVisitDate")" />
                                </label>
                                <label class="av-form-grid__wide">
                                    <span>Note <em>(optional)</em></span>
                                    <textarea class="form-control" name="Note" maxlength="@ShowroomRequestRules.MaxNoteLength" rows="2">@Field("Note")</textarea>
                                </label>
                            </div>
                            <p class="av-request__fine">A request is not a confirmed purchase, and stock is not held until our team confirms.</p>
                            <div class="av-request__actions">
                                <button type="submit" class="av-btn av-btn--primary" id="request-submit">Send Request</button>
                                <button type="button" class="av-btn av-btn--ghost" id="request-cancel">Cancel</button>
                            </div>
                        </form>
                        </div>
                    }
                    else
                    {
                        if (TempData["RequestError"] is string closedError)
                        {
                            <div class="alert alert-danger" role="alert">@closedError</div>
                        }
                        <div class="av-request__closed" role="note">
                            <strong>Out of stock.</strong>
                            Purchase requests reopen when the store has this item again. You can ask a question below or call the store.
                        </div>
                    }

                    <ul class="av-request__contact">
                        <li><i class="fa-regular fa-location-dot" aria-hidden="true"></i> Babek Prospekti 22–24, Baku, Azerbaijan</li>
                        <li><i class="fa-regular fa-phone" aria-hidden="true"></i> <a href="@Site.Contact.TelHref" aria-label="Call AutoVault at @Site.Contact.DisplayPhone">@Site.Contact.DisplayPhone</a></li>
                        <li><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> <a href="@Site.Contact.WhatsAppHref" target="_blank" rel="noopener noreferrer" aria-label="Open WhatsApp chat with AutoVault">WhatsApp</a></li>
                        <li><i class="fa-regular fa-envelope" aria-hidden="true"></i> <a href="@Site.Contact.MailtoHref">@Site.Contact.Email</a></li>
                    </ul>
                </section>

                <details class="av-ask" id="ask-question">
                    <summary>Ask a question about this product</summary>
                    <span id="ask-showroom"></span>
                    <form asp-controller="Shop" asp-action="Ask" method="post" class="av-ask__form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProductId" value="@Model.Id" />
                        <div class="av-form-grid">
                            <input class="form-control" type="text" name="CustomerName" maxlength="80" placeholder="Your name" aria-label="Your name" value="@signedInDisplayName" required />
                            <input class="form-control" type="email" name="Email" maxlength="200" placeholder="Email address" aria-label="Email address" value="@signedInEmail" required />
                            <textarea class="form-control av-form-grid__wide" name="Message" minlength="10" maxlength="1000" rows="3" placeholder="Ask about availability or fitment" aria-label="Your question" required></textarea>
                        </div>
                        <button type="submit" class="av-btn av-btn--ghost">Send Question</button>
                    </form>
                </details>

                @{
                    var productInquiries = ViewBag.ProductInquiries as IList<FinalProject.MVC.Models.ProductInquiry>
                        ?? new List<FinalProject.MVC.Models.ProductInquiry>();
                }
                @if (productInquiries.Count > 0)
                {
                    <section class="av-ask__answers mt-3" aria-label="Answered questions">
                        <h6 class="mb-2">Questions and answers</h6>
                        @foreach (var qa in productInquiries)
                        {
                            <article class="av-ask__qa mb-3 p-3 border rounded">
                                <p class="fw-semibold mb-1">Q: @qa.Message</p>
                                <p class="text-muted small mb-1">@qa.CustomerName · @qa.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
                                <p class="mb-0"><strong>A:</strong> @qa.AdminReply</p>
                                @if (qa.AdminRepliedAt.HasValue)
                                {
                                    <p class="text-muted small mb-0">Store reply · @qa.AdminRepliedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</p>
                                }
                            </article>
                        }
                    </section>
                }

                <div class="product-user-rating">
                    <h6>Your Rating</h6>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var userRatingVal = (int?)ViewBag.UserRating ?? 0;
                        var userRatingId  = (int?)ViewBag.UserRatingId ?? 0;
                        <form id="productRatingForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="selectedRating" value="@userRatingVal" />
                            <input type="hidden" id="userRatingId"   value="@userRatingId" />
                            <div class="user-rating-stars" role="radiogroup" aria-label="Your rating">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <button type="button"
                                            class="rating-star @(i <= userRatingVal ? "selected" : "")"
                                            data-rating="@i"
                                            aria-label="@i star rating"
                                            aria-pressed="@(i <= userRatingVal ? "true" : "false")">
                                        <i class="fa-solid fa-star"></i>
                                    </button>
                                }
                            </div>
                            @if (userRatingVal > 0)
                            {
                                <p id="ratingMessage" class="mt--10" style="color:#6c757d;" aria-live="polite">
                                    You rated this product @userRatingVal star@(userRatingVal == 1 ? "" : "s").
                                </p>
                                <button type="button" class="av-btn av-btn--ghost av-btn--small mt-1" id="deleteRatingBtn">
                                    Delete My Rating
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="av-btn av-btn--ghost av-btn--small" id="submitRatingBtn">Submit Rating</button>
                                <p id="ratingMessage" class="mt--10" aria-live="polite"></p>
                            }
                        </form>
                    }
                    else
                    {
                        <p>
                            <a asp-controller="Account"
                               asp-action="SignIn"
                               asp-route-returnUrl="@Context.Request.Path">Please sign in to rate this product.</a>
                        </p>
                    }
                </div>
            </div>
        </div>

        <!-- Tabs Section -->
        <div class="av-detail-tabs tab-area">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">Description</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">Specifications</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="messages-tab" data-bs-toggle="tab" data-bs-target="#messages" type="button" role="tab" aria-controls="messages" aria-selected="false">Reviews</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane active" id="home" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
                    <p>@Model.Description</p>
                    <p>Buy and collect this item at the AutoVault store, Babek Prospekti 22–24, Baku. Compatibility is listed only when it is known for this product.</p>
                </div>
                <div class="tab-pane" id="profile" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
                    <div class="ms-section-title">
                        <h3 class="ms-heading-title">Product Specifications</h3>
                        <ul>
                            <li><i class="fa-regular fa-circle-check"></i> <strong>Product Name:</strong> @Model.Name</li>
                            <li><i class="fa-regular fa-circle-check"></i> <strong>Category:</strong> @Model.Category</li>
                            @if (!string.IsNullOrWhiteSpace(Model.Brand))
                            {
                                <li><i class="fa-regular fa-circle-check"></i> <strong>Brand:</strong> @Model.Brand</li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Compatibility))
                            {
                                <li><i class="fa-regular fa-circle-check"></i> <strong>Compatibility:</strong> @Model.Compatibility</li>
                            }
                            @if (!string.IsNullOrEmpty(Model.Color))
                            {
                                <li><i class="fa-regular fa-circle-check"></i> <strong>Color:</strong> @Model.Color</li>
                            }
                            @if (!string.IsNullOrEmpty(Model.Fuel))
                            {
                                <li><i class="fa-regular fa-circle-check"></i> <strong>Fuel Type Compatibility:</strong> @Model.Fuel</li>
                            }
                            <li><i class="fa-regular fa-circle-check"></i> <strong>Price:</strong>
                                @if (Model.HasOffer)
                                {
                                    <s>$@Model.Price.ToString("0.00")</s>
                                    <strong>$@Model.SalePrice.ToString("0.00")</strong>
                                    <text>(@($"{Model.DiscountPercent}% OFF"))</text>
                                }
                                else
                                {
                                    <text>$@Model.Price.ToString("0.00")</text>
                                }
                            </li>
                            <li><i class="fa-regular fa-circle-check"></i> <strong>Availability:</strong> @stockText</li>
                            <li><i class="fa-regular fa-circle-check"></i> <strong>Rating:</strong> @(Model.RatingCount > 0 ? $"{Model.Rating:0.0} / 5.0" : "No ratings yet")</li>
                        </ul>
                    </div>
                </div>
                <div class="tab-pane" id="messages" role="tabpanel" aria-labelledby="messages-tab" tabindex="0">
                    <div id="reviews" class="woocommerce-Reviews" data-can-view-history="@((User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) ? "true" : "false")">
                        @{
                            var reviews = ViewBag.Reviews as IEnumerable<FinalProject.MVC.Models.Api.ProductReviewDto>
                                ?? Enumerable.Empty<FinalProject.MVC.Models.Api.ProductReviewDto>();
                        }
                        @if (ViewData["ReviewServiceUnavailable"] as bool? == true)
                        {
                            <p>Reviews are temporarily unavailable.</p>
                        }
                        @foreach (var review in reviews)
                        {
                            <div class="reveiw-box mb--30" id="review-block-@review.Id" data-review-id="@review.Id">
                                <h6>
                                    @review.UserDisplayName
                                    <span id="review-edited-@review.Id" class="text-muted" @(review.WasEdited ? "" : "hidden")>(edited)</span>
                                </h6>
                                <p>@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
                                @if (review.IsHidden)
                                {
                                    <p><em>Hidden from the shop.</em></p>
                                }
                                @* Static content — JS replaces this on inline edit *@
                                <p id="review-content-@review.Id">@review.Content</p>

                                @if (review.CanEdit && User.Identity?.IsAuthenticated == true)
                                {
                                    @* Inline edit section — hidden until user clicks Edit *@
                                    <div id="review-view-actions-@review.Id">
                                        <button type="button"
                                                class="btn btn-link p-0 review-edit-open"
                                                data-review-id="@review.Id"
                                                data-product-id="@Model.Id">Edit</button>
                                        <form asp-controller="Shop" asp-action="DeleteReview" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@Model.Id" />
                                            <input type="hidden" name="reviewId" value="@review.Id" />
                                            <button type="submit" class="btn btn-link p-0 ms-2">Delete</button>
                                        </form>
                                    </div>

                                    <div id="review-editor-@review.Id" hidden>
                                        <textarea id="review-textarea-@review.Id"
                                                  class="form-control mt-2"
                                                  rows="4"
                                                  minlength="1"
                                                  maxlength="1000"
                                                  placeholder="Write your review (up to 1 000 characters)">@review.Content</textarea>
                                        <p id="review-editor-error-@review.Id" class="text-danger small mt-1" aria-live="polite" hidden></p>
                                        <p id="review-editor-status-@review.Id" class="text-success small mt-1" aria-live="polite" hidden></p>
                                        <div class="mt-1 d-flex gap-2">
                                            <button type="button"
                                                    class="av-btn av-btn--ghost av-btn--small review-edit-save"
                                                    data-review-id="@review.Id"
                                                    data-product-id="@Model.Id">Save</button>
                                            <button type="button"
                                                    class="btn btn-link p-0 review-edit-cancel"
                                                    data-review-id="@review.Id">Cancel</button>
                                        </div>
                                    </div>
                                }
                                @if ((User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) && review.WasEdited)
                                {
                                    <button type="button" class="btn btn-link p-0 review-history-open" data-review-id="@review.Id">Original text</button>
                                    <div id="review-history-@review.Id" class="small mt-2" hidden></div>
                                }
                            </div>
                        }
                        @if (!reviews.Any())
                        {
                            <p>No written reviews yet.</p>
                        }
                        <div class="reveiw-form">
                            <h2 class="mb--30">Write a review</h2>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @* New-review form — unchanged full-page POST *@
                                <form asp-controller="Shop" asp-action="SaveReview" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <textarea name="content" minlength="1" maxlength="1000" required placeholder="Write your review (up to 1 000 characters)."></textarea>
                                    <button type="submit" class="rts-btn btn-primary">Submit Review</button>
                                </form>
                            }
                            else
                            {
                                <p><a asp-controller="Account" asp-action="SignIn" asp-route-returnUrl="@Context.Request.Path">Sign in to write a review.</a></p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (related.Count > 0)
        {
            <section class="av-related" aria-labelledby="related-title">
                <div class="av-related__head">
                    <h2 id="related-title">More parts in the shop</h2>
                    <a asp-controller="Shop" asp-action="Index">View all parts</a>
                </div>
                <div class="av-grid">
                    @foreach (var product in related)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            </section>
        }
    </div>
</div>

@if (hasPhoto)
{
    <div id="vehicle-lightbox" class="vehicle-lightbox" role="dialog" aria-modal="true" aria-label="@Model.Name photos" hidden>
        <div class="vehicle-lightbox__backdrop" data-lightbox-close></div>
        <button type="button" class="vehicle-lightbox__close" data-lightbox-close aria-label="Close photo viewer">&times;</button>
        @if (hasGallery)
        {
            <button type="button" class="vehicle-lightbox__nav vehicle-lightbox__prev" data-lightbox-prev aria-label="Previous photo">&lsaquo;</button>
            <button type="button" class="vehicle-lightbox__nav vehicle-lightbox__next" data-lightbox-next aria-label="Next photo">&rsaquo;</button>
        }
        <figure class="vehicle-lightbox__stage">
            <img class="vehicle-lightbox__image" alt="@Model.Name">
            <figcaption class="vehicle-lightbox__caption" @(hasGallery ? "" : "hidden")></figcaption>
        </figure>
    </div>
}

@section Scripts {
@if (hasPhoto)
{
    <script src="~/js/car-details.js" asp-append-version="true"></script>
}
<script>
    $(document).ready(function() {
        if (location.hash === '#ask-question' || location.hash === '#ask-showroom') {
            const ask = document.getElementById('ask-question');
            ask.open = true;
            ask.scrollIntoView({ block: 'start' });
        }

        function openRequestPanel(focus) {
            const panel = document.getElementById('request-panel');
            if (!panel) {
                return;
            }
            panel.hidden = false;
            $('#request-toggle').attr('aria-expanded', 'true').prop('hidden', true);
            if (focus) {
                panel.querySelector('input[name="CustomerName"]').focus();
            }
        }

        $('#request-toggle').on('click', function() {
            openRequestPanel(true);
        });
        $('#request-cancel').on('click', function() {
            document.getElementById('request-panel').hidden = true;
            $('#request-toggle').attr('aria-expanded', 'false').prop('hidden', false).trigger('focus');
        });
        if (location.hash === '#request-to-buy' && !document.getElementById('request-success')) {
            openRequestPanel(false);
        }

        $('#request-form').on('submit', function(event) {
            const button = $('#request-submit');
            if (button.prop('disabled')) {
                event.preventDefault();
                return;
            }
            button.prop('disabled', true).text('Sending...');
            $('#request-cancel').prop('disabled', true);
        });
        window.addEventListener('pageshow', function() {
            $('#request-submit').prop('disabled', false).text('Send Request');
            $('#request-cancel').prop('disabled', false);
        });

        function paintUserRating(value) {
            $('.rating-star').each(function() {
                const active = Number($(this).data('rating')) <= value;
                $(this).toggleClass('selected', active).attr('aria-pressed', active);
            });
        }

        function paintAverageRating(average, count) {
            $('#averageRatingStars li i').each(function(index) {
                $(this)
                    .toggleClass('fa-sharp fa-solid', index < Math.round(average))
                    .toggleClass('fa-light', index >= Math.round(average));
            });
            $('#averageRatingText').text(
                count === 0
                    ? 'No ratings'
                    : average.toFixed(1) + ' (' + count + (count === 1 ? ' Rating)' : ' Ratings)'));
        }

        $('.rating-star').on('click', function() {
            const value = Number($(this).data('rating'));
            $('#selectedRating').val(value);
            paintUserRating(value);
        });

        $('#productRatingForm').on('submit', function(event) {
            event.preventDefault();
            const rating = Number($('#selectedRating').val());
            const button = $('#submitRatingBtn');
            const message = $('#ratingMessage');

            if (rating < 1 || rating > 5) {
                message.text('Choose a rating from 1 to 5 stars.').css('color', '#dc3545');
                return;
            }

            button.prop('disabled', true).text('Saving...');
            $.ajax({
                url: '@Url.Action("SubmitRating", "Shop")',
                type: 'POST',
                data: {
                    productId: @Model.Id,
                    rating: rating,
                    __RequestVerificationToken: $('#productRatingForm input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    paintUserRating(response.userRating);
                    paintAverageRating(response.averageRating, response.totalCount);
                    message.text(response.message).css('color', '#28a745');
                    // Show delete button, hide submit button
                    $('#submitRatingBtn').hide();
                    $('#userRatingId').val(response.ratingId || 0);
                    if (!$('#deleteRatingBtn').length) {
                        $('<button type="button" class="av-btn av-btn--ghost av-btn--small mt-1" id="deleteRatingBtn">Delete My Rating</button>')
                            .insertAfter(message);
                    }
                    $('#deleteRatingBtn').show();
                },
                error: function(xhr) {
                    const response = xhr.responseJSON;
                    if (xhr.status === 409 || response?.alreadyRated) {
                        message.text(response?.message || 'You already rated this product. Delete your existing rating before submitting a new one.')
                               .css('color', '#856404');
                    } else {
                        message.text(response?.message || 'Ratings are temporarily unavailable. Please try again.')
                               .css('color', '#dc3545');
                    }
                },
                complete: function() {
                    button.prop('disabled', false).text('Submit Rating');
                }
            });
        });

        // Delete my rating
        $(document).on('click', '#deleteRatingBtn', function() {
            const ratingId = Number($('#userRatingId').val());
            const button = $(this);
            const message = $('#ratingMessage');

            if (!ratingId) {
                message.text('No rating found to delete.').css('color', '#dc3545');
                return;
            }

            button.prop('disabled', true).text('Deleting...');
            $.ajax({
                url: '@Url.Action("DeleteMyRating", "Shop")',
                type: 'POST',
                data: {
                    productId: @Model.Id,
                    ratingId: ratingId,
                    __RequestVerificationToken: $('#productRatingForm input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    paintUserRating(0);
                    paintAverageRating(response.averageRating, response.totalCount);
                    message.text(response.message).css('color', '#28a745');
                    $('#userRatingId').val(0);
                    button.hide();
                    // Show submit button again
                    if (!$('#submitRatingBtn').length) {
                        $('<button type="submit" class="av-btn av-btn--ghost av-btn--small" id="submitRatingBtn">Submit Rating</button>')
                            .insertBefore(message);
                    }
                    $('#submitRatingBtn').show();
                },
                error: function(xhr) {
                    const response = xhr.responseJSON;
                    message.text(response?.message || 'Could not delete rating. Please try again.').css('color', '#dc3545');
                    button.prop('disabled', false).text('Delete My Rating');
                }
            });
        });

        // -- Inline review editor ---------------------------------------------
        // Reads the antiforgery token from any rendered form on the page.
        function getReviewAFToken() {
            const field = document.querySelector('input[name="__RequestVerificationToken"]');
            return field ? field.value : '';
        }

        // Open editor in place — preserve scroll position
        $(document).on('click', '.review-edit-open', function () {
            const reviewId = $(this).data('review-id');
            $('#review-view-actions-' + reviewId).hide();
            const editor = $('#review-editor-' + reviewId);
            editor.show();
            const ta = document.getElementById('review-textarea-' + reviewId);
            ta.focus();
            ta.setSelectionRange(ta.value.length, ta.value.length);
        });

        // Cancel — close editor, restore original text, stay at same scroll position
        $(document).on('click', '.review-edit-cancel', function () {
            const reviewId = $(this).data('review-id');
            $('#review-editor-' + reviewId).hide();
            $('#review-view-actions-' + reviewId).show();
            // Restore textarea to the last known saved value shown in the DOM
            const saved = $('#review-content-' + reviewId).text();
            $('#review-textarea-' + reviewId).val(saved);
            $('#review-editor-error-' + reviewId).hide().text('');
        });

        // Save review via fetch — update DOM in place, no page reload
        $(document).on('click', '.review-edit-save', async function () {
            const reviewId = $(this).data('review-id');
            const productId = $(this).data('product-id');
            const btn = $(this);
            const errEl = $('#review-editor-error-' + reviewId);
            const content = $('#review-textarea-' + reviewId).val().trim();

            // Client-side validation
            if (content.length < 1) {
                errEl.text('Write at least 1 character.').show();
                return;
            }
            if (content.length > 1000) {
                errEl.text('Reviews cannot exceed 1 000 characters.').show();
                return;
            }

            btn.prop('disabled', true).text('Saving…');
            errEl.hide();

            try {
                const formData = new FormData();
                formData.append('productId', productId);
                formData.append('reviewId', reviewId);
                formData.append('content', content);
                formData.append('__RequestVerificationToken', getReviewAFToken());

                const response = await fetch('@Url.Action("SaveReviewJson", "Shop")', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (!data.ok) {
                    errEl.text(data.error || 'Could not save your review.').show();
                    return;
                }

                const savedText = data.review.content;
                $('#review-content-' + reviewId).text(savedText);
                $('#review-edited-' + reviewId).prop('hidden', !data.review.wasEdited);
                $('#review-editor-' + reviewId).hide();
                $('#review-view-actions-' + reviewId).show();
                $('#review-textarea-' + reviewId).val(savedText);
                let note = document.getElementById('review-save-note-' + reviewId);
                if (!note) {
                    note = document.createElement('p');
                    note.id = 'review-save-note-' + reviewId;
                    note.className = 'text-success small';
                    document.getElementById('review-content-' + reviewId).after(note);
                }
                note.textContent = 'Your review was updated.';
                const reviewsRoot = document.getElementById('reviews');
                if (data.review.wasEdited && reviewsRoot?.dataset.canViewHistory === 'true' && !document.getElementById('review-history-' + reviewId)) {
                    const historyButton = document.createElement('button');
                    historyButton.type = 'button';
                    historyButton.className = 'btn btn-link p-0 review-history-open';
                    historyButton.dataset.reviewId = reviewId;
                    historyButton.textContent = 'Original text';
                    const historyPanel = document.createElement('div');
                    historyPanel.id = 'review-history-' + reviewId;
                    historyPanel.className = 'small mt-2';
                    historyPanel.hidden = true;
                    note.after(historyButton, historyPanel);
                }

            } catch (err) {
                errEl.text('Network error. Your review was not saved — please try again.').show();
            } finally {
                btn.prop('disabled', false).text('Save');
            }
        });

        $(document).on('click', '.review-history-open', async function () {
            const reviewId = $(this).data('review-id');
            const panel = document.getElementById('review-history-' + reviewId);
            if (!panel) {
                return;
            }
            if (!panel.hidden && panel.dataset.loaded === '1') {
                panel.hidden = true;
                return;
            }
            const button = this;
            button.disabled = true;
            try {
                const response = await fetch('/Admin/Reviews/History/' + reviewId);
                const data = await response.json();
                panel.replaceChildren();
                if (!response.ok || !data.ok) {
                    panel.textContent = data.error || 'The original text could not be loaded.';
                    panel.hidden = false;
                    return;
                }
                (data.items || []).forEach(function (item) {
                    const when = document.createElement('div');
                    when.className = 'text-muted';
                    when.textContent = 'Previous text · ' + item.editedAt;
                    const body = document.createElement('p');
                    body.style.whiteSpace = 'pre-wrap';
                    body.textContent = item.previousContent;
                    panel.appendChild(when);
                    panel.appendChild(body);
                });
                if (!data.items || data.items.length === 0) {
                    panel.textContent = 'No earlier text is stored.';
                }
                panel.dataset.loaded = '1';
                panel.hidden = false;
            } catch (err) {
                panel.hidden = false;
                panel.textContent = 'The original text could not be loaded.';
            } finally {
                button.disabled = false;
            }
        });
    });
</script>
}
