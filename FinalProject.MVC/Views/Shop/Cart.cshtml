@model FinalProject.MVC.Models.CartViewModel
@{
    ViewData["Title"] = "Inquiry List - AutoVault";
}

<!-- Breadcrumb area start -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Inquiry List</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Inquiry List</a>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb area end -->

<main class="ms-main">
    <div class="ms-page-content">
        <!--================= Cart Area Start =================-->
        <article class="post page">
            <div class="ms-default-page container">
                <div class="woocommerce">
                    <div class="woocommerce-notices-wrapper"></div>
                    
                    @if (TempData["CheckoutError"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            @TempData["CheckoutError"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    @if (Model.IsEmpty)
                    {
                        <!-- Empty Cart Message -->
                        <div class="cart-empty-message" style="text-align: center; padding: 80px 20px;">
                            <svg width="100" height="100" viewBox="0 0 100 100" style="opacity: 0.3; margin-bottom: 30px;">
                                <path d="M20 30 L30 20 L70 20 L80 30 L80 80 L20 80 Z" fill="none" stroke="#FF3600" stroke-width="2"/>
                                <line x1="30" y1="35" x2="70" y2="35" stroke="#FF3600" stroke-width="2"/>
                                <line x1="35" y1="45" x2="65" y2="75" stroke="#FF3600" stroke-width="2"/>
                                <line x1="65" y1="45" x2="35" y2="75" stroke="#FF3600" stroke-width="2"/>
                            </svg>
                            <h3 style="font-size: 28px; margin-bottom: 15px; color: var(--color-heading-1);">Your cart is empty</h3>
                            <p style="font-size: 16px; color: var(--color-body); margin-bottom: 30px;">Browse our shop and add products to your cart</p>
                            <a asp-controller="Shop" asp-action="Index" class="rts-btn btn-primary">Continue Shopping</a>
                        </div>
                    }
                    else
                    {
                        <div class="ms-woocommerce-cart-form-wrapper">
                            <table class="shop_table shop_table_responsive cart woocommerce-cart-form__contents">
                                <thead>
                                    <tr>
                                        <th class="product-remove">&nbsp;</th>
                                        <th class="product-thumbnail">&nbsp;</th>
                                        <th class="product-name">Product</th>
                                        <th class="product-price">Price</th>
                                        <th class="product-quantity">Quantity</th>
                                        <th class="product-subtotal">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr class="woocommerce-cart-form__cart-item cart_item" data-product-id="@item.ProductId">
                                            <td class="product-remove">
                                                <a href="#" class="remove remove-item" data-product-id="@item.ProductId" aria-label="Remove this item">
                                                    <svg viewBox="0 0 200 200" width="18" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M114,100l49-49a9.9,9.9,0,0,0-14-14L100,86,51,37A9.9,9.9,0,0,0,37,51l49,49L37,149a9.9,9.9,0,0,0,14,14l49-49,49,49a9.9,9.9,0,0,0,14-14Z"></path>
                                                    </svg>
                                                </a>
                                            </td>
                                            <td class="product-thumbnail">
                                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">
                                                    <img src="@Url.Content(item.ImagePath)" class="attachment-woocommerce_thumbnail size-woocommerce_thumbnail" alt="@item.ProductName">
                                                </a>
                                            </td>
                                            <td class="product-name" data-title="Product">
                                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">@item.ProductName</a>
                                            </td>
                                            <td class="product-price" data-title="Price">
                                                <span class="woocommerce-Price-amount amount">
                                                    <bdi><span class="woocommerce-Price-currencySymbol">$</span><span class="item-price">@item.Price.ToString("0.00")</span></bdi>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="cart-edit">
                                                    <div class="quantity-edit">
                                                        <button class="button quantity-minus" data-product-id="@item.ProductId"><i class="fal fa-minus minus"></i></button>
                                                        <input type="text" class="input quantity-input" value="@item.Quantity" data-product-id="@item.ProductId" readonly>
                                                        <button class="button plus quantity-plus" data-product-id="@item.ProductId">+<i class="fal fa-plus plus"></i></button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="product-subtotal" data-title="Subtotal">
                                                <span class="woocommerce-Price-amount amount item-subtotal-display">
                                                    <bdi><span class="woocommerce-Price-currencySymbol">$</span><span class="item-subtotal">@item.Subtotal.ToString("0.00")</span></bdi>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                    <tr>
                                        <td colspan="6" class="actions">
                                            <div class="ms-actions-inner">
                                                <div class="coupon">
                                                    <input type="text" name="coupon_code" class="input-text" id="coupon_code" value="@Model.CouponCode" placeholder="Coupon code">
                                                    <button type="button" class="button rts-btn btn-primary" id="apply-coupon-btn">Apply coupon</button>
                                                    @if (!string.IsNullOrWhiteSpace(Model.CouponCode))
                                                    {
                                                        <button type="button" class="button rts-btn btn-primary" id="remove-coupon-btn" style="margin-left:8px;background:#1f1f1f;">Remove</button>
                                                    }
                                                    <span id="coupon-message" style="margin-left: 15px; font-weight: 500;"></span>
                                                </div>
                                                <p class="small text-muted mt-2 mb-0">Coupons preview a store courtesy discount. They are not permanently used until an order is completed. Online checkout is not available — contact the store to finish your purchase.</p>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="row">
                                <div class="col-md-5 offset-md-7">
                                    <div class="ms-cart-collaterals cart-collaterals">
                                        <div class="ms-cart-totals cart_totals ">
                                            <h3>Inquiry totals</h3>
                                            <table class="shop_table shop_table_responsive">
                                                <tbody>
                                                    <tr class="cart-subtotal">
                                                        <th>Subtotal</th>
                                                        <td data-title="Subtotal">
                                                            <span class="woocommerce-Price-amount amount">
                                                                <bdi><span class="woocommerce-Price-currencySymbol">$</span><span id="cart-subtotal">@Model.Subtotal.ToString("0.00")</span></bdi>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    @if (Model.DiscountAmount > 0)
                                                    {
                                                        <tr class="cart-discount">
                                                            <th>Discount (@Model.CouponCode)</th>
                                                            <td data-title="Discount">
                                                                <span class="woocommerce-Price-amount amount" style="color: #28a745;">
                                                                    <bdi>-<span class="woocommerce-Price-currencySymbol">$</span><span id="cart-discount">@Model.DiscountAmount.ToString("0.00")</span></bdi>
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    }
                                                    <tr class="order-total">
                                                        <th>Total</th>
                                                        <td data-title="Total">
                                                            <strong><span class="woocommerce-Price-amount amount">
                                                                <bdi><span class="woocommerce-Price-currencySymbol">$</span><span id="cart-total">@Model.Total.ToString("0.00")</span></bdi></span>
                                                            </strong>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <div class="ms-proceed-to-checkout wc-proceed-to-checkout">
                                                <a asp-controller="Contact" asp-action="Index" class="rts-btn btn-primary">Contact the Store</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="clearfix"></div>
            </div>
        </article>
        <!--================= Cart Area End =================-->
    </div>
</main>

@section Scripts {
<script>
    $(document).ready(function() {
        // Quantity Plus
        $('.quantity-plus').on('click', function() {
            const productId = $(this).data('product-id');
            const input = $(`.quantity-input[data-product-id="${productId}"]`);
            const currentQty = parseInt(input.val());
            const newQty = currentQty + 1;
            
            updateQuantity(productId, newQty);
        });
        
        // Quantity Minus
        $('.quantity-minus').on('click', function() {
            const productId = $(this).data('product-id');
            const input = $(`.quantity-input[data-product-id="${productId}"]`);
            const currentQty = parseInt(input.val());
            
            if (currentQty > 1) {
                const newQty = currentQty - 1;
                updateQuantity(productId, newQty);
            }
        });
        
        // Update Quantity AJAX
        function updateQuantity(productId, quantity) {
            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Shop")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ productId: productId, quantity: quantity }),
                success: function(response) {
                    if (response.success) {
                        // Update UI
                        $(`.quantity-input[data-product-id="${productId}"]`).val(quantity);
                        $(`.cart_item[data-product-id="${productId}"] .item-subtotal`).text(response.itemSubtotal.toFixed(2));
                        $('#cart-subtotal').text(response.cartSubtotal.toFixed(2));
                        $('#cart-total').text(response.cartTotal.toFixed(2));
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('Error updating quantity');
                }
            });
        }
        
        // Remove Item
        $('.remove-item').on('click', function(e) {
            e.preventDefault();
            const productId = $(this).data('product-id');
            
            if (confirm('Are you sure you want to remove this item?')) {
                $.ajax({
                    url: '@Url.Action("RemoveItem", "Shop")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(productId),
                    success: function(response) {
                        if (response.success) {
                            // Remove row
                            $(`.cart_item[data-product-id="${productId}"]`).fadeOut(300, function() {
                                $(this).remove();
                                
                                // Update totals
                                $('#cart-subtotal').text(response.cartSubtotal.toFixed(2));
                                $('#cart-total').text(response.cartTotal.toFixed(2));
                                
                                // If cart is empty, reload page to show empty message
                                if (response.isEmpty) {
                                    location.reload();
                                }
                            });
                        }
                    },
                    error: function() {
                        alert('Error removing item');
                    }
                });
            }
        });
        
        // Apply Coupon
        $('#apply-coupon-btn').on('click', function() {
            const couponCode = $('#coupon_code').val().trim();
            
            if (!couponCode) {
                $('#coupon-message').text('Please enter a coupon code').css('color', '#dc3545');
                return;
            }
            
            $.ajax({
                url: '@Url.Action("ApplyCoupon", "Shop")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ couponCode: couponCode }),
                success: function(response) {
                    if (response.success) {
                        $('#coupon-message').text(response.message).css('color', '#28a745');
                        
                        // Update totals
                        $('#cart-total').text(response.newTotal.toFixed(2));
                        
                        // Reload page to show discount row
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    } else {
                        $('#coupon-message').text(response.message).css('color', '#dc3545');
                    }
                },
                error: function() {
                    $('#coupon-message').text('Error applying coupon').css('color', '#dc3545');
                }
            });
        });

        $('#remove-coupon-btn').on('click', function() {
            $.ajax({
                url: '@Url.Action("RemoveCoupon", "Shop")',
                type: 'POST',
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        $('#coupon-message').text(response.message || 'Could not remove coupon').css('color', '#dc3545');
                    }
                },
                error: function() {
                    $('#coupon-message').text('Error removing coupon').css('color', '#dc3545');
                }
            });
        });
    });
</script>
}
