@{
    ViewData["Title"] = "Shop Two - AutoVault";
}

<!-- Content based on shop-2.html -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Shop Two</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Shop</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-section-gap">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-3">
                <!-- Sidebar would go here based on shop-2.html -->
                <div class="shop-sidebar">
                    <h4>Filter Products</h4>
                    <div class="filter-section">
                        <h5>Categories</h5>
                        <ul>
                            <li><a href="#">Car Parts</a></li>
                            <li><a href="#">Accessories</a></li>
                            <li><a href="#">Tools</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="row g-5">
                    <div class="col-lg-4">
                        <div class="shop-wrapper">
                            <div class="image-area">
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="1"><img src="~/assets/images/shop/01.webp" alt=""></a>
                            </div>
                            <div class="content-area">
                                <h5 class="title"><a asp-controller="Shop" asp-action="Details" asp-route-id="1">Premium Car Part</a></h5>
                                <div class="price-area">
                                    <span class="current-price">$89.99</span>
                                </div>
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="1" class="rts-btn btn-primary">Add to Cart</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>