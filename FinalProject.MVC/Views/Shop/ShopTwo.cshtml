@model FinalProject.MVC.Models.ShopFilterResponse
@{
    ViewData["Title"] = "Shop Two - AutoVault";
}

<!-- Breadcrumb area start -->
<div class="rts-breadcrumb-area portfolio jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Shop</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Shop</a>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb area end -->

<div class="rts-shop-area inner two rts-section-gapTop">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-2">
                <div class="sticky-top">
                    <div class="left-side-bar">
                        <!-- Search Area -->
                        <div class="search-area side-box">
                            <h2>Cars Search</h2>
                            <form action="#">
                                <div class="input-wrapper">
                                    <input type="text" placeholder="Search Vehicles" required>
                                    <button type="submit"><i class="fa-regular fa-magnifying-glass"></i></button>
                                </div>
                            </form>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                        
                        <!-- Car Make -->
                        <div class="car-make side-box">
                            <h2>Car Make</h2>
                            <ul class="checkbox-list">
                                @foreach (var make in (Dictionary<string, int>)ViewBag.MakeCounts)
                                {
                                    <li class="checkbox-item">
                                        <label class="checkbox-label">
                                            <input type="checkbox" data-filter="make" data-value="@make.Key" />
                                            <span>@make.Key</span>
                                        </label>
                                        <span>(@make.Value)</span>
                                    </li>
                                }
                            </ul>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                        
                        <!-- Car Model -->
                        <div class="car-make side-box">
                            <h2>Car Model</h2>
                            <ul class="checkbox-list">
                                @foreach (var carModel in (Dictionary<string, int>)ViewBag.ModelCounts)
                                {
                                    <li class="checkbox-item">
                                        <label class="checkbox-label">
                                            <input type="checkbox" data-filter="model" data-value="@carModel.Key" />
                                            <span>@carModel.Key</span>
                                        </label>
                                        <span>(@carModel.Value)</span>
                                    </li>
                                }
                            </ul>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                        
                        <!-- Price Slider -->
                        <div class="price-box side-box">
                            <h2>Price</h2>
                            <div class="slider-container">
                                <!-- Histogram -->
                                <div class="histogram">
                                    <div class="histogram-bar" style="height: 67px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 52px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 99px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 99px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 98px;"></div>
                                    <div class="histogram-bar" style="height: 86px;"></div>
                                    <div class="histogram-bar" style="height: 107px;"></div>
                                    <div class="histogram-bar" style="height: 75px;"></div>
                                    <div class="histogram-bar" style="height: 93px;"></div>
                                </div>
                                
                                <!-- Slider -->
                                <div class="slider" id="price-slider"></div>
                                
                                <!-- Labels -->
                                <div class="slider-labels">
                                    <span class="label-min">$0</span>
                                    <span class="label-max">$1000</span>
                                </div>
                            </div>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                        
                        <!-- Categories from SQL ShopProducts -->
                        <div class="tag-area side-box">
                            <h2>Categories</h2>
                            <ul>
                                @foreach (var category in ViewBag.Categories as IEnumerable<string> ?? Enumerable.Empty<string>())
                                {
                                    <li><a href="#" data-category="@category">@category</a></li>
                                }
                            </ul>
                            <span class="cross"><i class="fa-light fa-xmark"></i></span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-10">
                <div class="right">
                    <div class="row g-5" id="products-container-shop2">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-lg-4 col-md-6">
                                <div class="project-wrapper4">
                                    <div class="image-area">
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">
                                            <img src="@Url.Content(product.ImagePath)" alt="@product.Name">
                                        </a>
                                    </div>
                                    <div class="content-area">
                                        <ul class="star-rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Floor(product.Rating))
                                                {
                                                    <li><i class="rt-icon-star"></i></li>
                                                }
                                                else if (i <= product.Rating)
                                                {
                                                    <li><i class="rt-icon-star-sharp-half-stroke"></i></li>
                                                }
                                                else
                                                {
                                                    <li><i class="rt-icon-star" style="color: #ddd;"></i></li>
                                                }
                                            }
                                        </ul>
                                        <small class="product-rating-summary">
                                            @(product.RatingCount == 0
                                                ? "No ratings"
                                                : $"{product.Rating:0.0} ({product.RatingCount})")
                                        </small>
                                        <h6 class="title">
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                        </h6>
                                        <div class="button-area">
                                            <p class="">$@product.Price</p>
                                            <a href="/Shop/Details/@product.Id#ask-showroom" class="rts-btn btn-primary radius-big">Ask About Product</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    @if (Model.HasMorePages)
                    {
                        <div class="load-more-container" style="text-align: center; margin-top: 50px;">
                            <a href="#" class="rts-btn load-more-btn btn-border" id="load-more-btn-shop2">Load More</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        let currentPage = @Model.CurrentPage;
        let selectedMakes = [];
        let selectedModels = [];
        let selectedCategory = '';
        let searchText = '';
        let priceRange = { min: 0, max: 3000 };
        
        // Initialize price slider (using noUiSlider if available, or simple tracking)
        let priceSlider = document.getElementById('price-slider');
        if (typeof noUiSlider !== 'undefined' && priceSlider) {
            noUiSlider.create(priceSlider, {
                start: [0, 3000],
                connect: true,
                range: {
                    'min': 0,
                    'max': 3000
                },
                step: 50
            });
            
            priceSlider.noUiSlider.on('change', function(values) {
                priceRange.min = Math.round(values[0]);
                priceRange.max = Math.round(values[1]);
                $('.label-min').text('$' + priceRange.min);
                $('.label-max').text('$' + priceRange.max);
                applyFilters();
            });
        }
        
        // Function to apply REAL combined filters
        function applyFilters() {
            const filterData = {
                searchText: searchText,
                category: selectedCategory,
                minPrice: priceRange.min,
                maxPrice: priceRange.max,
                selectedMakes: selectedMakes,
                selectedModels: selectedModels,
                page: 1,
                pageSize: 12
            };

            $.ajax({
                url: '@Url.Action("FilterProducts", "Shop")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filterData),
                success: function(response) {
                    updateProductsContainer(response, false);
                    currentPage = response.currentPage;
                    
                    // Update results text
                    if (response.resultsText) {
                        console.log(response.resultsText);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Filter error:', error);
                }
            });
        }

        // Function to update products container
        function updateProductsContainer(response, append = false) {
            let html = '';
            
            if (response.products.length === 0) {
                html = '<div class="col-12"><p class="text-center" style="padding: 50px 0; font-size: 18px;">No products found matching your filters.</p></div>';
                $('#products-container-shop2').html(html);
                $('.load-more-container').hide();
                return;
            }
            
            response.products.forEach(function(product) {
                html += generateProductHtml(product);
            });
            
            if (append) {
                $('#products-container-shop2').append(html);
            } else {
                $('#products-container-shop2').html(html);
            }
            
            // Update Load More button
            if (response.hasMorePages) {
                $('.load-more-container').show();
            } else {
                $('.load-more-container').hide();
            }
        }

        // Function to generate product HTML
        function generateProductHtml(product) {
            let starsHtml = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= Math.floor(product.rating)) {
                    starsHtml += '<li><i class="rt-icon-star"></i></li>';
                } else if (i <= product.rating) {
                    starsHtml += '<li><i class="rt-icon-star-sharp-half-stroke"></i></li>';
                } else {
                    starsHtml += '<li><i class="rt-icon-star" style="color: #ddd;"></i></li>';
                }
            }
            const ratingSummary = product.ratingCount === 0
                ? 'No ratings'
                : Number(product.rating).toFixed(1) + ' (' + product.ratingCount + ')';

            // Convert ~ path to relative path
            let imagePath = product.imagePath;
            if (imagePath.startsWith('~/')) {
                imagePath = imagePath.substring(1);
            }

            return `
                <div class="col-lg-4 col-md-6">
                    <div class="project-wrapper4">
                        <div class="image-area">
                            <a href="/Shop/Details/${product.id}">
                                <img src="${imagePath}" alt="${product.name}">
                            </a>
                        </div>
                        <div class="content-area">
                            <ul class="star-rating">
                                ${starsHtml}
                            </ul>
                            <small class="product-rating-summary">${ratingSummary}</small>
                            <h6 class="title">
                                <a href="/Shop/Details/${product.id}">${product.name}</a>
                            </h6>
                            <div class="button-area">
                                <p class="">${product.hasOffer
                                    ? `<s>$${Number(product.price).toFixed(2)}</s> <strong>$${Number(product.salePrice).toFixed(2)}</strong> <span class="badge">${Number(product.discountPercent)}% OFF</span>${product.offerEndLabel ? ` <span class="av-card__offer-end">Ends ${product.offerEndLabel}</span>` : ''}`
                                    : `$${Number(product.price).toFixed(2)}`}</p>
                                <a href="/Shop/Details/${product.id}#ask-showroom" class="rts-btn btn-primary radius-big">Ask About Product</a>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Search input handler
        $('.search-area input[type="text"]').on('input', function() {
            searchText = $(this).val().trim();
        });
        
        $('.search-area button[type="submit"]').on('click', function(e) {
            e.preventDefault();
            applyFilters();
        });
        
        // Clear search
        $('.search-area .cross').on('click', function() {
            searchText = '';
            $('.search-area input[type="text"]').val('');
            applyFilters();
        });

        // Car Make checkboxes - MULTI-SELECT
        $('input[data-filter="make"]').on('change', function() {
            const value = $(this).data('value');
            if (this.checked) {
                if (!selectedMakes.includes(value)) {
                    selectedMakes.push(value);
                }
            } else {
                selectedMakes = selectedMakes.filter(m => m !== value);
            }
            applyFilters();
        });

        // Car Model checkboxes - MULTI-SELECT
        $('input[data-filter="model"]').on('change', function() {
            const value = $(this).data('value');
            if (this.checked) {
                if (!selectedModels.includes(value)) {
                    selectedModels.push(value);
                }
            } else {
                selectedModels = selectedModels.filter(m => m !== value);
            }
            applyFilters();
        });

        // Category filter
        $('.tag-area a').on('click', function(e) {
            e.preventDefault();
            const category = $(this).data('category');
            
            // Toggle category
            if (selectedCategory === category) {
                selectedCategory = '';
                $(this).removeClass('active');
            } else {
                $('.tag-area a').removeClass('active');
                selectedCategory = category;
                $(this).addClass('active');
            }
            
            applyFilters();
        });

        // Load More with current filters
        $(document).on('click', '#load-more-btn-shop2', function(e) {
            e.preventDefault();
            
            const filterData = {
                searchText: searchText,
                category: selectedCategory,
                minPrice: priceRange.min,
                maxPrice: priceRange.max,
                selectedMakes: selectedMakes,
                selectedModels: selectedModels,
                page: currentPage + 1,
                pageSize: 12
            };
            
            $.ajax({
                url: '@Url.Action("FilterProducts", "Shop")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filterData),
                success: function(response) {
                    updateProductsContainer(response, true);
                    currentPage = response.currentPage;
                },
                error: function(xhr, status, error) {
                    console.error('Load more error:', error);
                }
            });
        });

        // Add to Inquiry List functionality
        $(document).on('click', '.add-to-cart-btn', function(e) {
            e.preventDefault();
            window.location = '/Shop/Details/' + $(this).data('product-id') + '#ask-showroom';
            return;
            
            const productId = $(this).data('product-id');
            const button = $(this);
            const originalText = button.html();
            
            // Disable button and show loading state
            button.prop('disabled', true).html('Adding...');
            
            $.ajax({
                url: '@Url.Action("AddToCart", "Shop")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ productId: productId, quantity: 1 }),
                success: function(response) {
                    if (response.success) {
                        // Show success feedback
                        button.html('âœ“ Added!');
                        setTimeout(function() {
                            button.html(originalText).prop('disabled', false);
                        }, 1500);
                        
                        // Optional: Show notification
                        if (typeof toastr !== 'undefined') {
                            toastr.success('Product added to cart!');
                        }
                    } else {
                        button.html(originalText).prop('disabled', false);
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    button.html(originalText).prop('disabled', false);
                    alert('Failed to add product to cart. Please try again.');
                }
            });
        });
    });
</script>
}
