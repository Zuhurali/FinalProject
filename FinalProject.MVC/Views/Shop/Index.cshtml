@model FinalProject.MVC.Models.ShopFilterResponse
@{
    ViewData["Title"] = "Shop - AutoVault";
}

<!-- Breadcrumb area start -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Shop</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Shop</a>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb area end -->

<div class="rts-shop-area inner rts-section-gapTop">
    <div class="container">
        <p class="mb-4">The shop lists photographed automotive parts and workshop supplies for collection at the Baku showroom. Engine oils, filters, brake parts, plugs, wipers, and fluids can be added by the showroom when a matching product photo is on file. Fitment is shown only when it is stored for that product.</p>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <div class="shop-filter-area showroom-filters">
            <p id="results-text" class="results-text">@Model.ResultsText</p>
            <div class="select-area">
                <input type="search" id="searchText" class="form-control showroom-search-input" value="@ViewData["Search"]" placeholder="Search parts" aria-label="Search parts" />
                <form class="filter-form">
                    <select name="category" id="category" class="mySelect">
                        <option value="">All categories</option>
                        @foreach (var category in (IEnumerable<string>)ViewBag.Categories)
                        {
                            if (string.Equals(category, ViewData["Category"] as string, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@category" selected>@category</option>
                            }
                            else
                            {
                                <option value="@category">@category</option>
                            }
                        }
                    </select>
                </form>
                <form class="filter-form">
                    <select name="priceRange" id="priceRange" class="mySelect">
                        <option value="">Price</option>
                        <option value="Under $200">Under $200</option>
                        <option value="Under $400">Under $400</option>
                        <option value="Under $600">Under $600</option>
                        <option value="Under $800">Under $800</option>
                        <option value="All Prices">All Prices</option>
                    </select>
                </form>
                <form class="filter-form">
                    <select name="sortBy" id="sortBy" class="mySelect">
                        <option value="">Sort By</option>
                        <option value="Price Low to High">Price Low to High</option>
                        <option value="Price High to Low">Price High to Low</option>
                        <option value="Name A-Z">Name A-Z</option>
                        <option value="Name Z-A">Name Z-A</option>
                        <option value="Rating">Rating</option>
                    </select>
                </form>
                <button type="button" class="rts-btn btn-primary radius-big" id="apply-search">Search</button>
            </div>
        </div>
        <div class="row g-5" id="products-container">
            @foreach (var product in Model.Products)
            {
                <div class="col-lg-4 col-md-6 d-flex">
                    <div class="project-wrapper4 showroom-card">
                        <div class="image-area">
                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">
                                <img src="@Url.Content(product.ImagePath)" alt="@product.Name">
                            </a>
                        </div>
                        <div class="content-area">
                            <ul class="star-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Floor(product.Rating))
                                    {
                                        <li><i class="rt-icon-star"></i></li>
                                    }
                                    else if (i <= product.Rating)
                                    {
                                        <li><i class="rt-icon-star-sharp-half-stroke"></i></li>
                                    }
                                    else
                                    {
                                        <li><i class="rt-icon-star" style="color: #ddd;"></i></li>
                                    }
                                }
                            </ul>
                            <p class="product-rating-summary">
                                @(product.RatingCount == 0
                                    ? "No ratings"
                                    : $"{product.Rating:0.0} ({product.RatingCount} reviews)")
                            </p>
                            <h6 class="title">
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                            </h6>
                            <p class="stock-line">@product.StockStatus · @product.Quantity available</p>
                            <div class="button-area">
                                <p class="price-line">
                                    @if (product.HasOffer)
                                    {
                                        <span style="text-decoration:line-through;color:#888;font-weight:500;">$@product.Price</span>
                                        <span>$@product.SalePrice</span>
                                    }
                                    else
                                    {
                                        <span>$@product.Price</span>
                                    }
                                </p>
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" asp-fragment="ask-showroom" class="rts-btn btn-primary radius-big">Ask About Product</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.HasMorePages)
        {
            <div class="load-more-container" style="text-align: center; margin-top: 50px;">
                <a href="#" class="rts-btn load-more-btn btn-border" id="load-more-btn">Load More</a>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        let currentPage = @Model.CurrentPage;
        let isFiltering = @((!string.IsNullOrWhiteSpace(ViewData["Search"] as string) || !string.IsNullOrWhiteSpace(ViewData["Category"] as string)).ToString().ToLower());

        function filterPayload(page) {
            return {
                searchText: $('#searchText').val(),
                category: $('#category').val(),
                priceRange: $('#priceRange').val(),
                sortBy: $('#sortBy').val(),
                page: page,
                pageSize: 6
            };
        }

        function applyFilters() {
            isFiltering = true;
            currentPage = 1;
            $.ajax({
                url: '@Url.Action("FilterProducts", "Shop")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filterPayload(currentPage)),
                success: function(response) {
                    updateProductsContainer(response, false);
                    updateResultsText(response.resultsText);
                    updateLoadMoreButton(response.hasMorePages);
                    currentPage = response.currentPage;
                },
                error: function(xhr, status, error) {
                    console.error('Filter error:', error);
                }
            });
        }

        function loadMoreProducts() {
            if (isFiltering) {
                $.ajax({
                    url: '@Url.Action("FilterProducts", "Shop")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(filterPayload(currentPage + 1)),
                    success: function(response) {
                        updateProductsContainer(response, true);
                        if (response.resultsText) updateResultsText(response.resultsText);
                        updateLoadMoreButton(response.hasMorePages);
                        currentPage = response.currentPage;
                    },
                    error: function(xhr, status, error) {
                        console.error('Load more error:', error);
                    }
                });
            } else {
                $.ajax({
                    url: '@Url.Action("LoadMore", "Shop")',
                    type: 'POST',
                    data: { page: currentPage + 1, pageSize: 6 },
                    success: function(response) {
                        updateProductsContainer(response, true);
                        if (response.resultsText) updateResultsText(response.resultsText);
                        updateLoadMoreButton(response.hasMorePages);
                        currentPage = response.currentPage;
                    },
                    error: function(xhr, status, error) {
                        console.error('Load more error:', error);
                    }
                });
            }
        }

        // Function to update products container
        function updateProductsContainer(response, append = false) {
            let html = '';
            response.products.forEach(function(product) {
                html += generateProductHtml(product);
            });
            
            if (append) {
                $('#products-container').append(html);
            } else {
                $('#products-container').html(html);
            }
        }

        // Function to generate product HTML
        function generateProductHtml(product) {
            let starsHtml = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= Math.floor(product.rating)) {
                    starsHtml += '<li><i class="rt-icon-star"></i></li>';
                } else if (i <= product.rating) {
                    starsHtml += '<li><i class="rt-icon-star-sharp-half-stroke"></i></li>';
                } else {
                    starsHtml += '<li><i class="rt-icon-star" style="color: #ddd;"></i></li>';
                }
            }
            const ratingSummary = product.ratingCount === 0
                ? 'No ratings'
                : Number(product.rating).toFixed(1) + ' (' + product.ratingCount + ' reviews)';

            // Convert ~ path to relative path for client-side use
            let imagePath = product.imagePath;
            if (imagePath.startsWith('~/')) {
                imagePath = imagePath.substring(1); // Remove the ~ and keep /assets/...
            }

            return `
                <div class="col-lg-4 col-md-6 d-flex">
                    <div class="project-wrapper4 showroom-card">
                        <div class="image-area">
                            <a href="/Shop/Details/${product.id}"><img src="${imagePath}" alt="${product.name}"></a>
                        </div>
                        <div class="content-area">
                            <ul class="star-rating">${starsHtml}</ul>
                            <p class="product-rating-summary">${ratingSummary}</p>
                            <h6 class="title"><a href="/Shop/Details/${product.id}">${product.name}</a></h6>
                            <p class="stock-line">${product.stockStatus} · ${product.quantity} available</p>
                            <div class="button-area">
                                <p class="price-line">${product.hasOffer ? '<span style="text-decoration:line-through;color:#888;font-weight:500;">$' + product.price + '</span> $' + product.salePrice : '$' + product.price}</p>
                                <a href="/Shop/Details/${product.id}#ask-showroom" class="rts-btn btn-primary radius-big">Ask About Product</a>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Function to update results text
        function updateResultsText(text) {
            $('#results-text').text(text);
        }

        // Function to update load more button
        function updateLoadMoreButton(hasMorePages) {
            if (hasMorePages) {
                $('.load-more-container').show();
            } else {
                $('.load-more-container').hide();
            }
        }

        // Event handlers for filters
        $('#category, #priceRange, #sortBy').on('change', function() {
            applyFilters();
        });
        $('#apply-search').on('click', function() {
            applyFilters();
        });
        $('#searchText').on('keydown', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                applyFilters();
            }
        });

        // Event handler for Load More button
        $(document).on('click', '#load-more-btn', function(e) {
            e.preventDefault();
            loadMoreProducts();
        });
    });
</script>
}