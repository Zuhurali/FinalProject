@{
    ViewData["Title"] = "Shop - AutoVault";
}

<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Shop</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Shop</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-section-gap">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-4">
                <div class="shop-wrapper">
                    <div class="image-area">
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="1"><img src="~/assets/images/shop/01.webp" alt=""></a>
                    </div>
                    <div class="content-area">
                        <h5 class="title"><a asp-controller="Shop" asp-action="Details" asp-route-id="1">Car Accessories</a></h5>
                        <div class="price-area">
                            <span class="current-price">$89.99</span>
                        </div>
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="1" class="rts-btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="shop-wrapper">
                    <div class="image-area">
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="2"><img src="~/assets/images/shop/02.webp" alt=""></a>
                    </div>
                    <div class="content-area">
                        <h5 class="title"><a asp-controller="Shop" asp-action="Details" asp-route-id="2">Premium Car Parts</a></h5>
                        <div class="price-area">
                            <span class="current-price">$149.99</span>
                        </div>
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="2" class="rts-btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>