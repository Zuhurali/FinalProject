@model FinalProject.MVC.Models.ShopFilterResponse
@{
    ViewData["Title"] = "Shop - AutoVault";
}
<!-- Breadcrumb area start -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Shop</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Shop</a>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb area end -->

<div class="rts-shop-area inner rts-section-gapTop">
    <div class="container">
        <p class="mb-4">The shop lists photographed automotive parts and workshop supplies for collection at the Baku showroom. Engine oils, filters, brake parts, plugs, wipers, and fluids can be added by the showroom when a matching product photo is on file. Fitment is shown only when it is stored for that product.</p>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <div class="shop-filter-area showroom-filters">
            <p id="results-text" class="results-text">@Model.ResultsText</p>
            <div class="select-area">
                <input type="search" id="searchText" class="form-control showroom-search-input" value="@ViewData["Search"]" placeholder="Search parts" aria-label="Search parts" />
                <form class="filter-form">
                    <select name="category" id="category" class="mySelect">
                        <option value="">All categories</option>
                        @foreach (var category in (IEnumerable<string>)ViewBag.Categories)
                        {
                            if (string.Equals(category, ViewData["Category"] as string, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@category" selected>@category</option>
                            }
                            else
                            {
                                <option value="@category">@category</option>
                            }
                        }
                    </select>
                </form>
                <form class="filter-form">
                    <select name="priceRange" id="priceRange" class="mySelect">
                        <option value="">Price</option>
                        <option value="Under $200">Under $200</option>
                        <option value="Under $400">Under $400</option>
                        <option value="Under $600">Under $600</option>
                        <option value="Under $800">Under $800</option>
                        <option value="All Prices">All Prices</option>
                    </select>
                </form>
                <form class="filter-form">
                    <select name="sortBy" id="sortBy" class="mySelect">
                        <option value="">Sort By</option>
                        <option value="Price Low to High">Price Low to High</option>
                        <option value="Price High to Low">Price High to Low</option>
                        <option value="Name A-Z">Name A-Z</option>
                        <option value="Name Z-A">Name Z-A</option>
                        <option value="Rating">Rating</option>
                    </select>
                </form>
                <button type="button" class="rts-btn btn-primary radius-big" id="apply-search">Search</button>
            </div>
        </div>
        <div class="av-grid" id="products-container">
            @foreach (var product in Model.Products)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
        <p class="av-empty" id="products-empty" @(Model.TotalProducts == 0 ? "" : "hidden")>No parts match this search. Try another word or clear the filters.</p>
        <div class="load-more-container av-load-more" @(Model.HasMorePages ? "" : "hidden")>
            <button type="button" class="rts-btn btn-border radius-big" id="load-more-btn">Load more parts</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        const pageSize = @FinalProject.MVC.Controllers.ShopController.CatalogPageSize;
        const initialSearch = @Json.Serialize(ViewData["Search"] as string ?? "");
        const initialCategory = @Json.Serialize(ViewData["Category"] as string ?? "");
        let currentPage = @Model.CurrentPage;
        let isFiltering = false;

        function filterPayload(page) {
            return {
                searchText: $('#searchText').val(),
                category: $('#category').val(),
                priceRange: $('#priceRange').val(),
                sortBy: $('#sortBy').val(),
                page: page,
                pageSize: pageSize
            };
        }

        function applyFilters() {
            isFiltering = true;
            currentPage = 1;
            $.ajax({
                url: '@Url.Action("FilterProducts", "Shop")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filterPayload(currentPage)),
                success: function(response) {
                    updateProductsContainer(response, false);
                    updateResultsText(response.resultsText);
                    updateLoadMoreButton(response.hasMorePages);
                    currentPage = response.currentPage;
                },
                error: function(xhr, status, error) {
                    console.error('Filter error:', error);
                }
            });
        }

        function loadMoreProducts() {
            if (isFiltering) {
                $.ajax({
                    url: '@Url.Action("FilterProducts", "Shop")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(filterPayload(currentPage + 1)),
                    success: function(response) {
                        updateProductsContainer(response, true);
                        if (response.resultsText) updateResultsText(response.resultsText);
                        updateLoadMoreButton(response.hasMorePages);
                        currentPage = response.currentPage;
                    },
                    error: function(xhr, status, error) {
                        console.error('Load more error:', error);
                    }
                });
            } else {
                $.ajax({
                    url: '@Url.Action("LoadMore", "Shop")',
                    type: 'POST',
                    data: {
                        page: currentPage + 1,
                        pageSize: pageSize,
                        search: initialSearch,
                        category: initialCategory
                    },
                    success: function(response) {
                        updateProductsContainer(response, true);
                        if (response.resultsText) updateResultsText(response.resultsText);
                        updateLoadMoreButton(response.hasMorePages);
                        currentPage = response.currentPage;
                    },
                    error: function(xhr, status, error) {
                        console.error('Load more error:', error);
                    }
                });
            }
        }

        // Function to update products container
        function updateProductsContainer(response, append = false) {
            let html = '';
            response.products.forEach(function(product) {
                html += generateProductHtml(product);
            });
            
            if (append) {
                $('#products-container').append(html);
            } else {
                $('#products-container').html(html);
            }
            $('#products-empty').prop('hidden', response.totalProducts !== 0);
        }

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);
        }

        // Function to generate product HTML
        // Mirrors Views/Shared/_ProductCard.cshtml.
        function generateProductHtml(product) {
            const rating = Number(product.rating) || 0;
            let starsHtml = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= Math.floor(rating)) {
                    starsHtml += '<li><i class="rt-icon-star"></i></li>';
                } else if (i <= rating + 0.5) {
                    starsHtml += '<li><i class="rt-icon-star-sharp-half-stroke"></i></li>';
                } else {
                    starsHtml += '<li class="is-empty"><i class="rt-icon-star"></i></li>';
                }
            }
            const quantity = Number(product.quantity) || 0;
            const stockModifier = product.stockStatus === 'Out of Stock' ? 'out' : product.stockStatus === 'Low Stock' ? 'low' : 'in';
            const stockText = quantity <= 0
                ? 'Out of stock'
                : product.stockStatus === 'Low Stock' ? `Low stock · ${quantity} left` : `In stock · ${quantity} available`;
            const money = value => '$' + Number(value).toFixed(2);
            const ratingText = product.ratingCount === 0 ? 'No ratings yet' : `${rating.toFixed(1)} (${product.ratingCount})`;
            const ratingLabel = product.ratingCount === 0 ? 'No ratings yet' : `Rated ${rating.toFixed(1)} out of 5 from ${product.ratingCount} ratings`;
            const detailsUrl = '/Shop/Details/' + encodeURIComponent(product.id);
            const imagePath = String(product.imagePath || '').replace(/^~\//, '/');
            const badge = quantity <= 0
                ? '<span class="av-card__badge av-card__badge--out">Out of stock</span>'
                : product.hasOffer ? `<span class="av-card__badge av-card__badge--offer">${Number(product.discountPercent)}% off</span>` : '';
            const price = product.hasOffer
                ? `<s>${money(product.price)}</s> <span>${money(product.salePrice)}</span>`
                : `<span>${money(product.price)}</span>`;
            const cta = quantity > 0
                ? `<a class="av-card__cta" href="${detailsUrl}#request-to-buy">Request to Buy</a>`
                : `<a class="av-card__cta av-card__cta--ghost" href="${detailsUrl}">View details</a>`;

            return `
                <article class="av-card">
                    <a class="av-card__media" href="${detailsUrl}" tabindex="-1" aria-hidden="true">
                        <img src="${escapeHtml(imagePath)}" alt="" width="800" height="600" loading="lazy" decoding="async">
                        ${badge}
                    </a>
                    <div class="av-card__body">
                        <p class="av-card__category">${escapeHtml(product.category)}</p>
                        <h3 class="av-card__title"><a href="${detailsUrl}">${escapeHtml(product.name)}</a></h3>
                        <div class="av-card__rating" aria-label="${ratingLabel}">
                            <ul class="av-card__stars" aria-hidden="true">${starsHtml}</ul>
                            <span>${ratingText}</span>
                        </div>
                        <p class="av-card__stock av-card__stock--${stockModifier}">${stockText}</p>
                        <div class="av-card__footer">
                            <p class="av-card__price">${price}</p>
                            ${cta}
                        </div>
                    </div>
                </article>
            `;
        }

        // Function to update results text
        function updateResultsText(text) {
            $('#results-text').text(text);
        }

        // Function to update load more button
        function updateLoadMoreButton(hasMorePages) {
            $('.load-more-container').prop('hidden', !hasMorePages);
        }

        // Event handlers for filters
        $('#category, #priceRange, #sortBy').on('change', function() {
            applyFilters();
        });
        $('#apply-search').on('click', function() {
            applyFilters();
        });
        $('#searchText').on('keydown', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                applyFilters();
            }
        });

        // Event handler for Load More button
        $(document).on('click', '#load-more-btn', function(e) {
            e.preventDefault();
            loadMoreProducts();
        });
    });
</script>
}