@{
    ViewData["Title"] = "Calculator - AutoVault";
}

<!-- rts breadcrumb area start -->
<div class="rts-breadcrumb-area service calc jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Car Loan Calculator</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Calculator</a>
            </div>
        </div>
    </div>
</div>
<!-- rts breadcrumb area end -->

<!-- Calculator Area Start -->
<section class="rts-calculator-area rts-section-gap">
    <div class="container">
        <div class="calculator-form-inner">
            <h4 class="text-center mb--30">Car Loan Calculator</h4>
            <form id="carLoanCalculator" action="#">
                <div class="single-wrapper">
                    <span>
                        <select name="my_select" class="mySelect">
                            <option value="2" selected>Select A Car</option>
                            <option value="10">Mazda</option>
                            <option value="1">Citroen</option>
                            <option value="13">Honda</option>
                            <option value="14">Mitsubishi</option>
                            <option value="15">Peugeot</option>
                        </select>
                        <img src="~/assets/images/icon/car-03.svg" alt="">
                    </span>
                    <span>
                        <input type="text" placeholder="Vehicle Price" required>
                        <img src="~/assets/images/icon/car-03.svg" alt="">
                    </span>
                </div>
                <div class="single-wrapper">
                    <span>
                        <input type="text" placeholder="Down Payment" required>
                        <img src="~/assets/images/icon/car-03.svg" alt="">
                    </span>
                    <span>
                        <input type="text" placeholder="Interest Rate" required>
                        <img src="~/assets/images/icon/car-03.svg" alt="">
                    </span>
                </div>
                <div class="single-wrapper">
                    <span>
                        <select name="my_select" class="mySelect">
                            <option value="2" selected>Payment Type</option>
                            <option value="10">Paypal</option>
                            <option value="1">Payoneer</option>
                            <option value="13">Skrill</option>
                            <option value="14">Wise</option>
                        </select>
                        <img src="~/assets/images/icon/car-03.svg" alt="">
                    </span>
                </div>
                <div class="single-wrapper">
                    <button type="submit" class="rts-btn radius-small btn-primary mb--20">Calculate</button>
                </div>
                <div class="single-wrapper">
                    <span>
                        <input type="text" placeholder="Monthly Payment" readonly>
                        <img src="~/assets/images/icon/car-03.svg" alt="">
                    </span>
                    <span>
                        <input type="text" placeholder="Total Interest" readonly>
                        <img src="~/assets/images/icon/car-03.svg" alt="">
                    </span>
                    <span>
                        <input type="text" placeholder="Total Payments" readonly>
                        <img src="~/assets/images/icon/car-03.svg" alt="">
                    </span>
                </div>
            </form>
        </div>
    </div>
</section>
<!-- Calculator Area End -->

<!-- Counter Area Start -->
