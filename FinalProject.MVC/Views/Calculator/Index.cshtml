@model CarLoanCalculatorModel
@{
    var cms = ViewData["CalculatorPage"] as CalculatorPagePublicContent ?? CalculatorPage.Current;
    ViewData["Title"] = cms.SeoTitle;
    ViewData["MetaDescription"] = cms.SeoDescription;
}

@section Styles {
    <link rel="stylesheet" href="~/css/car-loan-calculator.css" asp-append-version="true">
}

<!-- rts breadcrumb area start -->
<div class="rts-breadcrumb-area service calc jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">@cms.PageTitle</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Dealership</a>
                <a href="#" class="current">@cms.BreadcrumbTitle</a>
            </div>
        </div>
    </div>
</div>
<!-- rts breadcrumb area end -->

<!-- Calculator Area Start -->
<section class="rts-calculator-area rts-section-gap av-loan-calculator-page">
    <div class="container">
        <div class="calculator-form-inner av-loan-calculator">
            <h4 class="text-center av-loan-title">@cms.PageTitle</h4>
            <p class="av-loan-intro text-center">@cms.IntroText</p>

            <form id="carLoanCalculator"
                  asp-controller="Calculator"
                  asp-action="Calculate"
                  method="post"
                  novalidate>
                @Html.AntiForgeryToken()

                <div id="loan-form-messages" class="av-loan-notice" role="status" aria-live="polite" hidden></div>

                <div class="single-wrapper av-loan-row">
                    <div class="av-loan-field">
                        <label class="av-loan-label" for="carMake">Car make</label>
                        <span class="av-loan-control">
                            <select id="carMake" name="carMake" class="mySelect" required>
                                <option value="">Select a car make</option>
                                <option value="Mazda">Mazda</option>
                                <option value="Citroen">Citroen</option>
                                <option value="Honda">Honda</option>
                                <option value="Mitsubishi">Mitsubishi</option>
                                <option value="Peugeot">Peugeot</option>
                                <option value="Other">Other</option>
                            </select>
                            <img src="~/assets/images/icon/car-03.svg" alt="">
                        </span>
                        <span class="av-loan-error" data-error-for="carMake" hidden></span>
                    </div>
                    <div class="av-loan-field">
                        <label class="av-loan-label" for="carPrice">Car price ($)</label>
                        <span class="av-loan-control">
                            <input type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   id="carPrice"
                                   name="carPrice"
                                   class="av-loan-input"
                                   value="@Model.CarPrice"
                                   placeholder="e.g. 30000"
                                   data-numeric="decimal"
                                   maxlength="12"
                                   required>
                            <img src="~/assets/images/icon/car-03.svg" alt="">
                        </span>
                        <span class="av-loan-error" data-error-for="carPrice" hidden></span>
                    </div>
                </div>

                <div class="single-wrapper av-loan-row">
                    <div class="av-loan-field">
                        <label class="av-loan-label" for="downPayment">Down payment ($)</label>
                        <span class="av-loan-control">
                            <input type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   id="downPayment"
                                   name="downPayment"
                                   class="av-loan-input"
                                   value="@Model.DownPayment"
                                   placeholder="e.g. 15000"
                                   data-numeric="decimal"
                                   maxlength="12"
                                   required>
                            <img src="~/assets/images/icon/car-03.svg" alt="">
                        </span>
                        <span class="av-loan-error" data-error-for="downPayment" hidden></span>
                    </div>
                    <div class="av-loan-field">
                        <label class="av-loan-label" for="loanTermMonths">Loan term (months)</label>
                        <span class="av-loan-control">
                            <input type="text"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   id="loanTermMonths"
                                   name="loanTermMonths"
                                   class="av-loan-input"
                                   value="@Model.LoanTermMonths"
                                   placeholder="e.g. 36"
                                   data-numeric="integer"
                                   maxlength="3"
                                   required>
                            <img src="~/assets/images/icon/car-03.svg" alt="">
                        </span>
                        <span class="av-loan-error" data-error-for="loanTermMonths" hidden></span>
                    </div>
                </div>

                <div class="single-wrapper av-loan-row">
                    <div class="av-loan-field">
                        <label class="av-loan-label" for="annualInterestRate">Annual interest rate</label>
                        <span class="av-loan-control av-loan-control--rate">
                            <input type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   id="annualInterestRate"
                                   name="annualInterestRate"
                                   class="av-loan-input av-loan-input--rate"
                                   value="@(Model.AnnualInterestRate ?? "8")"
                                   placeholder="e.g. 8"
                                   data-numeric="decimal"
                                   maxlength="8"
                                   aria-describedby="annualInterestRateHint"
                                   required>
                            <img src="~/assets/images/icon/car-03.svg" alt="">
                            <span class="av-loan-rate-suffix" aria-hidden="true">%</span>
                        </span>
                        <span id="annualInterestRateHint" class="av-loan-hint">Enter the yearly rate as a percentage (for example, 8 for 8%).</span>
                        <span class="av-loan-error" data-error-for="annualInterestRate" hidden></span>
                    </div>
                    <div class="av-loan-field av-loan-field--action">
                        <span class="av-loan-label av-loan-label--spacer" aria-hidden="true">&nbsp;</span>
                        <button type="submit" id="loanCalculateBtn" class="rts-btn radius-small btn-primary av-loan-submit">Calculate</button>
                    </div>
                </div>

                <div class="av-loan-results" id="loanResults" hidden>
                    <h5 class="av-loan-results-title">Your loan estimate</h5>
                    <div class="single-wrapper av-loan-row">
                        <div class="av-loan-field">
                            <label class="av-loan-label" for="loanPrincipal">Loan principal</label>
                            <span class="av-loan-control">
                                <input type="text" id="loanPrincipal" class="av-loan-input av-loan-output" readonly tabindex="-1">
                                <img src="~/assets/images/icon/car-03.svg" alt="">
                            </span>
                        </div>
                        <div class="av-loan-field">
                            <label class="av-loan-label" for="monthlyPayment">Monthly payment</label>
                            <span class="av-loan-control">
                                <input type="text" id="monthlyPayment" class="av-loan-input av-loan-output av-loan-output--emphasis" readonly tabindex="-1">
                                <img src="~/assets/images/icon/car-03.svg" alt="">
                            </span>
                        </div>
                    </div>
                    <div class="single-wrapper av-loan-row">
                        <div class="av-loan-field">
                            <label class="av-loan-label" for="totalLoanPayments">Total loan payments</label>
                            <span class="av-loan-control">
                                <input type="text" id="totalLoanPayments" class="av-loan-input av-loan-output" readonly tabindex="-1">
                                <img src="~/assets/images/icon/car-03.svg" alt="">
                            </span>
                        </div>
                        <div class="av-loan-field">
                            <label class="av-loan-label" for="totalInterest">Total interest paid</label>
                            <span class="av-loan-control">
                                <input type="text" id="totalInterest" class="av-loan-input av-loan-output" readonly tabindex="-1">
                                <img src="~/assets/images/icon/car-03.svg" alt="">
                            </span>
                        </div>
                    </div>
                    <div class="single-wrapper av-loan-row">
                        <div class="av-loan-field av-loan-field--full">
                            <label class="av-loan-label" for="totalCost">Total cost (including down payment)</label>
                            <span class="av-loan-control">
                                <input type="text" id="totalCost" class="av-loan-input av-loan-output av-loan-output--emphasis" readonly tabindex="-1">
                                <img src="~/assets/images/icon/car-03.svg" alt="">
                            </span>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
<!-- Calculator Area End -->

@{ ViewData["PartnerStripClass"] = "rts-brand-area rts-section-gapTop"; }
<partial name="_PartnerBrandStrip" />

<partial name="_DealershipCallCta" />

@section Scripts {
    <script src="~/js/plugins/car-loan-calculator.js" asp-append-version="true"></script>
}
