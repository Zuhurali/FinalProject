<partial name="_DealershipCallCta" />

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById("carLoanCalculator");
            if (!form) {
                return;
            }

            var months = 60;
            var priceInput = form.querySelector('input[placeholder="Vehicle Price"]');
            var downInput = form.querySelector('input[placeholder="Down Payment"]');
            var rateInput = form.querySelector('input[placeholder="Interest Rate"]');
            var monthlyInput = form.querySelector('input[placeholder="Monthly Payment"]');
            var interestInput = form.querySelector('input[placeholder="Total Interest"]');
            var totalInput = form.querySelector('input[placeholder="Total Payments"]');

            function parseAmount(value) {
                var number = parseFloat(String(value).replace(/[^0-9.]/g, ""));
                return isNaN(number) ? 0 : number;
            }

            function formatMoney(value) {
                return "$" + value.toLocaleString("en-US", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            form.addEventListener("submit", function (event) {
                event.preventDefault();

                var price = parseAmount(priceInput.value);
                var down = parseAmount(downInput.value);
                var annualRate = parseAmount(rateInput.value);
                var principal = Math.max(price - down, 0);
                var monthlyRate = annualRate / 100 / 12;
                var monthly;

                if (monthlyRate === 0) {
                    monthly = principal / months;
                } else {
                    var factor = Math.pow(1 + monthlyRate, months);
                    monthly = principal * monthlyRate * factor / (factor - 1);
                }

                var totalPayments = monthly * months;
                var totalInterest = totalPayments - principal;

                monthlyInput.value = formatMoney(monthly);
                interestInput.value = formatMoney(totalInterest);
                totalInput.value = formatMoney(totalPayments);
            });
        })();
    </script>
}
