@{
    ViewData["Title"] = "Calculator - AutoVault";
}
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Loan Calculator</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Calculator</a>
            </div>
        </div>
    </div>
</div>
<section class="rts-section-gap">
    <div class="container">
        <div class="calculator-form">
            <h3>Calculate Your Monthly Payment</h3>
            <form>
                <div class="form-group">
                    <label>Loan Amount</label>
                    <input type="number" class="form-control" placeholder="Enter loan amount">
                </div>
                <div class="form-group">
                    <label>Interest Rate (%)</label>
                    <input type="number" class="form-control" placeholder="Enter interest rate">
                </div>
                <div class="form-group">
                    <label>Loan Term (months)</label>
                    <input type="number" class="form-control" placeholder="Enter loan term">
                </div>
                <button type="button" class="rts-btn btn-primary">Calculate</button>
            </form>
        </div>
    </div>
</section>
