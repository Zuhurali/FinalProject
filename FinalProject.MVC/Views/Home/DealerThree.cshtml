@{
    ViewData["Title"] = "Dealer Three - AutoVault";
}

<!-- Content based on index-three.html -->
<!-- Banner area start -->
<section class="rts-banner-area bg_image_three jarallax">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="banner-area-one bg_image">
                    <div class="banner-content-area">
                        <div class="pre-title wow fadeInUp" data-wow-delay=".2s" data-wow-duration="1s">
                            <span>Premium Car Dealership</span>
                        </div>
                        <h1 class="title wow fadeInUp" data-wow-delay=".4s" data-wow-duration="1s">Experience 
                            Luxury Automotive
                            Excellence <span>Today</span></h1>
                        <div class="button-area wow fadeInUp" data-wow-delay=".8s" data-wow-duration="1s">
                            <a asp-controller="Cars" asp-action="CarsOne" class="rts-btn btn-primary radius-big">Browse Inventory</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Banner area end -->