@{
    ViewData["Title"] = "Dealer Three - AutoVault";
    var dealerCars = ViewData["DealerCars"] as IReadOnlyList<Car> ?? Array.Empty<Car>();
    Car? FindCar(string make, string model) => dealerCars.FirstOrDefault(car =>
        car.Make.Equals(make, StringComparison.OrdinalIgnoreCase)
        && car.Model.Equals(model, StringComparison.OrdinalIgnoreCase));
    List<Car> Prefer(IEnumerable<Car?> preferred, IEnumerable<Car> pool, int take)
    {
        var list = new List<Car>();
        foreach (var car in preferred)
        {
            if (car != null && list.All(item => item.Id != car.Id))
            {
                list.Add(car);
            }
        }

        foreach (var car in pool)
        {
            if (list.Count >= take)
            {
                break;
            }

            if (list.All(item => item.Id != car.Id))
            {
                list.Add(car);
            }
        }

        return list.Take(take).ToList();
    }
    IReadOnlyList<Car> BrandCars(string make, string preferredModel) 
    {
        var matches = dealerCars
            .Where(car => car.Make.Equals(make, StringComparison.OrdinalIgnoreCase))
            .OrderBy(car => car.Model)
            .ToList();
        var feature = matches.FirstOrDefault(car => car.Model.Equals(preferredModel, StringComparison.OrdinalIgnoreCase));
        if (feature == null)
        {
            return matches.Take(8).ToList();
        }

        return matches.Where(car => car.Id == feature.Id).Concat(matches.Where(car => car.Id != feature.Id)).Take(8).ToList();
    }
    var inventoryTabs = new (string Id, bool Active, IReadOnlyList<Car> Cars)[]
    {
        ("new-cars", true, Prefer(
            new Car?[] { FindCar("Porsche", "911 Cabriolet"), FindCar("Ford", "Mustang Convertible") },
            dealerCars.Where(car => car.IsNew).OrderByDescending(car => car.Year),
            6)),
        ("used", false, Prefer(
            new Car?[] { FindCar("Mercedes-Benz", "E-Class Cabriolet"), FindCar("Mazda", "MX-5"), FindCar("Honda", "Civic Type R"), FindCar("Hyundai", "Veloster") },
            dealerCars.Where(car => !car.IsNew).OrderByDescending(car => car.Year),
            6)),
        ("trending", false, dealerCars.OrderByDescending(car => car.Price).Take(6).ToList()),
        ("stocks", false, dealerCars.Where(car => car.InStock).OrderByDescending(car => car.CreatedAt).Take(6).ToList())
    };
    var brandTabs = new (string Id, string Make, string Preferred, bool Active, IReadOnlyList<Car> Cars)[]
    {
        ("bmw", "BMW", "M340i", true, BrandCars("BMW", "M340i")),
        ("mazda", "Mazda", "MX-5", false, BrandCars("Mazda", "MX-5")),
        ("honda", "Honda", "Civic Type R", false, BrandCars("Honda", "Civic Type R")),
        ("nissan", "Nissan", "GT-R", false, BrandCars("Nissan", "GT-R"))
    };
}
