@using System.Text.Json
@using FinalProject.MVC.Commerce
@{
    ViewData["Title"] = Site.Current.DefaultSeoTitle;
    ViewData["MetaDescription"] = Site.Current.DefaultMetaDescription;
    var home = HomePage.Current;
    var homeCategories = ViewData["HomeCategories"] as IReadOnlyList<HomeCategoryStripItem> ?? Array.Empty<HomeCategoryStripItem>();
    var searchMakes = ViewData["SearchMakes"] as IEnumerable<string> ?? Enumerable.Empty<string>();
    var modelsByMake = ViewData["ModelsByMake"] as IReadOnlyDictionary<string, string[]> ?? new Dictionary<string, string[]>();
    var homeCars = ViewData["HomeCars"] as IReadOnlyList<Car> ?? Array.Empty<Car>();
    var showcaseCars = HomeCarShowcase.ShowcaseCars(homeCars);
    var homeBrands = ViewData["HomeBrands"] as IEnumerable<BrandApiDto> ?? Enumerable.Empty<BrandApiDto>();
    var liveCampaigns = ViewData["LiveCampaigns"] as IReadOnlyList<ProductCampaign> ?? Array.Empty<ProductCampaign>();
    var newCars = HomeCarShowcase.NewCars(showcaseCars);
    var usedCars = HomeCarShowcase.HomeUsedCarousel(showcaseCars);
    var trendingCars = HomeCarShowcase.TrendingCars(showcaseCars);
    // Use the full Active home catalog (not catalog-path-only showcase) so IsFeatured cars appear.
    var featuredCars = HomeCarShowcase.PremiumCars(homeCars);
    BrandApiDto? MatchBrand(string name) =>
        homeBrands.FirstOrDefault(brand => string.Equals(brand.Name, name, StringComparison.OrdinalIgnoreCase));
    var partnerBrands = Partners.Items;
}

<style>
