@using System.Text.Json
@{
    ViewData["Title"] = "Home - AutoVault";
    var categoryLabels = ViewData["CategoryLabels"] as IReadOnlyDictionary<string, string>;
    var searchMakes = ViewData["SearchMakes"] as IEnumerable<string> ?? Enumerable.Empty<string>();
    var modelsByMake = ViewData["ModelsByMake"] as IReadOnlyDictionary<string, string[]> ?? new Dictionary<string, string[]>();
    var homeCars = ViewData["HomeCars"] as IReadOnlyList<Car> ?? Array.Empty<Car>();
    var showcaseCars = homeCars
        .Where(car => car.ImagePath.Contains("/assets/images/catalog/", StringComparison.OrdinalIgnoreCase))
        .GroupBy(car => car.Id)
        .Select(group => group.First())
        .ToList();
    var homeBrands = ViewData["HomeBrands"] as IEnumerable<BrandApiDto> ?? Enumerable.Empty<BrandApiDto>();
    var newCars = showcaseCars.Where(car => car.Badge == "New").ToList();
    var usedCars = showcaseCars.Where(car => car.Badge != "New").ToList();
    var trendingCars = showcaseCars.OrderByDescending(car => car.Year).ThenBy(car => car.Name).Take(6).ToList();
    var stockCars = showcaseCars.Where(car => car.InStock).ToList();
    var featuredCars = showcaseCars
        .OrderByDescending(car => car.Make.Contains("Mercedes", StringComparison.OrdinalIgnoreCase))
        .ThenByDescending(car => car.Year)
        .ThenBy(car => car.Name)
        .Take(6)
        .ToList();
    BrandApiDto? MatchBrand(string name) =>
        homeBrands.FirstOrDefault(brand => string.Equals(brand.Name, name, StringComparison.OrdinalIgnoreCase));
    string CategoryLabel(string name) =>
        categoryLabels != null && categoryLabels.TryGetValue(name, out var label) ? label : "—";
    var premiumBrands = new (string? Image, string Name, string Delay)[]
    {
        ("~/assets/images/brand/01-w.svg", "Jeep", ".2s"),
        ("~/assets/images/brand/02.svg", "Ford", ".4s"),
        (null, "Mazda", ".6s"),
        ("~/assets/images/brand/04.svg", "BMW", ".8s"),
        ("~/assets/images/brand/05.svg", "Honda", "1s"),
        ("~/assets/images/brand/06.svg", "Audi", "1.2s"),
        ("~/assets/images/brand/07.svg", "Nissan", "1.4s")
    };
}

