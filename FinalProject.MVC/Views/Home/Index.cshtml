@using System.Text.Json
@{
    ViewData["Title"] = "Home - AutoVault";
    var categoryLabels = ViewData["CategoryLabels"] as IReadOnlyDictionary<string, string>;
    var searchMakes = ViewData["SearchMakes"] as IEnumerable<string> ?? Enumerable.Empty<string>();
    var modelsByMake = ViewData["ModelsByMake"] as IReadOnlyDictionary<string, string[]> ?? new Dictionary<string, string[]>();
    string CategoryLabel(string name) =>
        categoryLabels != null && categoryLabels.TryGetValue(name, out var label) ? label : "—";
}

<style>
    .rts-banner-area .banner-area-one .banner-content-area .title {
        margin-bottom: 32px;
    }
    .hero-search-form {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 14px;
        width: min(1103px, 100%);
        margin: 0 auto;
    }
    .hero-search-form .select-area-down {
        width: 100%;
        max-width: none;
        margin: 0;
    }
    .hero-search-primary {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 64px;
        padding: 0 22px;
        background: #fff;
        border-radius: 40px;
        border: 1px solid rgba(97, 94, 252, 0.2);
    }
    .hero-search-primary svg {
        flex: 0 0 auto;
    }
    .hero-search-primary input {
        flex: 1 1 auto;
        min-width: 0;
        height: 48px;
        border: none;
        outline: none;
        background: transparent;
        color: var(--color-heading-1);
        font-size: 16px;
    }
    .hero-search-primary input::placeholder {
        color: #6B6B6B;
    }
    .hero-suggestions {
        position: fixed;
        z-index: 10000;
        margin: 0;
        padding: 8px;
        list-style: none;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 16px 40px rgba(5, 11, 32, 0.16);
        max-height: 320px;
        overflow: auto;
        text-align: left;
    }
    .hero-suggestions button {
        display: flex;
        flex-direction: column;
        width: 100%;
        border: none;
        background: transparent;
        border-radius: 10px;
        padding: 10px 14px;
        color: var(--color-heading-1);
        cursor: pointer;
        text-align: left;
    }
    .hero-suggestions li.active button,
    .hero-suggestions button:hover {
        background: #f4f5f8;
    }
    .hero-suggestions .suggestion-type,
    .hero-suggestions .hero-suggestion-empty {
        color: #6B6B6B;
        font-size: 12px;
    }
    .hero-suggestions .hero-suggestion-empty {
        padding: 12px 14px;
        font-size: 14px;
    }
    .rts-banner-area .banner-area-one .banner-content-area .select-area-down .hero-filter {
        background: var(--color-gray);
        flex: 1 1 0;
        min-width: 0;
        border-radius: 40px;
    }
    .rts-banner-area .banner-area-one .banner-content-area .select-area-down .hero-filter .nice-select {
        background: transparent;
        width: 100%;
        height: 48px;
        line-height: 48px;
        border: none;
        border-radius: 40px;
        padding: 0 18px;
        color: var(--color-heading-1);
    }
    .rts-banner-area .banner-area-one .banner-content-area .select-area-down .hero-filter .nice-select::after {
        right: 20px;
        border-bottom: 2px solid var(--color-heading-1);
        border-right: 2px solid var(--color-heading-1);
    }
    @@media (max-width: 767px) {
        .hero-search-primary {
            height: 56px;
            padding: 0 16px;
        }
        .hero-search-form .select-area-down {
            max-width: 100%;
        }
    }
</style>
            <section class="rts-banner-area bg_image_one jarallax">
