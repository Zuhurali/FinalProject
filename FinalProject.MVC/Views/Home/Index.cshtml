@section Scripts {
    <script src="~/js/hero-search.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const homeCarsArea = document.querySelector(".rts-portfolio-area.home-cars-area");
            if (!homeCarsArea || homeCarsArea.dataset.homeCarSwiperBound === "1") {
                return;
            }
            homeCarsArea.dataset.homeCarSwiperBound = "1";

            const swiperByPane = new Map();

            function createHomeCarSwiper(element) {
                if (element.swiper) {
                    return element.swiper;
                }

                const pagination = element.querySelector(".home-car-pagination");
                const nextButton = element.querySelector(".swiper-button-next");
                const previousButton = element.querySelector(".swiper-button-prev");

                return new Swiper(element, {
                    slidesPerView: 1,
                    spaceBetween: 20,
                    speed: 700,
                    rewind: true,
                    watchOverflow: true,
                    observer: true,
                    observeParents: true,
                    pagination: {
                        el: pagination,
                        clickable: true
                    },
                    navigation: {
                        nextEl: nextButton,
                        prevEl: previousButton
                    },
                    breakpoints: {
                        768: {
                            slidesPerView: 2,
                            spaceBetween: 24
                        },
                        1200: {
                            slidesPerView: 3,
                            spaceBetween: 30
                        }
                    }
                });
            }

            function refreshPaneSwiper(pane) {
                if (!pane) {
                    return;
                }

                const slider = pane.querySelector(".home-car-slider");
                if (!slider) {
                    return;
                }

                let swiper = swiperByPane.get(pane.id);
                if (!swiper) {
                    swiper = createHomeCarSwiper(slider);
                    swiperByPane.set(pane.id, swiper);
                }

                swiper.update();
                if (typeof swiper.slideTo === "function") {
                    swiper.slideTo(0, 0);
                }
            }

            homeCarsArea.querySelectorAll(".tab-pane.show.active .home-car-slider").forEach(function (element) {
                const pane = element.closest(".tab-pane");
                if (pane) {
                    refreshPaneSwiper(pane);
                }
            });

            homeCarsArea.querySelectorAll('#myTab button[data-bs-toggle="tab"]').forEach(function (tabButton) {
                tabButton.addEventListener("shown.bs.tab", function (event) {
                    const targetSelector = event.target.getAttribute("data-bs-target");
                    if (!targetSelector) {
                        return;
                    }
                    refreshPaneSwiper(homeCarsArea.querySelector(targetSelector));
                });
            });
        });
    </script>
}
