@section Scripts {
    <script src="~/js/hero-search.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const homeCarSwipers = [];

            document.querySelectorAll(".home-car-slider").forEach(function (element) {
                const pagination = element.querySelector(".home-car-pagination");
                const nextButton = element.querySelector(".swiper-button-next");
                const previousButton = element.querySelector(".swiper-button-prev");

                homeCarSwipers.push(new Swiper(element, {
                    slidesPerView: 1,
                    spaceBetween: 20,
                    speed: 700,
                    rewind: true,
                    watchOverflow: true,
                    observer: true,
                    observeParents: true,
                    pagination: {
                        el: pagination,
                        clickable: true
                    },
                    navigation: {
                        nextEl: nextButton,
                        prevEl: previousButton
                    },
                    breakpoints: {
                        768: {
                            slidesPerView: 2,
                            spaceBetween: 24
                        },
                        1200: {
                            slidesPerView: 3,
                            spaceBetween: 30
                        }
                    }
                }));
            });

            document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function (tabButton) {
                tabButton.addEventListener("shown.bs.tab", function () {
                    homeCarSwipers.forEach(function (swiper) {
                        swiper.update();
                    });
                });
            });
        });
    </script>
}
