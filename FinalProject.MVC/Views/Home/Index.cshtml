            <section class="rts-banner-area bg_image_one home-x5-hero">
                <div class="home-x5-hero__stage">
                    <img class="home-x5-hero__photo" src="@Url.Content(home.HeroImagePath)" width="2048" height="1364" fetchpriority="high" alt="@home.HeroImageAlt">
                </div>
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="banner-area-one bg_image">
                                <div class="banner-content-area">
                                    <h1 class="title wow fadeInUp" data-wow-delay=".2s" data-wow-duration="1s">@home.HeroTitle <span>@home.HeroHighlight</span></h1>
                                    <form id="heroSearchForm" method="get" asp-controller="Cars" asp-action="Index" class="hero-search-form wow fadeInUp" data-wow-delay=".8s" data-wow-duration="1s" data-suggestions-url="@Url.Action("Suggestions", "Cars")" onsubmit="this.querySelectorAll('[name]').forEach(function (field) { if (!field.value || !field.value.trim()) field.disabled = true; });">
                                        <div class="hero-search-primary">
                                            <svg width="18" height="18" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                                <path d="M10.69 10.69L13 13M12.3333 6.68575C12.3333 9.826 9.796 12.3715 6.667 12.3715C3.53725 12.3715 1 9.826 1 6.6865C1 3.54475 3.53725 1 6.66625 1C9.796 1 12.3333 3.5455 12.3333 6.68575Z" stroke="#6B6B6B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                            <input type="text" name="search" placeholder="Search cars..." autocomplete="off" aria-label="Search cars" />
                                        </div>
                                        <div class="select-area-down">
                                        <div class="hero-filter">
                                            <select name="make" class="mySelect">
                                                <option value="">Car Make</option>
                                                @foreach (var make in searchMakes)
                                                {
                                                    <option value="@make">@make</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="hero-filter">
                                            <select name="model" id="heroModelSelect" class="my_select2" disabled>
                                                <option value="">Select Car Make First</option>
                                            </select>
                                        </div>
                                        <div class="hero-filter">
                                            <select name="priceRange" class="my_select2">
                                                <option value="">Price</option>
                                                <option value="0-25000">$0 - $25,000</option>
                                                <option value="10000-20000">$10,000 - $20,000</option>
                                                <option value="25000-35000">$25,000 - $35,000</option>
                                                <option value="35000-50000">$35,000 - $50,000</option>
                                                <option value="50000-70000">$50,000 - $70,000</option>
                                                <option value="70000+">$70,000+</option>
                                            </select>
                                        </div>
                                        <button type="submit" class="rts-btn radius-big icon btn-primary">
                                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M10.69 10.69L13 13M12.3333 6.68575C12.3333 9.826 9.796 12.3715 6.667 12.3715C3.53725 12.3715 1 9.826 1 6.6865C1 3.54475 3.53725 1 6.66625 1C9.796 1 12.3333 3.5455 12.3333 6.68575Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                            Search
                                        </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Banner area end -->

            <!-- Category Area Start -->
            <section class="rts-category-area rts-section-gap">
                <div class="container">
                    <div class="section-title-area">
                        <p class="sub-title wow fadeInUp" data-wow-delay=".1s" data-wow-duration=".8s">@home.CategoriesEyebrow</p>
                        <h2 class="section-title wow move-right">@home.CategoriesHeadingBefore <span>@home.CategoriesHeadingHighlight</span>@(string.IsNullOrWhiteSpace(home.CategoriesHeadingAfter) ? null : " " + home.CategoriesHeadingAfter.Trim())</h2>
                    </div>
                    <div class="section-inner wow fadeInUp" data-wow-delay=".3s" data-wow-duration="1s">
                        @if (homeCategories.Count > 0)
                        {
                            <div class="swiper category-slider">
                                <div class="swiper-wrapper">
                                    @foreach (var category in homeCategories)
                                    {
                                        <div class="swiper-slide">
                                            <div class="category-wrapper">
                                                <div class="icon">
                                                    <img src="@Url.Content(category.IconPath)" alt="">
                                                </div>
                                                <h6 class="title"><a asp-controller="Cars" asp-action="Index" asp-route-category="@category.Slug">@category.Name</a></h6>
                                                <p class="desc">@category.CountLabel</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="swiper-pagination"></div>
                            </div>
                        }
                    </div>
                </div>
                <div class="bg-shape-area">
                    <img src="~/assets/images/category/shape/shape-01.svg" alt="">
                    <img src="~/assets/images/category/shape/shape-02.svg" alt="">
                </div>
            </section>
            <!-- Category Area End -->

            <!-- Portfolio Area Start -->
            <section class="rts-portfolio-area home-cars-area rts-section-gap">
                <div class="container">
                    <div class="section-title-area2">
                        <p class="sub-title wow fadeInUp" data-wow-delay=".1s" data-wow-duration=".8s">@home.PortfolioEyebrow</p>
