@{
    ViewData["Title"] = "Shop Demo - AutoVault";
}

<!-- Content based on index-four.html -->
<!-- Banner area start -->
<section class="rts-banner-area bg_image_four jarallax">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="banner-area-one bg_image">
                    <div class="banner-content-area">
                        <div class="pre-title wow fadeInUp" data-wow-delay=".2s" data-wow-duration="1s">
                            <span>Automotive Shop & Accessories</span>
                        </div>
                        <h1 class="title wow fadeInUp" data-wow-delay=".4s" data-wow-duration="1s">Premium 
                            Auto Parts &
                            <span>Accessories</span></h1>
                        <div class="button-area wow fadeInUp" data-wow-delay=".8s" data-wow-duration="1s">
                            <a asp-controller="Shop" asp-action="Index" class="rts-btn btn-primary radius-big">Shop Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Banner area end -->