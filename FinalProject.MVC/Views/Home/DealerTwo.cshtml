@section Scripts {
    <script src="~/js/hero-search.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll("form.dealer-search-form").forEach(function (form) {
            bindMakeModels(form, "dealerModelsByMake", false);
        });
        document.querySelectorAll("#myTab button[data-bs-toggle='tab']").forEach(function (button) {
            button.addEventListener("shown.bs.tab", function () {
                if (window.jQuery && window.jQuery.fn && window.jQuery.fn.niceSelect) {
                    window.jQuery(".dealer-search-form select").niceSelect("update");
                }
            });
        });
    </script>
