@using System.Text.Json
@using FinalProject.MVC.Mappings
@{
    ViewData["Title"] = "Dealer Two - AutoVault";
    var dealerCars = ViewData["DealerCars"] as IReadOnlyList<Car> ?? Array.Empty<Car>();
    var searchMakes = ViewData["SearchMakes"] as IReadOnlyList<string> ?? Array.Empty<string>();
    var modelsByMake = ViewData["ModelsByMake"] as IReadOnlyDictionary<string, string[]>
        ?? new Dictionary<string, string[]>();
    Car? FindCar(string make, string model) => dealerCars.FirstOrDefault(car =>
        car.Make.Equals(make, StringComparison.OrdinalIgnoreCase)
        && car.Model.Equals(model, StringComparison.OrdinalIgnoreCase));
    var highlights = new[]
    {
        FindCar("Mazda", "MX-5"),
        FindCar("Ford", "Mustang GT"),
        FindCar("BMW", "330i"),
        FindCar("Nissan", "GT-R")
    }.Where(car => car != null).Cast<Car>().ToList();
    var allCars = highlights
        .Concat(dealerCars.Where(car => highlights.All(highlight => highlight.Id != car.Id)).OrderByDescending(car => car.Year).ThenBy(car => car.Name))
        .Take(12)
        .ToList();
    var newCars = dealerCars.Where(car => car.IsNew).OrderByDescending(car => car.Year).Take(9).ToList();
    var usedCars = highlights
        .Where(car => !car.IsNew)
        .Concat(dealerCars.Where(car => !car.IsNew && highlights.All(highlight => highlight.Id != car.Id)).OrderByDescending(car => car.Year))
        .Take(9)
        .ToList();
    var trendingCars = dealerCars.OrderByDescending(car => car.Price).Take(9).ToList();
    var stockCars = dealerCars.Where(car => car.InStock).OrderByDescending(car => car.CreatedAt).Take(9).ToList();
    var inventoryTabs = new (string Id, bool Active, IReadOnlyList<Car> Cars)[]
    {
        ("all", true, allCars),
        ("new-cars", false, newCars),
        ("used", false, usedCars),
        ("trending", false, trendingCars),
        ("stocks", false, stockCars)
    };
    IReadOnlyList<Car> BrandCars(string make) => dealerCars
        .Where(car => car.Make.Equals(make, StringComparison.OrdinalIgnoreCase))
        .OrderBy(car => car.Model)
        .ToList();
    var brandTabs = new (string Id, string Make, string? Preferred, bool Active)[]
    {
        ("bmw", "BMW", "330i", true),
        ("mazda", "Mazda", "MX-5", false),
        ("honda", "Honda", null, false),
        ("nissan", "Nissan", "GT-R", false)
    };
}
