@model IReadOnlyList<string>
@{
    var condition = ViewData["Condition"] as string;
    var hasCondition = string.Equals(condition, "new", StringComparison.OrdinalIgnoreCase)
        || string.Equals(condition, "used", StringComparison.OrdinalIgnoreCase);
}
<form class="dealer-search-form" method="get" asp-controller="Cars" asp-action="Index" onsubmit="this.querySelectorAll('[name]').forEach(function (field) { if (!field.value || !field.value.trim()) field.disabled = true; });">
    @if (hasCondition)
    {
        <input type="hidden" id="dealer-search-condition" name="condition" value="@condition" />
    }
    else
    {
        <input type="hidden" id="dealer-search-condition" name="condition" value="" disabled />
    }
    <div class="select-area-down">
        <select name="make" class="mySelect">
            <option value="">Car Make</option>
            @foreach (var make in Model)
            {
                <option value="@make">@make</option>
            }
        </select>
        <div class="select-2">
            <select name="model" class="my_select2" disabled>
                <option value="">Select Car Make First</option>
            </select>
        </div>
        <div class="select-2">
            <select name="priceRange" class="my_select2">
                <option value="">Price</option>
                <option value="0-25000">$0 - $25,000</option>
                <option value="10000-20000">$10,000 - $20,000</option>
                <option value="25000-35000">$25,000 - $35,000</option>
                <option value="35000-50000">$35,000 - $50,000</option>
                <option value="50000-70000">$50,000 - $70,000</option>
                <option value="70000+">$70,000+</option>
            </select>
        </div>
        <div class="select-2">
            <select class="my_select2" aria-label="Location" disabled>
                <option value="" selected>All locations</option>
            </select>
        </div>
        <button type="submit" class="rts-btn radius-small icon btn-primary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10.69 10.69L13 13M12.3333 6.68575C12.3333 9.826 9.796 12.3715 6.667 12.3715C3.53725 12.3715 1 9.826 1 6.6865C1 3.54475 3.53725 1 6.66625 1C9.796 1 12.3333 3.5455 12.3333 6.68575Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Search
        </button>
    </div>
</form>
