@model Car
<div class="project-wrapper2">
    <div class="image-area@(Model.Id == 1 ? " image-fit-contain" : "")">
        <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id"><img src="@Url.Content(Model.ImagePath)" alt="@Model.Name"></a>
        @if (!string.IsNullOrWhiteSpace(Model.Badge))
        {
            <span class="tag">@Model.Badge</span>
        }
        <a href="#" class="wishlist"><i class="fa-regular fa-heart"></i></a>
        <a href="@Url.Content(Model.ImagePath)" class="gallery-image">
            <img src="~/assets/images/icon/image.svg" alt="">
            @Model.ImageCount
        </a>
    </div>
    <span class="price">@Model.Price.ToString("N0")$</span>
    <div class="content-area">
        <h6 class="title "><a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></h6>
        <ul class="feature-area">
            <li>
                <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                @Model.Mileage.ToString("N0") Miles
            </li>
            <li>
                <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                @Model.Fuel
            </li>
            <li>
                <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                @Model.Transmission
            </li>
        </ul>
        <div class="button-area">
            <p class="">$@Model.Price.ToString("N0")</p>
            <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id" class="rts-btn btn-primary radius-small">View Details</a>
        </div>
    </div>
</div>
