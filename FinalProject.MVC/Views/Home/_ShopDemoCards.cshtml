@model IReadOnlyList<ShopProduct>
<div class="row g-5">
@foreach (var product in Model)
{
    <div class="col-lg-4 col-md-6 d-flex">
        <div class="project-wrapper4 showroom-card">
            <div class="image-area">
                <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">
                    <img src="@Url.Content(product.ImagePath)" alt="@product.Name">
                </a>
            </div>
            <div class="content-area">
                <ul class="star-rating">
                    @for (var star = 1; star <= 5; star++)
                    {
                        if (star <= Math.Floor(product.Rating))
                        {
                            <li><i class="rt-icon-star"></i></li>
                        }
                        else if (star <= product.Rating)
                        {
                            <li><i class="rt-icon-star-sharp-half-stroke"></i></li>
                        }
                        else
                        {
                            <li><i class="rt-icon-star" style="color:#ddd;"></i></li>
                        }
                    }
                </ul>
                <p class="product-rating-summary">@(product.RatingCount == 0 ? "No ratings" : $"{product.Rating:0.0} ({product.RatingCount} reviews)")</p>
                <h6 class="title"><a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h6>
                <p class="stock-line">@product.StockStatus · @product.Quantity available</p>
                <div class="button-area">
                    @if (product.HasOffer)
                    {
                        <p class="price-line"><span style="text-decoration:line-through;color:#888;font-weight:500;">$@product.Price.ToString("0")</span> $@product.SalePrice.ToString("0")</p>
                    }
                    else
                    {
                        <p class="price-line">$@product.Price.ToString("0")</p>
                    }
                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" asp-fragment="ask-showroom" class="rts-btn btn-primary radius-big">Ask About Product</a>
                </div>
            </div>
        </div>
    </div>
}
</div>
