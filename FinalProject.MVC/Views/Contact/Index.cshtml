@{
    ViewData["Title"] = "Contact - AutoVault";
}

<!-- rts breadcrumb area start -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Contact</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Contact</a>
            </div>
        </div>
    </div>
</div>
<!-- rts breadcrumb area end -->

<!-- Contact Start -->
<section class="rts-contact-area inner rts-section-gap">
    <div class="container">
        <div class="section-inner d-flex">
            <div class="map-area">
                <div class="contact-map-area-fluid">
                    <iframe class="contact-map" height="607" 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d184552.30943582457!2d-79.54286989999999!3d43.718371!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89d4cb90d7c63ba5%3A0x323555502ab4c477!2sToronto%2C%20ON%2C%20Canada!5e0!3m2!1sen!2sus!4v1640995200000!5m2!1sen!2sus" 
                        style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
            <div class="get-in-touch-area">
                <div class="contact-form">
                    <h5 class="text-center">Get In Touch</h5>
                    <form class="form__content" method="post" id="contact-form">
                        <div class="form__control">
                            <input type="text" class="input-form" name="name" placeholder="Your Name" required>
                        </div>
                        <div class="form__control">
                            <input type="email" class="input-form" name="email" placeholder="Email Address" required>
                        </div>
                        <div class="form__control">
                            <input type="text" class="input-form" name="phone" placeholder="Phone Number" required>
                        </div>
                        <div class="form__control">
                            <input type="text" class="input-form" name="car" placeholder="Car Type">
                        </div>
                        <div class="form__control">
                            <textarea name="message" cols="30" rows="10" placeholder="Message" required></textarea>
                        </div>
                        <div class="form__control">
                            <button type="submit" class="submit__btn">Submit Now</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Contact End -->