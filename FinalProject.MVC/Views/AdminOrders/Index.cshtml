@model IReadOnlyList<Order>
@{
    Layout = "_AdminLayout";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Legacy order archive</h1>
        <p class="text-muted mb-0">Read-only historical rows from SQL <code>Orders</code> / <code>OrderItems</code>. AutoVault does <strong>not</strong> take online payment — new sales are recorded under In-Store Sales and Purchase Requests. Public checkout redirects to Contact.</p>
    </div>
</div>
<div class="admin-card">
    @if (Model.Count == 0)
    {
        <p class="mb-0">No historical order rows in SQL.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>When (UTC)</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Coupon</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @order.FirstName @order.LastName
                            <div class="small text-muted">@order.Email</div>
                        </td>
                        <td>@order.OrderItems.Count</td>
                        <td>@(string.IsNullOrWhiteSpace(order.CouponCode) ? "—" : order.CouponCode)</td>
                        <td>@order.Total.ToString("C")</td>
                        <td>@order.OrderStatus</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark">Details</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
