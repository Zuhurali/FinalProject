@{
    ViewData["Title"] = "About Us - AutoVault";
}

<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">About</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">About</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-about-area inner two rts-section-gapTop rts-section-gapBottom">
    <div class="container">
        <div class="section-inner">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="about-image-area-two">
                        <div class="left wow scaleIn" data-wow-delay=".5s" data-wow-duration="1s">
                            <img src="~/assets/images/about/12.webp" width="339" alt="">
                        </div>
                        <div class="right wow scaleIn" data-wow-delay=".5s" data-wow-duration="1s">
                            <img src="~/assets/images/about/13.webp" width="280" alt="">
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="about-content-area">
                        <div class="section-title-area">
                            <p class="sub-title wow fadeInUp" data-wow-delay=".1s" data-wow-duration="1s">About Us</p>
                            <h2 class="section-title wow move-right">Used cars and parts at the Baku
                                <span>store</span>
                            </h2>
                        </div>
                        <p class="desc wow fadeInUp" data-wow-delay=".4s" data-wow-duration="1s">
                            AutoVault is a store on Babek Prospekti 22–24 in Baku. Browse used cars and automotive parts online, then visit in person to inspect the item and complete the purchase. There is no online payment or delivery.
                        </p>
                        <a href="tel:+994503546767" class="rts-btn call-btn wow fadeInUp" data-wow-delay=".6s" data-wow-duration="1s">
                            <span>
                                <i class="fa-regular fa-phone"></i>
                            </span>
                            <div class="content">
                                <h6>Call Us Now</h6>
                                <p>+994 50 354 67 67</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="bg-shape-area">
        <img src="~/assets/images/category/shape/shape-01.svg" alt="">
        <img src="~/assets/images/category/shape/shape-02.svg" alt="">
    </div>
</section>

<div class="rts-cta-area area-2">
    <div class="container">
        <div class="cta-inner">
            <h2 class="title">If you have any questions Please Call.</h2>
            <div class="contact">
                <a href="tel:+994503546767">
                    <img src="~/assets/images/cta/call.svg" alt="">
                    +994 50 354 67 67
                </a>
            </div>
            <img class="shape one" src="~/assets/images/cta/round.svg" alt="">
            <img class="shape two" src="~/assets/images/cta/line.svg" alt="">
        </div>
    </div>
</div>
