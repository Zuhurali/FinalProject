@{
    ViewData["Title"] = "Pricing - AutoVault";
}

<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Pricing</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Pricing</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-section-gap">
    <div class="container">
        <div class="section-title-area text-center">
            <p class="sub-title">Our Pricing</p>
            <h2 class="section-title">Choose Your Perfect <span>Plan</span></h2>
        </div>
        <div class="row g-5 mt--30">
            <div class="col-lg-4">
                <div class="pricing-wrapper">
                    <h3 class="plan-name">Basic</h3>
                    <div class="price-area">
                        <h2 class="price">$99<span>/month</span></h2>
                    </div>
                    <ul class="features">
                        <li>Up to 5 car listings</li>
                        <li>Basic support</li>
                        <li>Standard features</li>
                    </ul>
                    <a href="#" class="rts-btn btn-border">Choose Plan</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="pricing-wrapper featured">
                    <h3 class="plan-name">Premium</h3>
                    <div class="price-area">
                        <h2 class="price">$199<span>/month</span></h2>
                    </div>
                    <ul class="features">
                        <li>Up to 20 car listings</li>
                        <li>Priority support</li>
                        <li>Advanced features</li>
                        <li>Featured listings</li>
                    </ul>
                    <a href="#" class="rts-btn btn-primary">Choose Plan</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="pricing-wrapper">
                    <h3 class="plan-name">Enterprise</h3>
                    <div class="price-area">
                        <h2 class="price">$399<span>/month</span></h2>
                    </div>
                    <ul class="features">
                        <li>Unlimited listings</li>
                        <li>24/7 support</li>
                        <li>All features</li>
                        <li>Custom branding</li>
                    </ul>
                    <a href="#" class="rts-btn btn-border">Choose Plan</a>
                </div>
            </div>
        </div>
    </div>
</section>