@model ProductCampaign
@{
    Layout = "_AdminLayout";
    var products = (IReadOnlyList<ShopProduct>)ViewBag.Products;
}
<h1 class="h3 mb-4">@(Model.Id == 0 ? "New campaign" : "Edit campaign")</h1>
<form asp-action="Save" method="post" class="admin-card">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label>Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label>Product</label>
            <select asp-for="ProductId" class="form-control">
                @foreach (var product in products)
                {
                    <option value="@product.Id">@product.Name (@product.Price.ToString("C"))</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label>Discounted price</label>
            <input asp-for="DiscountedPrice" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Discount percent</label>
            <input asp-for="DiscountPercent" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Starts (UTC)</label>
            <input asp-for="StartsAt" class="form-control" type="datetime-local" />
        </div>
        <div class="col-md-3">
            <label>Ends (UTC)</label>
            <input asp-for="EndsAt" class="form-control" type="datetime-local" />
        </div>
        <div class="col-12">
            <label class="d-block">Active</label>
            <input asp-for="IsActive" />
        </div>
    </div>
    <p class="mt-3">Enter one offer: a discounted price below the stored original price, or a percentage from 1 to 90. Leave the other blank.</p>
    <button class="btn btn-primary mt-3" type="submit">Save</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
