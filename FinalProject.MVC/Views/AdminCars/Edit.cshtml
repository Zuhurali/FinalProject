@model CarEditorViewModel
@{
    Layout = "_AdminLayout";
}
<h1 class="h3 mb-4">Edit Car</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-card">
    <partial name="_CarFields" model="Model" />
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
