@model CarEditorViewModel
@using System.Globalization
@{
    string Shown(string key, string stored, bool blankWhenZero)
    {
        var posted = ViewData.ModelState.TryGetValue(key, out var entry);
        return ListingFieldValues.Number(Model.Id, posted, entry?.AttemptedValue, stored, blankWhenZero);
    }

    IEnumerable<string> Choices(IEnumerable<string> options, string? current)
    {
        var list = options.ToList();
        if (!string.IsNullOrWhiteSpace(current)
            && !list.Contains(current, StringComparer.OrdinalIgnoreCase))
        {
            list.Insert(0, current.Trim());
        }

        return list;
    }

    var seats = CarListingRules.SeatChoices.ToList();
    if (Model.Car.Seats is int currentSeats && !seats.Contains(currentSeats))
    {
        seats.Add(currentSeats);
        seats.Sort();
    }

    var yearText = Shown("Car.Year", Model.Car.Year.ToString(CultureInfo.InvariantCulture), true);
    var selectedYear = int.TryParse(yearText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedYear) && parsedYear > 0
        ? parsedYear
        : (int?)null;
    var newestYear = Math.Max(CarListingRules.MaxModelYear, selectedYear ?? CarListingRules.MaxModelYear);
    var price = Shown("Car.Price", Model.Car.Price.ToString("0.##", CultureInfo.CurrentCulture), true);
    var mileage = Shown("Car.Mileage", Model.Car.Mileage.ToString(CultureInfo.InvariantCulture), true);
    var horsepower = Shown("Car.Horsepower", Model.Car.Horsepower?.ToString(CultureInfo.InvariantCulture) ?? string.Empty, true);
    var cylinders = Shown("Car.Cylinders", Model.Car.Cylinders?.ToString(CultureInfo.InvariantCulture) ?? string.Empty, true);
    var colorName = VehicleColorCatalog.DisplayName(Model.Car.Color);
    var colorHex = VehicleColorCatalog.Hex(Model.Car.Color);
    var selectedFeatures = Model.Car.Features ?? new List<string>();
}

@Html.AntiForgeryToken()
<input type="hidden" name="Car.FeaturesSpecified" value="true" />
<input type="hidden" name="Car.ConditionSpecified" value="true" />
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<h2 class="h5 mt-2">Basic Information</h2>
<div class="row g-3">
    <div class="col-md-6">
        <label for="Car_BrandId">Make / Brand</label>
        <select id="Car_BrandId" name="Car.BrandId" class="form-select av-native-select" required>
            <option value="">Select make</option>
            @foreach (var brand in Model.Lookups.Brands)
            {
                <option value="@brand.Id" selected="@(Model.Car.BrandId == brand.Id ? "selected" : null)">@brand.Name</option>
            }
        </select>
        <span asp-validation-for="Car.BrandId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label for="Car_Model">Model</label>
        <input asp-for="Car.Model" class="form-control" placeholder="Enter model" required>
        <span asp-validation-for="Car.Model" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label for="Car_CategoryId">Category / Car Type</label>
        <select id="Car_CategoryId" name="Car.CategoryId" class="form-select av-native-select" required>
            <option value="">Select category</option>
            @foreach (var category in Model.Lookups.Categories)
            {
                <option value="@category.Id" selected="@(Model.Car.CategoryId == category.Id ? "selected" : null)">@category.Name</option>
            }
        </select>
        <span asp-validation-for="Car.CategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label for="Car_Year">Model Year</label>
        <select id="Car_Year" name="Car.Year" class="form-select av-native-select" required>
            <option value="">Select model year</option>
            @for (var modelYear = newestYear; modelYear >= 1900; modelYear--)
            {
                <option value="@modelYear" selected="@(selectedYear == modelYear ? "selected" : null)">@modelYear</option>
            }
        </select>
        <span asp-validation-for="Car.Year" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label for="Car_Price">Price</label>
        <input id="Car_Price" name="Car.Price" class="form-control" inputmode="decimal" min="0.01" step="0.01" placeholder="Enter price" value="@price" required>
        <span asp-validation-for="Car.Price" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label for="Car_Status">Listing Status</label>
        <select id="Car_Status" name="Car.Status" class="form-select av-native-select">
            @foreach (var status in CarListingRules.Statuses)
            {
                <option value="@status" selected="@(string.Equals(Model.Car.Status, status, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@status</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" asp-for="Car.IsFeatured" />
            <label class="form-check-label" asp-for="Car.IsFeatured">Show on homepage</label>
        </div>
    </div>
</div>

<h2 class="h5 mt-4">Vehicle Specifications</h2>
<div class="row g-3">
    <div class="col-md-4">
        <label for="Car_Mileage"><i class="rt-icon-tracking" aria-hidden="true"></i> Mileage</label>
        <input id="Car_Mileage" name="Car.Mileage" class="form-control" inputmode="numeric" min="0" placeholder="Enter mileage" value="@mileage" required>
        <div class="form-text">Use 0 only when the vehicle has not been driven. Existing listings without a unit stay labeled in miles.</div>
        <span asp-validation-for="Car.Mileage" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label for="Car_MileageUnit">Unit</label>
        <select id="Car_MileageUnit" name="Car.MileageUnit" class="form-select av-native-select">
            <option value="">Select</option>
            <option value="km" selected="@(string.Equals(Model.Car.MileageUnit, "km", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">km</option>
            <option value="mi" selected="@(string.Equals(Model.Car.MileageUnit, "mi", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">miles</option>
        </select>
    </div>
    <div class="col-md-3">
        <label for="Car_Condition"><i class="rt-icon-review" aria-hidden="true"></i> Condition</label>
        <select id="Car_Condition" name="Car.Condition" class="form-select av-native-select" required>
            <option value="">Select condition</option>
            @foreach (var condition in CarListingRules.Conditions)
            {
                <option value="@condition" selected="@(string.Equals(Model.Car.Condition, condition, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@condition</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label for="Car_FuelType"><i class="rt-icon-fuel-station" aria-hidden="true"></i> Fuel Type</label>
        <select id="Car_FuelType" name="Car.FuelType" class="form-select av-native-select" required>
            <option value="">Select fuel type</option>
            @foreach (var fuel in Choices(CarListingRules.Fuels, Model.Car.FuelType))
            {
                <option value="@fuel" selected="@(string.Equals(Model.Car.FuelType, fuel, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@fuel</option>
            }
        </select>
        <span asp-validation-for="Car.FuelType" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label for="Car_Transmission"><i class="rt-icon-gearshift" aria-hidden="true"></i> Transmission</label>
        <select id="Car_Transmission" name="Car.Transmission" class="form-select av-native-select" required>
            <option value="">Select transmission</option>
            @foreach (var transmission in Choices(CarListingRules.Transmissions, Model.Car.Transmission))
            {
                <option value="@transmission" selected="@(string.Equals(Model.Car.Transmission, transmission, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@transmission</option>
            }
        </select>
        <span asp-validation-for="Car.Transmission" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label><i class="rt-icon-color-palette" aria-hidden="true"></i> Exterior Color</label>
        <div class="av-color-swatches" role="list">
            @foreach (var color in CarListingRules.ExteriorColors)
            {
                <button type="button"
                        class="av-color-swatch@(string.Equals(colorName, color.Name, StringComparison.OrdinalIgnoreCase) ? " is-selected" : string.Empty)"
                        data-color="@color.Name"
                        data-hex="@color.Hex"
                        title="@color.Name"
                        aria-label="@color.Name">
                    <span class="av-color-chip" style="background:@color.Hex"></span>
                    <span>@color.Name</span>
                </button>
            }
            @{
                var isCustomColor = !string.IsNullOrWhiteSpace(colorName)
                    && !CarListingRules.ExteriorColors.Any(item => item.Name.Equals(colorName, StringComparison.OrdinalIgnoreCase));
            }
            <button type="button" class="av-color-swatch@(isCustomColor ? " is-selected" : string.Empty)" data-color="Other" data-hex="" aria-label="Other color">
                <span class="av-color-chip av-color-chip-other"></span>
                <span>Other</span>
            </button>
        </div>
        <div class="row g-2 mt-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label mb-1" for="Car_Color_Hex">HEX</label>
                <input id="Car_Color_Hex" class="form-control" maxlength="7" placeholder="#000000" value="@colorHex" autocomplete="off" />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <div>
                    <label class="form-label mb-1" for="Car_Color_Picker">Picker</label>
                    <input id="Car_Color_Picker" type="color" class="form-control form-control-color" value="@(colorHex ?? "#808080")" aria-label="Color picker" />
                </div>
                <span id="Car_Color_Preview" class="av-color-preview" style="background:@(colorHex ?? "transparent")" title="Preview"></span>
            </div>
            <div class="col-md-4" id="Car_Color_Name_Wrap" @(isCustomColor ? null : "hidden")>
                <label class="form-label mb-1" for="Car_Color_Name">Custom name</label>
                <input id="Car_Color_Name" class="form-control" maxlength="40" placeholder="Custom color" value="@colorName" autocomplete="off" />
            </div>
        </div>
        <div id="Car_Color_Selected" class="form-text mt-1">@(string.IsNullOrWhiteSpace(colorName) ? "No color selected" : (string.IsNullOrWhiteSpace(colorHex) ? colorName : $"{colorName} ({colorHex})"))</div>
        <input type="hidden" id="Car_Color" name="Car.Color" value="@(string.IsNullOrWhiteSpace(Model.Car.Color) ? string.Empty : VehicleColorCatalog.FromPosted(Model.Car.Color))" />
        <div class="form-text">Choose a swatch, enter a HEX code, or use the picker. A HEX code approximates the paint and is not the factory finish name.</div>
        <span asp-validation-for="Car.Color" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label for="Car_Seats"><i class="rt-icon-user" aria-hidden="true"></i> Seating Capacity <span class="text-muted">(optional)</span></label>
        <select id="Car_Seats" name="Car.Seats" class="form-select av-native-select">
            <option value="">Select seats</option>
            @foreach (var seat in seats)
            {
                <option value="@seat" selected="@(Model.Car.Seats == seat ? "selected" : null)">@seat seats</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label for="Car_DriveType"><i class="rt-icon-drive" aria-hidden="true"></i> Drive Type <span class="text-muted">(optional)</span></label>
        <select id="Car_DriveType" name="Car.DriveType" class="form-select av-native-select">
            <option value="">Select drive type</option>
            @foreach (var drive in Choices(CarListingRules.DriveTypes, Model.Car.DriveType))
            {
                <option value="@drive" selected="@(string.Equals(Model.Car.DriveType, drive, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@drive</option>
            }
        </select>
        <span asp-validation-for="Car.DriveType" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label for="engine-input"><i class="rt-icon-engine" aria-hidden="true"></i> Engine Size <span class="text-muted">(optional)</span></label>
        <div class="av-combo" data-combo="engine">
            <input id="engine-input" class="form-control av-combo-input" type="text" placeholder="Search or enter liters" autocomplete="off" value="@Model.Car.Engine" />
            <button type="button" class="av-combo-clear" aria-label="Clear engine size" hidden>&times;</button>
            <input type="hidden" id="Car_Engine" name="Car.Engine" value="@Model.Car.Engine" />
            <ul class="av-combo-list" role="listbox" hidden></ul>
        </div>
    </div>
    <div class="col-md-4">
        <label for="hp-input"><i class="rt-icon-monitoring-test" aria-hidden="true"></i> Horsepower <span class="text-muted">(optional)</span></label>
        <div class="av-combo" data-combo="horsepower">
            <input id="hp-input" class="form-control av-combo-input" type="text" inputmode="numeric" placeholder="Search or enter HP" autocomplete="off" value="@horsepower" />
            <button type="button" class="av-combo-clear" aria-label="Clear horsepower" hidden>&times;</button>
            <input type="hidden" id="Car_Horsepower" name="Car.Horsepower" value="@horsepower" />
            <ul class="av-combo-list" role="listbox" hidden></ul>
        </div>
    </div>
    <div class="col-md-4" id="cylinder-field">
        <label for="Car_Cylinders"><i class="rt-icon-engine" aria-hidden="true"></i> Cylinders <span class="text-muted">(optional)</span></label>
        <select id="Car_Cylinders" name="Car.Cylinders" class="form-select av-native-select">
            <option value="">Select cylinders</option>
            @foreach (var count in CarListingRules.CylinderChoices)
            {
                <option value="@count" selected="@(cylinders == count.ToString(CultureInfo.InvariantCulture) ? "selected" : null)">@count</option>
            }
        </select>
        <div class="form-text">Leave empty for electric vehicles.</div>
    </div>
    <div class="col-md-3">
        <label for="Car_Doors"><i class="rt-icon-car" aria-hidden="true"></i> Doors <span class="text-muted">(optional)</span></label>
        <select id="Car_Doors" name="Car.Doors" class="form-select av-native-select">
            <option value="">Select doors</option>
            @foreach (var door in CarListingRules.DoorChoices)
            {
                <option value="@door" selected="@(Model.Car.Doors == door ? "selected" : null)">@door doors</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label for="Car_Steering"><i class="rt-icon-drive" aria-hidden="true"></i> Steering <span class="text-muted">(optional)</span></label>
        <select id="Car_Steering" name="Car.Steering" class="form-select av-native-select">
            <option value="">Select steering</option>
            <option value="LHD" selected="@(string.Equals(Model.Car.Steering, "LHD", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Left-hand drive</option>
            <option value="RHD" selected="@(string.Equals(Model.Car.Steering, "RHD", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Right-hand drive</option>
        </select>
    </div>
    <div class="col-md-6">
        <label for="Car_Vin">VIN / Chassis <span class="text-muted">(optional)</span></label>
        <input asp-for="Car.Vin" class="form-control" maxlength="17" placeholder="11 to 17 letters and numbers">
    </div>
</div>

<h2 class="h5 mt-4">Vehicle History</h2>
<div class="row g-3">
    <div class="col-md-4">
        <label for="Car_AccidentHistory">Accident history <span class="text-muted">(optional)</span></label>
        <select id="Car_AccidentHistory" name="Car.AccidentHistory" class="form-select av-native-select">
            <option value="">Not specified</option>
            @foreach (var accident in CarListingRules.AccidentChoices)
            {
                <option value="@accident" selected="@(string.Equals(Model.Car.AccidentHistory, accident, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@accident</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label for="Car_CustomsStatus">Customs clearance <span class="text-muted">(optional)</span></label>
        <select id="Car_CustomsStatus" name="Car.CustomsStatus" class="form-select av-native-select">
            <option value="">Not specified</option>
            @foreach (var customs in CarListingRules.CustomsChoices)
            {
                <option value="@customs" selected="@(string.Equals(Model.Car.CustomsStatus, customs, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@customs</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label for="Car_MarketOrigin"><i class="rt-icon-marker" aria-hidden="true"></i> Market of origin <span class="text-muted">(optional)</span></label>
        <select id="Car_MarketOrigin" name="Car.MarketOrigin" class="form-select av-native-select">
            <option value="">Not specified</option>
            @foreach (var market in Choices(CarListingRules.MarketOrigins, Model.Car.MarketOrigin))
            {
                <option value="@market" selected="@(string.Equals(Model.Car.MarketOrigin, market, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@market</option>
            }
        </select>
    </div>
    <div class="col-12">
        <partial name="_BodyPartsPicker" model="@(("Car.RepaintedParts", "Car_RepaintedParts", Model.Car.RepaintedParts, "Repainted parts", "rt-icon-color-palette", "Select every panel that has been repainted."))" />
    </div>
    <div class="col-12">
        <partial name="_BodyPartsPicker" model="@(("Car.ReplacedParts", "Car_ReplacedParts", Model.Car.ReplacedParts, "Replaced parts", "rt-icon-engineer", "Select every part that has been replaced."))" />
    </div>
</div>

<h2 class="h5 mt-4">Car Features</h2>
<p class="text-muted">Select every feature this vehicle has. Unchecked features are not shown on the details page.</p>
<div class="row g-2">
    @foreach (var feature in CarFeatureCatalog.All)
    {
        var selected = selectedFeatures.Contains(feature.Key, StringComparer.OrdinalIgnoreCase);
        <div class="col-md-6 col-lg-4">
            <label class="form-check border rounded p-2 h-100">
                <input class="form-check-input ms-0 me-2" type="checkbox" name="Car.Features" value="@feature.Key" @(selected ? "checked" : null) />
                @feature.Label
            </label>
        </div>
    }
</div>

<h2 class="h5 mt-4">Vehicle Photos</h2>
<input type="hidden" name="Car.GallerySpecified" value="true" />
<input asp-for="Car.ImageUrl" id="Car_ImageUrl" type="hidden" />
@{
    var removedIds = new HashSet<int>(Model.Car.RemoveImageIds ?? new List<int>());
    string GallerySrc(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return string.Empty;
        }

        var text = url.Trim();
        if (text.StartsWith("~/", StringComparison.Ordinal))
        {
            return Url.Content(text) ?? text;
        }

        return text;
    }
}
<p class="text-muted mb-2">Choose one or more photos in a single step. The first selected photo becomes the primary image used on listings and details; the rest are saved as additional photos. Existing photos stay until you remove them. JPG, JPEG, PNG, or WEBP up to 5 MB each.</p>
@if (Model.Gallery.Count > 0)
{
    <div class="av-vehicle-photos-grid mb-3" id="car-gallery">
        @foreach (var image in Model.Gallery.OrderBy(item => item.DisplayOrder).ThenBy(item => item.Id))
        {
            var removed = removedIds.Contains(image.Id);
            var isPrimary = Model.Car.PrimaryImageId is int selected
                ? selected == image.Id
                : image.IsMain;
            <div class="av-vehicle-photo-card gallery-item@(removed ? " d-none" : string.Empty)" data-image-id="@image.Id">
                @if (removed)
                {
                    <input type="hidden" name="Car.RemoveImageIds" value="@image.Id" />
                }
                <div class="av-vehicle-photo-card__media">
                    <img src="@GallerySrc(image.ImageUrl)" alt="" class="av-vehicle-photo-card__thumb" />
                    <button type="button" class="gallery-remove" title="Remove photo" aria-label="Remove photo">&times;</button>
                </div>
                <div class="form-check av-vehicle-photo-card__meta">
                    <input class="form-check-input gallery-primary"
                           type="radio"
                           name="Car.PrimaryImageId"
                           id="primary-@image.Id"
                           value="@image.Id"
                           data-url="@image.ImageUrl"
                           @(isPrimary && !removed ? "checked" : null)
                           @(removed ? "disabled" : null) />
                    <label class="form-check-label" for="primary-@image.Id">@(image.IsMain ? "Primary photo" : "Set as primary")</label>
                </div>
            </div>
        }
    </div>
}
else if (Model.Id != null)
{
    <p class="text-muted">This car has no saved photos yet. Choose photos below before saving.</p>
}
<div class="av-gallery-field">
    <div class="av-gallery-picker-row">
        <input type="file"
               id="vehicle-photos"
               name="vehiclePhotos"
               class="av-file-input"
               multiple="multiple"
               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
        <label for="vehicle-photos" class="av-add-images" id="vehicle-photos-button">
            <i class="rt-icon-convertible-car" aria-hidden="true"></i>
            <span>Choose Photos</span>
        </label>
        <div id="vehicle-photos-file-name" class="form-text" aria-live="polite"></div>
        <span asp-validation-for="Car.ImageUrl" class="text-danger"></span>
    </div>
    <div id="vehicle-photos-preview"
         class="av-vehicle-photos-grid"
         data-vehicle-photos-preview
         aria-live="polite"></div>
</div>

<h2 class="h5 mt-4">Description</h2>
<div class="row g-3">
    <div class="col-12">
        <label for="Car_Description">Car Description</label>
        <textarea asp-for="Car.Description" class="form-control" rows="8" maxlength="4000" placeholder="Describe the vehicle's condition, history, and other relevant information" required></textarea>
        <span asp-validation-for="Car.Description" class="text-danger"></span>
    </div>
</div>

<style>
    .av-car-image-picker { min-width: 9rem; }
    .admin-card, .admin-card .row { overflow: visible; }
    .form-check-input { position: static; margin-top: 0.2rem; }
    .av-gallery-field {
        display: block;
        width: 100%;
        max-width: 100%;
    }
    .av-vehicle-photos-grid {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, minmax(140px, 160px));
        gap: 12px;
        align-items: start;
        width: 100%;
        max-width: 100%;
        margin-top: 0.75rem;
    }
    .av-vehicle-photos-grid > .av-vehicle-photo-card {
        width: 100%;
        max-width: 160px;
        min-width: 0;
    }
    .av-vehicle-photo-card {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 160px;
        margin: 0;
        padding: 0.35rem;
        background: #fff;
        border: 1px solid #d9dee7;
        border-radius: 6px;
        overflow: hidden;
    }
    .av-vehicle-photo-card__media {
        position: relative;
        width: 100%;
        height: 110px;
        background: #eef1f4;
        border-radius: 4px;
        overflow: hidden;
    }
    .av-vehicle-photo-card__thumb {
        display: block;
        width: 140px;
        max-width: 100%;
        height: 110px;
        object-fit: cover;
        object-position: center;
        background: #eef1f4;
    }
    .av-vehicle-photo-card__meta {
        display: flex;
        align-items: flex-start;
        gap: 0.35rem;
        margin: 0.45rem 0 0;
        padding: 0;
        min-height: 1.5rem;
        visibility: visible;
    }
    .av-vehicle-photo-card__meta .form-check-label,
    .av-vehicle-photo-card__primary-label {
        font-size: 0.78rem;
        line-height: 1.25;
        color: #0b1b3f;
    }
    .av-vehicle-photo-card__meta .btn {
        font-size: 0.72rem;
        padding: 0.2rem 0.35rem;
        white-space: normal;
        line-height: 1.2;
    }
    .vehicle-photo-new .badge-primary-photo {
        position: absolute;
        left: 6px;
        top: 6px;
        z-index: 3;
        background: #0d6efd;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
