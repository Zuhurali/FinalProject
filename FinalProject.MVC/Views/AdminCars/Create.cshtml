@model CarEditorViewModel
@{
    Layout = "_AdminLayout";
}
<h1 class="h3 mb-4">Add Car</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="admin-card">
    <partial name="_CarFields" model="Model" />
    <button class="btn btn-primary mt-3" type="submit">Create</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
@section Scripts {
    <script src="~/js/car-color-picker.js" asp-append-version="true"></script>
    <script src="~/js/car-body-parts.js" asp-append-version="true"></script>
    <partial name="_CarImagePickerScripts" />
}
