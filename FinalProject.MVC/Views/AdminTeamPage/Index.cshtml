@model TeamPageContentEditViewModel
@{ Layout = "_AdminLayout"; }
<h1 class="h3 mb-4">Team Page</h1>
<p class="text-muted">Page headings and SEO. Counter values on the public page are live counts from published team members and dealers.</p>
<form asp-action="Index" method="post" class="admin-card">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="BreadcrumbTitle" class="form-label"></label><input asp-for="BreadcrumbTitle" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Eyebrow" class="form-label"></label><input asp-for="Eyebrow" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="HeadingBefore" class="form-label"></label><input asp-for="HeadingBefore" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="HeadingHighlight" class="form-label"></label><input asp-for="HeadingHighlight" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="SeoTitle" class="form-label"></label><input asp-for="SeoTitle" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="SeoDescription" class="form-label"></label><input asp-for="SeoDescription" class="form-control" /></div>
    </div>
    <button type="submit" class="btn btn-dark mt-3">Save team page</button>
</form>
