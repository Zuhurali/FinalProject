@{
    ViewData["Title"] = "Confirm Email - AutoVault";
    var confirmed = ViewData["Confirmed"] as bool? == true;
}
<div class="rts-breadcrumb-area service jarallax">
    <div class="container"><div class="breadcrumb-area-wrapper"><h1 class="title">Email Confirmation</h1></div></div>
</div>
<section class="rts-section-gap">
    <div class="container">
        <div class="row justify-content-center"><div class="col-lg-6 contact-form text-center">
            @if (confirmed)
            {
                <div class="alert alert-success">Your email address has been confirmed. You can now sign in.</div>
                <a class="submit__btn" asp-action="SignIn">Sign In</a>
            }
            else
            {
                <div class="alert alert-danger">This confirmation link is invalid or has expired.</div>
                <a asp-action="SignIn">Back to sign in</a>
            }
        </div></div>
    </div>
</section>
