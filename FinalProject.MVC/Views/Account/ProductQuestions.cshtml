@model IReadOnlyList<ProductInquiry>
@{
    ViewData["Title"] = "My Product Questions - AutoVault";
    ViewData["BodyClass"] = "account-page-body";
}

<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">My Product Questions</h1>
            <div class="nav-bread-crumb">
                <a asp-action="Index">Account</a>
                <a href="#" class="current">Product Questions</a>
            </div>
        </div>
    </div>
</div>

<div class="rts-contact-page-form-area rts-section-gapNew account">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-md-5 col-lg-4">
                <partial name="_AccountNavigation" />
            </div>
            <div class="col-12 col-md-7 col-lg-8">
                <div class="mian-wrapper-form">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                        <h3 class="title mb-0">Spare-part questions</h3>
                        <a asp-controller="Shop" asp-action="Index" class="rts-btn btn-primary radius-small">Browse parts</a>
                    </div>
                    <p class="text-muted mb-4">Questions you sent from product pages appear here once linked to this account. Store replies show when the team answers.</p>

                    @if (Model.Count == 0)
                    {
                        <div class="account-empty-state text-center">
                            <i class="fa-regular fa-circle-question"></i>
                            <h4>No product questions yet</h4>
                            <p>Ask about a spare part on its product page while signed in (or using this account’s email), and it will appear here.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Submitted</th>
                                        <th>Product</th>
                                        <th>Question</th>
                                        <th>Status</th>
                                        <th>Store reply</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var inquiry in Model)
                                {
                                    <tr>
                                        <td>@inquiry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                        <td>
                                            @if (inquiry.Product != null)
                                            {
                                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@inquiry.ProductId">@inquiry.Product.Name</a>
                                            }
                                            else
                                            {
                                                @($"Product {inquiry.ProductId}")
                                            }
                                        </td>
                                        <td style="max-width:280px;white-space:pre-wrap;">@inquiry.Message</td>
                                        <td><strong>@inquiry.StatusLabel</strong></td>
                                        <td style="max-width:280px;white-space:pre-wrap;">@(inquiry.HasReply ? inquiry.AdminReply : "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
