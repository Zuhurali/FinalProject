@model CarEditorViewModel
@{
    ViewData["Title"] = "Add Car - AutoVault";
}

<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Add Your Car</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Add Car</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-section-gap">
    <div class="container">
        <div class="contact-form">
            <h3 class="text-center mb-4">List Your Vehicle</h3>
            @if (ViewData["AccountServiceUnavailable"] != null)
            {
                <div class="alert alert-warning">The listing service is temporarily unavailable.</div>
            }
            <form asp-action="AddCar" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form__control mb-3">
                            <select asp-for="Car.BrandId" class="input-form" required>
                                <option value="">Select Make</option>
                                @foreach (var brand in Model.Lookups.Brands)
                                {
                                    <option value="@brand.Id">@brand.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Car.BrandId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form__control mb-3">
                            <input asp-for="Car.Model" class="input-form" placeholder="Model" required>
                            <span asp-validation-for="Car.Model" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form__control mb-3">
                            <select asp-for="Car.CategoryId" class="input-form" required>
                                <option value="">Select Category</option>
                                @foreach (var category in Model.Lookups.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form__control mb-3">
                            <input asp-for="Car.Year" class="input-form" placeholder="Year" required>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6"><div class="form__control mb-3"><input asp-for="Car.Price" class="input-form" placeholder="Price" required></div></div>
                    <div class="col-md-6"><div class="form__control mb-3"><input asp-for="Car.Mileage" class="input-form" placeholder="Mileage" required></div></div>
                    <div class="col-md-4"><div class="form__control mb-3"><input asp-for="Car.FuelType" class="input-form" placeholder="Fuel Type" required></div></div>
                    <div class="col-md-4"><div class="form__control mb-3"><input asp-for="Car.Transmission" class="input-form" placeholder="Transmission" required></div></div>
                    <div class="col-md-4"><div class="form__control mb-3"><input asp-for="Car.Color" class="input-form" placeholder="Color" required></div></div>
                </div>
                <div class="form__control mb-3">
                    <input asp-for="Car.ImageUrl" class="input-form" placeholder="Image path or URL" required>
                    <small>Use a valid existing AutoVault asset path or image URL.</small>
                </div>
                <div class="form__control mb-3">
                    <textarea asp-for="Car.Description" class="input-form" rows="5" placeholder="Description" required></textarea>
                </div>
                <div class="form__control">
                    <button type="submit" class="submit__btn w-100">Submit Listing</button>
                </div>
            </form>
        </div>
    </div>
</section>