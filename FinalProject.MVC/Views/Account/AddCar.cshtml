@model CarEditorViewModel
@{
    ViewData["Title"] = "Add Car - AutoVault";
}

<link rel="stylesheet" href="~/css/car-listing-form.css" asp-append-version="true">

<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Add Your Car</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Add Car</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-section-gap">
    <div class="container">
        <div class="contact-form av-listing-card">
            <h3 class="mb-4">List Your Vehicle</h3>
            @if (ViewData["AccountServiceUnavailable"] != null)
            {
                <div class="alert alert-warning">The listing service is temporarily unavailable.</div>
            }
            <form asp-action="AddCar" method="post" enctype="multipart/form-data" class="av-listing-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <partial name="_VehicleListingFields" model="Model" />
                <div class="form__control">
                    <button type="submit" class="submit__btn w-100">Submit Listing</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/car-color-picker.js" asp-append-version="true"></script>
    <script src="~/js/car-body-parts.js" asp-append-version="true"></script>
    <partial name="~/Views/AdminCars/_CarImagePickerScripts.cshtml" />
}
