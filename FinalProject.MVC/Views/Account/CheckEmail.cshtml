@{
    ViewData["Title"] = "Check Your Email - AutoVault";
    var configured = ViewData["EmailConfigured"] as bool? == true;
    var email = ViewData["Email"] as string;
}
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Check Your Email</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Account" asp-action="SignIn">Sign In</a>
                <a href="#" class="current">Check Your Email</a>
            </div>
        </div>
    </div>
</div>
<section class="rts-section-gap">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="contact-form">
                    <h3 class="text-center mb-4">Confirm your account</h3>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success" role="alert">@TempData["Success"]</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <p>Check <strong>@email</strong> and confirm your AutoVault account. You can sign in after the email address is confirmed.</p>
                    }
                    else
                    {
                        <p>If an account with that email address is waiting for confirmation, check your inbox and confirm your AutoVault account before signing in.</p>
                    }
                    @if (!configured)
                    {
                        <div class="alert alert-warning">Email delivery is not configured. No confirmation email was sent.</div>
                        @if (ViewData["DevelopmentConfirmationLink"] != null)
                        {
                            <p>This development confirmation link is shown only for the account you just registered:</p>
                            <p><a href="@ViewData["DevelopmentConfirmationLink"]">Confirm this account</a></p>
                        }
                    }
                    <p class="mt-3"><a asp-action="ResendConfirmation">Resend confirmation email</a></p>
                    <p><a asp-action="SignIn">Back to sign in</a></p>
                </div>
            </div>
        </div>
    </div>
</section>
