@{
    ViewData["Title"] = "Check Your Email - AutoVault";
    var configured = ViewData["EmailConfigured"] as bool? == true;
    var externalConfigured = ViewData["ExternalProviderConfigured"] as bool? == true;
    var externalDelivered = ViewData["ExternalEmailDelivered"] as bool? == true;
    var email = ViewData["Email"] as string;
}
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Check Your Email</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Account" asp-action="SignIn">Sign In</a>
                <a href="#" class="current">Check Your Email</a>
            </div>
        </div>
    </div>
</div>
<section class="rts-section-gap">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="contact-form">
                    <h3 class="text-center mb-4">Confirm your account</h3>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success" role="alert">@TempData["Success"]</div>
                    }

                    @if (externalDelivered)
                    {
                        <div class="alert alert-success" role="alert">
                            Confirmation email was sent to
                            @if (!string.IsNullOrWhiteSpace(email))
                            {
                                <strong>@email</strong>
                            }
                            else
                            {
                                <span>your registered address</span>
                            }
                            .
                            Open that inbox (and spam/junk).
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            <p>Confirmation is for <strong>@email</strong>. Confirm that inbox before signing in.</p>
                        }

                        @if (externalConfigured && TempData["Error"] == null && TempData["Success"] == null)
                        {
                            <div class="alert alert-warning" role="alert">
                                External email delivery was not confirmed for this attempt. Try Resend confirmation.
                            </div>
                        }
                    }

                    @if (!configured && !externalDelivered)
                    {
                        <div class="alert alert-warning">Email delivery is not configured. No confirmation email was sent.</div>
                    }

                    <p class="mt-3"><a asp-action="ResendConfirmation">Resend confirmation email</a></p>
                    <p><a asp-action="SignIn" asp-route-email="@email">Back to sign in</a></p>
                </div>
            </div>
        </div>
    </div>
</section>
