@{
    ViewData["Title"] = "Check Your Email - AutoVault";
    var configured = ViewData["EmailConfigured"] as bool? == true;
}
<div class="rts-breadcrumb-area service jarallax">
    <div class="container"><div class="breadcrumb-area-wrapper"><h1 class="title">Check Your Email</h1></div></div>
</div>
<section class="rts-section-gap">
    <div class="container">
        <div class="row justify-content-center"><div class="col-lg-6 contact-form">
            @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
            @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
            @if (configured)
            {
                <p>Check your email to confirm your account. After confirmation, you can sign in.</p>
            }
            else
            {
                <div class="alert alert-warning">Email delivery is not configured. No confirmation email was sent.</div>
                @if (ViewData["DevelopmentConfirmationLink"] != null)
                {
                    <p>Development confirmation link:</p>
                    <p><a href="@ViewData["DevelopmentConfirmationLink"]">Confirm this account</a></p>
                }
            }
            <form asp-action="ResendConfirmation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@ViewData["Email"]">
                <button class="submit__btn" type="submit">Resend confirmation email</button>
            </form>
            <p class="mt-3"><a asp-action="SignIn">Back to sign in</a></p>
        </div></div>
    </div>
</section>
