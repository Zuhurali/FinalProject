@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password - AutoVault";
    ViewData["BodyClass"] = "account-page-body";
}

<div class="rts-breadcrumb-area service jarallax">
    <div class="container"><div class="breadcrumb-area-wrapper">
        <h1 class="title">Change Password</h1>
        <div class="nav-bread-crumb"><a asp-action="Index">Account</a><a href="#" class="current">Change Password</a></div>
    </div></div>
</div>

<div class="rts-contact-page-form-area rts-section-gapNew account">
    <div class="container"><div class="row g-4 g-lg-5">
        <div class="col-12 col-md-5 col-lg-4"><partial name="_AccountNavigation" /></div>
        <div class="col-12 col-md-7 col-lg-8">
            <div class="mian-wrapper-form">
                <h3 class="title mb-4">Update Password</h3>
                @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <label asp-for="CurrentPassword"></label>
                    <input asp-for="CurrentPassword" autocomplete="current-password">
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    <label asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" autocomplete="new-password">
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password">
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    <button type="submit" class="rts-btn btn-primary radius-small mt-3">Change Password</button>
                </form>
                <p class="mt-3"><a asp-action="Profile">Back to profile</a></p>
            </div>
        </div>
    </div></div>
</div>
