@model CarEditorViewModel
@{
    ViewData["Title"] = "Edit Listing - AutoVault";
}

<link rel="stylesheet" href="~/css/car-listing-form.css" asp-append-version="true">

<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Edit Listing</h1>
            <div class="nav-bread-crumb">
                <a asp-action="Index">Account</a>
                <a asp-action="Listings" class="current">My Listings</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-section-gap">
    <div class="container">
        <div class="contact-form av-listing-card">
            <h3 class="mb-4">Update Your Vehicle</h3>
            <form asp-action="EditListing" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="av-listing-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <partial name="_VehicleListingFields" model="Model" />
                <div class="d-flex flex-column flex-sm-row gap-3">
                    <button type="submit" class="submit__btn">Save Changes</button>
                    <a asp-action="Listings" class="rts-btn btn-border radius-small">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/car-color-picker.js" asp-append-version="true"></script>
    <script src="~/js/car-body-parts.js" asp-append-version="true"></script>
    <partial name="~/Views/AdminCars/_CarImagePickerScripts.cshtml" />
}
