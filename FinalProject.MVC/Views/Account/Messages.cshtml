@model AccountMessagesViewModel
@{
    ViewData["Title"] = "Messages - AutoVault";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="rts-breadcrumb-area service jarallax">
    <div class="container"><div class="breadcrumb-area-wrapper">
        <h1 class="title">Messages</h1>
        <div class="nav-bread-crumb"><a asp-action="Index">Account</a><a href="#" class="current">Messages</a></div>
    </div></div>
</div>

<div class="rts-contact-page-form-area rts-section-gapNew account">
    <div class="container"><div class="row g-5">
        <div class="col-lg-3"><partial name="_AccountNavigation" /></div>
        <div class="col-lg-9">
            <h3 class="title mb-4">Conversations</h3>
            <div class="alert alert-danger" id="conversation-list-error" hidden></div>
            @if (ViewData["AccountServiceUnavailable"] != null)
            {
                <div class="alert alert-warning">Messages are temporarily unavailable.</div>
            }
            else
            {
                <div class="account-empty-state text-center" id="conversation-empty" @(Model.Conversations.Count == 0 ? null : "hidden")>
                    <i class="fa-regular fa-envelope"></i><h4>No messages yet.</h4>
                    <p>Buyer inquiries about cars and your listing conversations will appear here.</p>
                </div>
                <div class="conversation-list" id="conversation-list" data-current-user-id="@currentUserId" @(Model.Conversations.Count == 0 ? "hidden" : null)>
                    @foreach (var conversation in Model.Conversations)
                    {
                        <div class="conversation-row @(conversation.UnreadCount > 0 ? "unread" : null)" data-conversation-id="@conversation.Id">
                            <a asp-action="Conversation" asp-route-id="@conversation.Id" class="conversation-row__link">
                                @if (!string.IsNullOrWhiteSpace(conversation.CarImageUrl))
                                {
                                    <img src="@Url.Content(conversation.CarImageUrl)" alt="@conversation.CarName">
                                }
                                <div class="conversation-content">
                                    <div class="d-flex justify-content-between gap-3">
                                        <h5>@conversation.CarName</h5>
                                        <time datetime="@conversation.UpdatedAt.ToString("o")">@conversation.UpdatedAt.ToLocalTime().ToString("g")</time>
                                    </div>
                                    <p><strong>With:</strong> <span data-other-name>@conversation.OtherUserDisplayName</span></p>
                                    <p class="last-message" data-last-message>@conversation.LastMessage</p>
                                </div>
                                @if (conversation.UnreadCount > 0)
                                {
                                    <span class="unread-count" data-unread>@conversation.UnreadCount</span>
                                }
                            </a>
                            <button type="button"
                                    class="conversation-delete"
                                    data-hide-url="@Url.Action("HideConversation", "Account", new { id = conversation.Id })"
                                    data-conversation-id="@conversation.Id"
                                    title="Remove from your messages"
                                    aria-label="Delete conversation from your list">
                                <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                </div>
                <form id="conversation-list-antiforgery" class="d-none">
                    @Html.AntiForgeryToken()
                </form>
            }
        </div>
    </div></div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/messages-list.js" asp-append-version="true"></script>
}

<style>
    .conversation-row { display:flex; align-items:center; gap:12px; padding:18px; border:1px solid #ececec; border-radius:12px; color:inherit; margin-bottom:14px; background:#fff; }
    .conversation-row.unread { border-left:4px solid var(--color-primary); background:#fff8f5; }
    .conversation-row__link { display:flex; align-items:center; gap:18px; flex:1; min-width:0; color:inherit; text-decoration:none; }
    .conversation-row img { width:100px; height:75px; object-fit:cover; border-radius:8px; }
    .conversation-content { flex:1; min-width:0; }
    .conversation-content h5,.conversation-content p { margin-bottom:5px; }
    .conversation-content time { font-size:13px; white-space:nowrap; color:var(--color-body); }
    .last-message { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .unread-count { display:grid; place-items:center; width:26px; height:26px; border-radius:50%; background:var(--color-primary); color:#fff; flex-shrink:0; }
    .conversation-delete { border:1px solid #ececec; background:#fff; color:var(--color-primary); width:42px; height:42px; border-radius:10px; display:grid; place-items:center; cursor:pointer; flex-shrink:0; }
    .conversation-delete:hover { background:var(--color-primary); color:#fff; border-color:var(--color-primary); }
    .conversation-delete:disabled { opacity:.55; cursor:wait; }
    .account-empty-state { padding:55px 25px; border:1px dashed #d8d8d8; border-radius:12px; }
    .account-empty-state i { color:var(--color-primary); font-size:42px; margin-bottom:15px; }
</style>
