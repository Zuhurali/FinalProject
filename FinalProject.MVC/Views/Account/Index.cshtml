@{
    ViewData["Title"] = "Account - AutoVault";
}

<!-- Content based on account.html -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">My Account</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Account</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-section-gap">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-3">
                <div class="account-sidebar">
                    <h4>Account Menu</h4>
                    <ul class="account-menu">
                        <li><a href="#" class="active">Dashboard</a></li>
                        <li><a href="#">My Listings</a></li>
                        <li><a href="#">Favorites</a></li>
                        <li><a href="#">Messages</a></li>
                        <li><a href="#">Profile Settings</a></li>
                        <li><a asp-controller="Account" asp-action="SignIn">Sign Out</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="account-content">
                    <h3>Account Dashboard</h3>
                    <div class="account-stats">
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="stat-box">
                                    <h4>3</h4>
                                    <p>Active Listings</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-box">
                                    <h4>12</h4>
                                    <p>Favorites</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-box">
                                    <h4>5</h4>
                                    <p>Messages</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="recent-activity">
                        <h4>Recent Activity</h4>
                        <ul>
                            <li>You added a new listing for "BMW X5 SUV"</li>
                            <li>Someone favorited your "Mercedes E-Class" listing</li>
                            <li>You received a message about your listing</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>