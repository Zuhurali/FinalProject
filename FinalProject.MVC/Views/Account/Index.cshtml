@model AccountDashboardViewModel
@{
    ViewData["Title"] = $"{Model.DisplayName} - AutoVault";
    ViewData["BodyClass"] = "account-page-body";
}

<!-- rts breadcrumb area start -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">@Model.DisplayName</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">@Model.DisplayName</a>
            </div>
        </div>
    </div>
</div>
<!-- rts breadcrumb area end -->

<div class="rts-contact-page-form-area rts-section-gapNew rts-section-gap account">
    <div class="container">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="alert">@TempData["Success"]</div>
        }

        <div class="row g-4 g-lg-5 account-shell-row">
            <div class="col-12 col-md-5 col-lg-4">
                <partial name="_AccountNavigation" />
            </div>
            <div class="col-12 col-md-7 col-lg-8">
                <div class="mian-wrapper-form">
                    <div class="title-mid-wrapper-home-two">
                        <h3 class="title">Welcome, @Model.DisplayName</h3>
                    </div>
                    @if (ViewData["AccountServiceUnavailable"] != null)
                    {
                        <div class="alert alert-warning">Account statistics are temporarily unavailable.</div>
                    }
                    <div class="row g-4 text-center">
                        <div class="col-md-4">
                            <a asp-action="Listings" class="account-stat-card">
                                <i class="fa-solid fa-car"></i>
                                <h3 class="title">@Model.Summary.ActiveListings</h3>
                                <p>Active Listings</p>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-action="Favorites" class="account-stat-card">
                                <i class="fa-regular fa-heart"></i>
                                <h3 class="title">@Model.Summary.Favorites</h3>
                                <p>Favorites</p>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-action="Messages" class="account-stat-card">
                                <i class="fa-regular fa-envelope"></i>
                                <h3 class="title">@Model.Summary.UnreadMessages</h3>
                                <p>Unread Messages</p>
                            </a>
                        </div>
                    </div>
                    <div class="title-mid-wrapper-home-two mt--40 d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <h3 class="title mb-0">Recent Activity</h3>
                        <button type="button"
                                class="rts-btn btn-primary radius-small"
                                id="clear-activity-btn"
                                data-clear-url="@Url.Action("ClearActivity", "Account")"
                                @(Model.Summary.RecentActivity.Count == 0 ? "hidden" : null)>
                            Clear All
                        </button>
                    </div>
                    <div class="alert alert-danger" id="activity-error" hidden></div>
                    <div class="account-empty-state" id="activity-empty" @(Model.Summary.RecentActivity.Count == 0 ? null : "hidden")>
                        <i class="fa-regular fa-clock"></i>
                        <p>No recent activity yet.</p>
                    </div>
                    <ul class="account-activity-list" id="activity-list" @(Model.Summary.RecentActivity.Count == 0 ? "hidden" : null)>
                        @foreach (var activity in Model.Summary.RecentActivity)
                        {
                            var key = string.IsNullOrWhiteSpace(activity.Key)
                                ? FinalProject.MVC.Services.AccountActivityHistory.BuildKey(activity.Type, activity.Url, activity.CreatedAt)
                                : activity.Key;
                            <li data-activity-key="@key">
                                <div class="account-activity-main">
                                    @if (!string.IsNullOrWhiteSpace(activity.Url))
                                    {
                                        <a href="@activity.Url">@activity.Description</a>
                                    }
                                    else
                                    {
                                        <span>@activity.Description</span>
                                    }
                                    <time>@activity.CreatedAt.ToLocalTime().ToString("g")</time>
                                </div>
                                <button type="button"
                                        class="account-activity-remove"
                                        data-hide-url="@Url.Action("HideActivity", "Account")"
                                        data-activity-key="@key"
                                        aria-label="Remove this activity">
                                    Remove
                                </button>
                            </li>
                        }
                    </ul>
                    <form id="activity-antiforgery" class="d-none">
                        @Html.AntiForgeryToken()
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/account-activity.js" asp-append-version="true"></script>
    <script>
        (function () {
            var signOutLink = document.getElementById("accountSignOut");
            var signOutForm = document.getElementById("accountSignOutForm");
            if (!signOutLink || !signOutForm) {
                return;
            }

            signOutLink.addEventListener("click", function (event) {
                event.preventDefault();
                signOutForm.submit();
            });
        })();
    </script>
}

<style>
    .account-stat-card { display:block; padding:28px 16px; border:1px solid #ececec; border-radius:12px; color:inherit; background:#fff; height:100%; }
    .account-stat-card i { color:var(--color-primary); font-size:26px; margin-bottom:12px; }
    .account-stat-card p { margin:0; }
    .account-empty-state { padding:34px; text-align:center; border:1px dashed #d8d8d8; border-radius:12px; }
    .account-empty-state i { color:var(--color-primary); font-size:28px; margin-bottom:10px; }
    .account-activity-list { list-style:none; padding:0; margin:0; }
    .account-activity-list li { display:flex; justify-content:space-between; align-items:center; gap:15px; padding:14px 0; border-bottom:1px solid #eee; }
    .account-activity-main { display:flex; justify-content:space-between; gap:15px; flex:1; min-width:0; }
    .account-activity-list a,
    .account-activity-list span { color:#333; text-decoration:none; }
    .account-activity-list a:hover,
    .account-activity-list a:focus { color:var(--color-primary); }
    .account-activity-list time { color:var(--color-body); white-space:nowrap; }
    .account-activity-remove { border:0; background:transparent; color:var(--color-body); text-decoration:underline; padding:0; cursor:pointer; white-space:nowrap; }
    .account-activity-remove:hover { color:var(--color-primary); }
</style>
