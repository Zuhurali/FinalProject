<div class="mian-wrapper-form account-nav-card">
    <div class="title-mid-wrapper-home-two">
        <h3 class="title">My Account</h3>
    </div>
    <nav aria-label="Account navigation">
        <ul class="account-menu">
            <li><a asp-action="Index"><i class="fa-solid fa-gauge"></i> Dashboard</a></li>
            <li><a asp-action="Listings"><i class="fa-solid fa-car"></i> My Listings</a></li>
            <li><a asp-action="Favorites"><i class="fa-regular fa-heart"></i> Favorites</a></li>
            <li><a asp-action="Messages"><i class="fa-regular fa-envelope"></i> Messages</a></li>
            <li><a asp-action="Profile"><i class="fa-regular fa-user"></i> Profile Settings</a></li>
            @if (User.IsInRole("Admin"))
            {
                <li><a asp-controller="AdminRatings" asp-action="Index"><i class="fa-solid fa-star"></i> Manage Ratings</a></li>
            }
            <li>
                <form asp-action="SignOut" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="account-nav-logout">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
                    </button>
                </form>
            </li>
        </ul>
    </nav>
</div>

<style>
    .account-nav-card .account-menu { list-style:none; padding:0; margin:0; }
    .account-nav-card .account-menu li { border-bottom:1px solid #eee; }
    .account-nav-card .account-menu a,
    .account-nav-logout { display:flex; align-items:center; gap:10px; width:100%; padding:13px 4px; color:var(--color-body); background:none; border:0; text-align:left; }
    .account-nav-card .account-menu a:hover,
    .account-nav-logout:hover { color:var(--color-primary); }
    .account-nav-card i { width:18px; color:var(--color-primary); }
</style>
