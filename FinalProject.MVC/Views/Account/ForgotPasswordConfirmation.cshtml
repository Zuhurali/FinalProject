@{
    ViewData["Title"] = "Check Your Email - AutoVault";
    var configured = ViewData["EmailConfigured"] as bool? == true;
}
<div class="rts-breadcrumb-area service jarallax">
    <div class="container"><div class="breadcrumb-area-wrapper"><h1 class="title">Check Your Email</h1></div></div>
</div>
<section class="rts-section-gap">
    <div class="container">
        <div class="row justify-content-center"><div class="col-lg-6 contact-form">
            @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
            @if (configured)
            {
                <p>If an account exists for that email address, a password reset message has been sent. Follow the link in the email to choose a new password.</p>
            }
            else
            {
                <div class="alert alert-warning">Email delivery is not configured. No password-reset email was sent.</div>
                @if (ViewData["DevelopmentResetLink"] != null)
                {
                    <p>Development reset link (only shown when a matching account exists):</p>
                    <p><a href="@ViewData["DevelopmentResetLink"]">Reset this account password</a></p>
                }
                else
                {
                    <p>If an account exists for that address, a development reset link would appear here when email is not configured.</p>
                }
            }
            <p class="mt-3"><a asp-action="SignIn">Back to sign in</a></p>
            <p><a asp-action="ForgotPassword">Try another email</a></p>
        </div></div>
    </div>
</section>
