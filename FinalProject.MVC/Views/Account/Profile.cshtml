@model AccountProfileViewModel
@{
    ViewData["Title"] = "Profile Settings - AutoVault";
    ViewData["BodyClass"] = "account-page-body";
}

<div class="rts-breadcrumb-area service jarallax">
    <div class="container"><div class="breadcrumb-area-wrapper">
        <h1 class="title">Profile Settings</h1>
        <div class="nav-bread-crumb"><a asp-action="Index">Account</a><a href="#" class="current">Profile</a></div>
    </div></div>
</div>

<div class="rts-contact-page-form-area rts-section-gapNew account">
    <div class="container"><div class="row g-4 g-lg-5">
        <div class="col-12 col-md-5 col-lg-4"><partial name="_AccountNavigation" /></div>
        <div class="col-12 col-md-7 col-lg-8">
            <div class="mian-wrapper-form">
                <h3 class="title mb-4">Personal Information</h3>
                @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row">
                        <div class="col-md-6"><input asp-for="FirstName" placeholder="First Name"><span asp-validation-for="FirstName" class="text-danger"></span></div>
                        <div class="col-md-6"><input asp-for="LastName" placeholder="Last Name"><span asp-validation-for="LastName" class="text-danger"></span></div>
                    </div>
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" readonly>
                    <label asp-for="PhoneNumber">Phone</label>
                    <input asp-for="PhoneNumber" placeholder="Phone Number">
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    <button type="submit" class="rts-btn btn-primary radius-small mt-3">Save Profile</button>
                </form>
                <p class="mt-4 mb-0"><a asp-action="ChangePassword">Change password</a></p>

                @if (ViewData["ShowDeleteAccount"] as bool? == true)
                {
                    var deleteModel = ViewData["DeleteAccount"] as DeleteAccountViewModel ?? new DeleteAccountViewModel();
                    var deleteAttempted = ViewData["DeleteAccountAttempted"] as bool? == true;
                    var deleteErrors = ViewData.ModelState
                        .Where(entry => entry.Key is nameof(DeleteAccountViewModel.CurrentPassword)
                            or nameof(DeleteAccountViewModel.ConfirmDeactivation)
                            or "")
                        .SelectMany(entry => entry.Value!.Errors)
                        .Select(error => error.ErrorMessage)
                        .Where(message => !string.IsNullOrWhiteSpace(message))
                        .Distinct()
                        .ToList();
                    <div class="account-delete-section mt-5 pt-4" style="border-top:1px solid #eee;">
                        <h3 class="title mb-2">Delete Account</h3>
                        <p class="mb-3">
                            Deactivating your account permanently disables sign-in for this Member profile.
                            Your listings, conversations, messages, contact requests, purchase requests, favorites,
                            and other historical records are kept and are not deleted.
                        </p>
                        @if (deleteAttempted && deleteErrors.Count > 0)
                        {
                            <div class="alert alert-danger" role="alert" id="deleteAccountErrors">
                                @foreach (var message in deleteErrors)
                                {
                                    <div>@message</div>
                                }
                            </div>
                        }
                        <details class="account-delete-confirm" @(deleteAttempted ? "open" : null)>
                            <summary class="rts-btn btn-border radius-small" style="display:inline-flex;cursor:pointer;list-style:none;">
                                Delete Account
                            </summary>
                            <form asp-controller="Account" asp-action="DeleteAccount" method="post" class="mt-3" style="max-width:28rem;">
                                <p class="mb-3">
                                    Enter your current password and check the confirmation box. After deactivation you will be signed out
                                    and will no longer be able to log in.
                                </p>
                                <label for="deleteCurrentPassword">Current password</label>
                                <input id="deleteCurrentPassword"
                                       name="CurrentPassword"
                                       type="password"
                                       value=""
                                       autocomplete="current-password"
                                       required
                                       style="height:50px;" />
                                <span class="text-danger field-validation-error">@Html.ValidationMessage("CurrentPassword", "", new { @class = "text-danger" })</span>
                                <div class="mt-3 mb-3" style="display:flex;align-items:flex-start;gap:10px;">
                                    <input id="ConfirmDeactivation"
                                           name="ConfirmDeactivation"
                                           type="checkbox"
                                           value="true"
                                           required
                                           style="width:18px;height:18px;margin-top:4px;flex:0 0 18px;"
                                           @(deleteModel.ConfirmDeactivation ? "checked" : null) />
                                    <label for="ConfirmDeactivation" style="margin:0;line-height:1.4;">
                                        I understand my account will be deactivated and I will no longer be able to sign in.
                                    </label>
                                </div>
                                <span class="text-danger field-validation-error">@Html.ValidationMessage("ConfirmDeactivation", "", new { @class = "text-danger" })</span>
                                <button type="submit" class="rts-btn btn-primary radius-small mt-2" style="background:#b91c1c;border-color:#b91c1c;">
                                    Confirm account deactivation
                                </button>
                            </form>
                        </details>
                    </div>
                }
            </div>
        </div>
    </div></div>
</div>
