@model IReadOnlyList<ProductInquiry>
@{
    Layout = "_AdminLayout";
    var statusFilter = ViewBag.StatusFilter as string;
    var statuses = (IReadOnlyList<string>)ViewBag.Statuses;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="h3 mb-0">Product questions</h1>
    <form method="get" class="d-flex gap-2 align-items-center">
        <label class="form-label mb-0 small text-muted" for="inq-status-filter">Status</label>
        <select id="inq-status-filter" name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (var status in statuses)
            {
                <option value="@status" selected="@(string.Equals(status, statusFilter, StringComparison.OrdinalIgnoreCase))">@status</option>
            }
        </select>
    </form>
</div>

<div class="admin-card">
    <p>Customers send these from a product page. They are questions about availability or fitment, not orders or payments. Customer emails are Admin/SuperAdmin only.</p>
    @if (Model.Count == 0)
    {
        <p>No questions@(string.IsNullOrEmpty(statusFilter) ? "" : $" with status {statusFilter}") yet.</p>
    }
    else
    {
        <table class="table align-top" id="inquiries-table">
            <thead>
                <tr>
                    <th style="width:120px">When</th>
                    <th>Product</th>
                    <th>Customer</th>
                    <th>Question</th>
                    <th style="width:100px">Status</th>
                    <th style="width:200px"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var inquiry in Model)
            {
                <tr id="inq-row-@inquiry.Id" data-inquiry-id="@inquiry.Id">
                    <td class="text-nowrap">@inquiry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td>@(inquiry.Product?.Name ?? $"Product {inquiry.ProductId}")</td>
                    <td>
                        @inquiry.CustomerName<br />
                        <a href="mailto:@inquiry.Email">@inquiry.Email</a>
                        @if (!string.IsNullOrWhiteSpace(inquiry.Phone))
                        {
                            <br /><a href="tel:@inquiry.Phone">@inquiry.Phone</a>
                        }
                    </td>
                    <td>
                        <p style="white-space:pre-wrap;margin:0">@inquiry.Message</p>

                        <div id="inq-reply-display-@inquiry.Id"
                             class="mt-2 p-2 border-start border-3 border-success bg-light"
                             @(inquiry.HasReply ? "" : "hidden")>
                            <small class="text-muted d-block mb-1">
                                AutoVault Support
                                @if (inquiry.AdminRepliedAt.HasValue)
                                {
                                    <span>· @inquiry.AdminRepliedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                }
                            </small>
                            <p id="inq-reply-text-@inquiry.Id" style="white-space:pre-wrap;margin:0">@inquiry.AdminReply</p>
                        </div>

                        <div id="inq-editor-@inquiry.Id" hidden class="mt-2">
                            <input type="hidden" id="inq-reply-original-@inquiry.Id" value="@inquiry.AdminReply" />
                            <textarea id="inq-textarea-@inquiry.Id"
                                      class="form-control"
                                      rows="4"
                                      maxlength="2000"
                                      placeholder="Write your reply (max 2 000 characters)…">@inquiry.AdminReply</textarea>
                            <p id="inq-editor-error-@inquiry.Id" class="text-danger small mt-1" hidden></p>
                            <div class="mt-1 d-flex gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-success inq-send-btn"
                                        data-id="@inquiry.Id">Send Reply</button>
                                <button type="button"
                                        class="btn btn-sm btn-link p-0 inq-cancel-btn"
                                        data-id="@inquiry.Id">Cancel</button>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span id="inq-status-@inquiry.Id"
                              class="badge @(inquiry.StatusLabel == ProductInquiry.LabelAnswered ? "bg-success" : inquiry.StatusLabel == ProductInquiry.LabelClosed ? "bg-secondary" : inquiry.StatusLabel == ProductInquiry.LabelAwaitingFollowUp ? "bg-info text-dark" : "bg-warning text-dark")">
                            @inquiry.StatusLabel
                        </span>
                        <p id="inq-flash-@inquiry.Id" class="small mt-2 mb-0" hidden></p>
                    </td>
                    <td class="d-flex flex-column gap-1">
                        <button type="button"
                                class="btn btn-sm btn-outline-primary inq-reply-btn"
                                data-id="@inquiry.Id">
                            @(inquiry.HasReply ? "Edit Reply" : "Reply")
                        </button>

                        <form asp-action="Handled" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@inquiry.Id" />
                            <input type="hidden" name="handled" class="inq-handled-value" data-id="@inquiry.Id" value="@(!inquiry.IsHandled ? "true" : "false")" />
                            <button type="submit" class="btn btn-sm btn-outline-dark w-100 inq-handled-btn" data-id="@inquiry.Id">
                                @(inquiry.IsHandled ? "Reopen" : "Mark Closed")
                            </button>
                        </form>

                        <form asp-action="Delete"
                              asp-route-id="@inquiry.Id"
                              method="post"
                              class="m-0"
                              onsubmit="return confirm('Permanently delete this product question? The product and customer account will not be deleted.');">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger w-100"
                                    aria-label="Delete product question @inquiry.Id">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@section Scripts {
<script>
(function () {
    function getAFToken() {
        const field = document.querySelector('input[name="__RequestVerificationToken"]');
        return field ? field.value : '';
    }

    document.querySelectorAll('.inq-reply-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const id = btn.dataset.id;
            document.getElementById('inq-editor-' + id).hidden = false;
            const ta = document.getElementById('inq-textarea-' + id);
            ta.focus();
            ta.setSelectionRange(ta.value.length, ta.value.length);
        });
    });

    document.querySelectorAll('.inq-cancel-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const id = btn.dataset.id;
            document.getElementById('inq-editor-' + id).hidden = true;
            const original = document.getElementById('inq-reply-original-' + id);
            document.getElementById('inq-textarea-' + id).value = original ? original.value : '';
            const errEl = document.getElementById('inq-editor-error-' + id);
            errEl.hidden = true;
            errEl.textContent = '';
        });
    });

    document.querySelectorAll('.inq-send-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            const id = btn.dataset.id;
            const ta = document.getElementById('inq-textarea-' + id);
            const errEl = document.getElementById('inq-editor-error-' + id);
            const reply = ta.value.trim();

            if (reply.length === 0) {
                errEl.textContent = 'Reply cannot be empty.';
                errEl.hidden = false;
                ta.focus();
                return;
            }
            if (reply.length > 2000) {
                errEl.textContent = 'Reply cannot exceed 2 000 characters.';
                errEl.hidden = false;
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Saving…';
            errEl.hidden = true;

            try {
                const formData = new FormData();
                formData.append('id', id);
                formData.append('reply', reply);
                formData.append('__RequestVerificationToken', getAFToken());

                const response = await fetch('@Url.Action("Reply", "AdminInquiries")', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (!response.ok || !data.ok) {
                    errEl.textContent = data.error || 'Could not save the reply.';
                    errEl.hidden = false;
                    return;
                }

                const displayEl = document.getElementById('inq-reply-display-' + id);
                const textEl = document.getElementById('inq-reply-text-' + id);
                textEl.textContent = data.reply ?? reply;
                const original = document.getElementById('inq-reply-original-' + id);
                if (original) original.value = data.reply ?? reply;
                displayEl.hidden = false;

                const statusEl = document.getElementById('inq-status-' + id);
                statusEl.textContent = data.statusLabel ?? 'Answered';
                statusEl.className = 'badge bg-success';

                const replyBtn = document.querySelector('.inq-reply-btn[data-id="' + id + '"]');
                if (replyBtn) replyBtn.textContent = 'Edit Reply';
                const handledBtn = document.querySelector('.inq-handled-btn[data-id="' + id + '"]');
                const handledValue = document.querySelector('.inq-handled-value[data-id="' + id + '"]');
                if (handledBtn) handledBtn.textContent = 'Mark Closed';
                if (handledValue) handledValue.value = 'true';

                document.getElementById('inq-editor-' + id).hidden = true;

                ta.value = data.reply ?? reply;

                const flash = document.getElementById('inq-flash-' + id);
                if (flash) {
                    flash.hidden = false;
                    flash.className = 'small mt-2 mb-0 text-success';
                    flash.textContent = 'Reply saved.';
                }

            } catch (err) {
                errEl.textContent = 'Network error. Your reply was not saved — please try again.';
                errEl.hidden = false;
            } finally {
                btn.disabled = false;
                btn.textContent = 'Send Reply';
            }
        });
    });
}());
</script>
}
