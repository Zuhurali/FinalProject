@using FinalProject.MVC.Commerce
@model PartAdminItemDto
@{
    Layout = "_AdminLayout";
    var status = ShowroomRules.StockStatus(Model.Quantity);
    var stockText = Model.Quantity <= 0
        ? "Out of Stock"
        : status == "Low Stock"
            ? $"Low Stock · {Model.Quantity} left"
            : $"In Stock · {Model.Quantity} available";
}
<div class="d-flex justify-content-between mb-4">
    <h1 class="h3">@Model.Name</h1>
    <div>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-link" asp-action="Index">Back</a>
    </div>
</div>
<div class="admin-card">
    <div class="row g-4">
        <div class="col-md-4">
            @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
            {
                <img src="@Url.Content(Model.ImagePath)" alt="@Model.Name" class="img-fluid" />
            }
        </div>
        <div class="col-md-8">
            <dl class="row mb-0">
                <dt class="col-sm-4">Category</dt><dd class="col-sm-8">@Model.Category</dd>
                <dt class="col-sm-4">Brand</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Brand) ? "Not stated" : Model.Brand)</dd>
                <dt class="col-sm-4">Part number / SKU</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.PartNumber) ? "Not stated" : Model.PartNumber)</dd>
                <dt class="col-sm-4">Compatible vehicle</dt>
                <dd class="col-sm-8">
                    @{
                        var vehicle = string.Join(" ", new[] { Model.CarMake, Model.CarModel }.Where(value => !string.IsNullOrWhiteSpace(value)));
                    }
                    @(string.IsNullOrWhiteSpace(vehicle) ? "Not stated" : vehicle)
                </dd>
                <dt class="col-sm-4">Price</dt><dd class="col-sm-8">@Model.Price.ToString("C")</dd>
                <dt class="col-sm-4">Stock quantity</dt><dd class="col-sm-8">@Model.Quantity</dd>
                <dt class="col-sm-4">Stock status</dt><dd class="col-sm-8">@stockText</dd>
                <dt class="col-sm-4">Rating</dt><dd class="col-sm-8">@(Model.RatingCount == 0 ? "No ratings" : $"{Model.Rating:0.0} ({Model.RatingCount})")</dd>
                <dt class="col-sm-4">Catalog</dt><dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd>
                <dt class="col-sm-4">Compatibility</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Compatibility) ? "Not stated" : Model.Compatibility)</dd>
                <dt class="col-sm-4">Description</dt><dd class="col-sm-8">@Model.Description</dd>
            </dl>
        </div>
    </div>
</div>
