@model SavePartDto
@{
    Layout = "_AdminLayout";
    var editing = Model.Id > 0;
}
<h1 class="h3 mb-4">@(editing ? "Edit part" : "Add new part")</h1>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" enctype="multipart/form-data" class="admin-card">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImagePath" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" class="form-control" required maxlength="200" />
        </div>
        <div class="col-md-3">
            <label asp-for="Price">Price</label>
            <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" required />
        </div>
        <div class="col-md-3">
            <label asp-for="Quantity">Stock quantity</label>
            <input asp-for="Quantity" class="form-control" type="number" min="0" step="1" required />
            <div class="form-text">Status is calculated from this number. 0 is out of stock, 1–10 is low stock, and 11 or more is in stock.</div>
        </div>
        <div class="col-md-4">
            <label asp-for="Category">Category</label>
            <input asp-for="Category" class="form-control" required maxlength="100" />
        </div>
        <div class="col-md-4">
            <label asp-for="Brand">Brand</label>
            <input asp-for="Brand" class="form-control" maxlength="100" />
        </div>
        <div class="col-md-4">
            <label asp-for="Compatibility">Compatibility</label>
            <input asp-for="Compatibility" class="form-control" maxlength="300" placeholder="Leave blank when fitment is not known" />
        </div>
        <div class="col-12">
            <label for="image">Product image</label>
            <input id="image" name="image" type="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/*" class="form-control" />
            @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
            {
                <div class="form-text">Current image: @Model.ImagePath</div>
                <img src="@Url.Content(Model.ImagePath)" alt="" width="160" class="mt-2" />
            }
            <span asp-validation-for="ImagePath" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
        </div>
        @if (editing)
        {
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active in the public catalog</label>
                </div>
            </div>
        }
    </div>
    <button class="btn btn-primary mt-3" type="submit">Save</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
