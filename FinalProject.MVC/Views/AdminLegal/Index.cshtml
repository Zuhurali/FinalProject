@model LegalPageContentEditViewModel
@{ Layout = "_AdminLayout"; }
<h1 class="h3 mb-4">Legal Pages</h1>
<form asp-controller="AdminLegal" asp-action="Index" method="post" class="admin-card">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <h2 class="h5">Privacy</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-6"><label asp-for="PrivacyTitle" class="form-label"></label><input asp-for="PrivacyTitle" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="PrivacySeoTitle" class="form-label"></label><input asp-for="PrivacySeoTitle" class="form-control" /></div>
        <div class="col-12"><label asp-for="PrivacySeoDescription" class="form-label"></label><textarea asp-for="PrivacySeoDescription" class="form-control" rows="2"></textarea></div>
        <div class="col-12"><label asp-for="PrivacyBody" class="form-label"></label><textarea asp-for="PrivacyBody" class="form-control" rows="6"></textarea></div>
    </div>
    <h2 class="h5">Terms</h2>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="TermsTitle" class="form-label"></label><input asp-for="TermsTitle" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="TermsSeoTitle" class="form-label"></label><input asp-for="TermsSeoTitle" class="form-control" /></div>
        <div class="col-12"><label asp-for="TermsSeoDescription" class="form-label"></label><textarea asp-for="TermsSeoDescription" class="form-control" rows="2"></textarea></div>
        <div class="col-12"><label asp-for="TermsBody" class="form-label"></label><textarea asp-for="TermsBody" class="form-control" rows="6"></textarea></div>
    </div>
    <button type="submit" class="btn btn-dark mt-3">Save legal content</button>
</form>
