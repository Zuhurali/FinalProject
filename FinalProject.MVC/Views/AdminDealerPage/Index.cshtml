@model DealerPageContentEditViewModel
@{ Layout = "_AdminLayout"; }
<h1 class="h3 mb-4">Dealer List Page</h1>
<form asp-action="Index" method="post" class="admin-card">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="BreadcrumbTitle" class="form-label"></label><input asp-for="BreadcrumbTitle" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="PageTitle" class="form-label"></label><input asp-for="PageTitle" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="SeoTitle" class="form-label"></label><input asp-for="SeoTitle" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="SeoDescription" class="form-label"></label><input asp-for="SeoDescription" class="form-control" /></div>
    </div>
    <button type="submit" class="btn btn-dark mt-3">Save dealer page</button>
</form>
