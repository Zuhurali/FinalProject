@{
    ViewData["Title"] = "Order Confirmation - AutoVault";
    var order = ViewBag.Order ?? Model;
}

<!-- Breadcrumb area start -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Order Confirmation</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Order Confirmation</a>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb area end -->

<section class="rts-section-gap">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <!-- Success Message -->
                <div class="alert alert-success text-center" role="alert">
                    <i class="fa fa-check-circle" style="font-size: 48px; color: #28a745;"></i>
                    <h2 class="mt-3">Thank You for Your Order!</h2>
                    <p class="mb-0">Your order has been received and is being processed.</p>
                </div>

                <!-- Order Details -->
                <div class="order-details-box mt-4">
                    <div class="row">
                        <div class="col-md-6">
                            <h4>Order Information</h4>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Order Number:</strong></td>
                                    <td>#@order.Id</td>
                                </tr>
                                <tr>
                                    <td><strong>Order Date:</strong></td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                </tr>
                                <tr>
                                    <td><strong>Total Amount:</strong></td>
                                    <td><strong>$@order.Total.ToString("0.00")</strong></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h4>Billing Address</h4>
                            <p>
                                @order.FirstName @order.LastName<br />
                                @order.StreetAddress<br />
                                @order.City, @order.District @order.PostCode<br />
                                Phone: @order.PhoneNumber<br />
                                Email: @order.Email
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="order-items-box mt-4">
                    <h4>Order Items</h4>
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in order.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.ImagePath))
                                            {
                                                <img src="@item.ImagePath" alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: cover; margin-right: 15px;" />
                                            }
                                            <span>@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td class="text-center">$@item.Price.ToString("0.00")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-right">$@item.Subtotal.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-right"><strong>Subtotal:</strong></td>
                                <td class="text-right">$@order.Subtotal.ToString("0.00")</td>
                            </tr>
                            @if (order.DiscountAmount > 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-right"><strong>Discount (@order.CouponCode):</strong></td>
                                    <td class="text-right" style="color: #28a745;">-$@order.DiscountAmount.ToString("0.00")</td>
                                </tr>
                            }
                            <tr class="table-active">
                                <td colspan="3" class="text-right"><strong>Total:</strong></td>
                                <td class="text-right"><strong style="font-size: 1.2em; color: #FF3600;">$@order.Total.ToString("0.00")</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Action Buttons -->
                <div class="text-center mt-4">
                    <a asp-controller="Home" asp-action="Index" class="rts-btn btn-primary radius-small">
                        Continue Shopping
                    </a>
                    <button onclick="window.print()" class="rts-btn btn-border radius-small ms-2">
                        Print Order
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<style>
    .order-details-box, .order-items-box {
        background: #f8f9fa;
        padding: 25px;
        border-radius: 8px;
    }
    .table-borderless td {
        padding: 8px 0;
    }
    @@media print {
        .rts-btn, header, footer, .breadcrumb-area {
            display: none !important;
        }
    }
</style>
}
