@model IReadOnlyList<AdminUserViewModel>
@{
    Layout = "_AdminLayout";
    var currentUserId = ViewBag.CurrentUserId as string;
    var editableIndex = 0;
}
<h1 class="h3 mb-4">Users</h1>
<form asp-action="ChangeRoles" method="post">
    @Html.AntiForgeryToken()
    <div class="admin-card">
        <table class="table">
            <thead><tr><th>User</th><th>Email</th><th>Confirmed</th><th>Role</th><th>Registered</th><th></th></tr></thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@(string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email : user.DisplayName)</td>
                    <td>@user.Email</td>
                    <td>@(user.EmailConfirmed ? "Yes" : "No")</td>
                    <td>@user.Role</td>
                    <td>@user.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (user.Id == currentUserId && user.IsSuperAdmin)
                        {
                            <span>SuperAdmin (you)</span>
                        }
                        else
                        {
                            <input type="hidden" name="items[@editableIndex].UserId" value="@user.Id" />
                            <select name="items[@editableIndex].Role" class="form-select form-select-sm" style="max-width:160px">
                                @foreach (var roleName in new[] { "Member", "Admin", "SuperAdmin" })
                                {
                                    if (user.Role == roleName)
                                    {
                                        <option value="@roleName" selected>@roleName</option>
                                    }
                                    else
                                    {
                                        <option value="@roleName">@roleName</option>
                                    }
                                }
                            </select>
                            editableIndex++;
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (editableIndex > 0)
        {
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary" type="submit">Save All Changes</button>
            </div>
        }
    </div>
</form>
