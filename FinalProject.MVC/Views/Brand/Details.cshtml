@model BrandDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Brand.Name} - AutoVault";
}

<style>
    .brand-details-logo {
        max-height: 72px;
        width: auto;
        margin-bottom: 16px;
    }
    .brand-car-grid .home-car-card {
        margin-bottom: 30px;
    }
    .brand-car-grid .home-car-card .image-area {
        position: relative;
        height: 240px;
    }
    .brand-car-grid .home-car-card .image-area > a {
        display: block;
        height: 100%;
    }
    .brand-car-grid .home-car-card .image-area img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .brand-car-grid .home-car-card .price {
        transform: scale(1);
    }
    .brand-car-grid .home-car-badges {
        position: absolute;
        left: 20px;
        bottom: 16px;
        z-index: 2;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-width: calc(100% - 40px);
    }
    .brand-car-grid .home-car-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.04em;
        line-height: 1;
        text-transform: uppercase;
        color: #fff;
    }
    .brand-car-grid .home-car-badge.condition {
        background: #111827;
    }
    .brand-car-grid .home-car-brand {
        position: absolute;
        right: 20px;
        top: 20px;
        z-index: 2;
        padding: 8px 13px;
        border-radius: 30px;
        background: var(--color-primary);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        line-height: 1;
    }
</style>

<div class="rts-breadcrumb-area portfolio jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">@Model.Brand.Name</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Brand" asp-action="Details" asp-route-id="@Model.Brand.Id" class="current">@Model.Brand.Name</a>
            </div>
        </div>
    </div>
</div>

<div class="rts-portfolio-area inner rts-section-gap">
    <div class="container">
        <div class="section-title-area text-center">
            @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
            {
                <img class="brand-details-logo" src="@Url.Content(Model.LogoPath)" alt="@Model.Brand.Name logo">
            }
            <h2 class="section-title">@Model.Brand.Name</h2>
        </div>
        @if (Model.Cars.Count == 0)
        {
            <h3 class="title text-center">No @Model.Brand.Name vehicles are currently listed.</h3>
        }
        else
        {
            <div class="row brand-car-grid">
                @foreach (var car in Model.Cars)
                {
                    <div class="col-lg-4 col-md-6">
                        <partial name="_CatalogCarCard" model="car" />
                    </div>
                }
            </div>
        }
    </div>
</div>
