@model IReadOnlyList<FaqItem>
@{
    Layout = "_AdminLayout";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">FAQ Management</h1>
        <p class="text-muted mb-0">Published items appear on the public FAQ page in sort order.</p>
    </div>
    <a class="btn btn-dark" asp-controller="AdminFaqs" asp-action="Create">Add FAQ</a>
</div>

@if (Model.Count == 0)
{
    <div class="admin-card">
        <p class="mb-0">No FAQ items yet. Create the first question when you are ready — nothing is seeded automatically.</p>
    </div>
}
else
{
    <div class="admin-card table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Question</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Model.Count; index++)
                {
                    var item = Model[index];
                    var canMoveUp = index > 0;
                    var canMoveDown = index < Model.Count - 1;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <form asp-controller="AdminFaqs" asp-action="Move" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="direction" value="-1" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary"
                                            title="Move up"
                                            @(canMoveUp ? null : "disabled")>↑</button>
                                </form>
                                <form asp-controller="AdminFaqs" asp-action="Move" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="direction" value="1" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary"
                                            title="Move down"
                                            @(canMoveDown ? null : "disabled")>↓</button>
                                </form>
                                <span class="ms-1">@item.SortOrder</span>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">@item.Question</div>
                            <div class="text-muted small text-truncate" style="max-width:28rem;">@item.Answer</div>
                        </td>
                        <td>@(item.IsPublished ? "Published" : "Unpublished")</td>
                        <td>@item.UpdatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-dark" asp-controller="AdminFaqs" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <form asp-controller="AdminFaqs" asp-action="Publish" asp-route-id="@item.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="publish" value="@(!item.IsPublished)" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(item.IsPublished ? "Unpublish" : "Publish")
                                </button>
                            </form>
                            <form asp-controller="AdminFaqs" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this FAQ item?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
