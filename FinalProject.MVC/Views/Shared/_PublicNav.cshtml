@model string
@{
    var isMobile = string.Equals(Model, "mobile", StringComparison.OrdinalIgnoreCase);
    var topLinkClass = isMobile ? "main" : "main-menu";
    var itemClass = isMobile ? null : "main-nav";
    var dropdownClass = isMobile ? "has-droupdown" : "main-nav has-dropdown";
    var submenuClass = isMobile ? "submenu mm-collapse" : "submenu parent-nav";
    var pageSubmenuClass = isMobile ? "submenu mm-collapse" : "submenu mega-menu parent-nav";
    var childClass = isMobile ? "mobile-menu-link" : null;
}

<li class="@itemClass">
    <a class="@topLinkClass" asp-controller="Home" asp-action="Index">Dealership</a>
</li>
<li class="@itemClass">
    <a class="@topLinkClass" asp-controller="About" asp-action="Index">About Us</a>
</li>
<li class="@dropdownClass">
    @if (isMobile)
    {
        <a href="#" class="@topLinkClass">Listing</a>
    }
    else
    {
        <a class="@topLinkClass" href="javascript:void(0)">Listing</a>
    }
    <ul class="@submenuClass">
        <li><a class="@childClass" asp-controller="Cars" asp-action="CarsOne">Cars One</a></li>
        <li><a class="@childClass" asp-controller="Cars" asp-action="CarsTwo">Cars Two</a></li>
        <li><a class="@childClass" asp-controller="Cars" asp-action="CarsThree">Cars Three</a></li>
        <li><a class="@childClass" asp-controller="Cars" asp-action="Details" asp-route-id="1">Car Single</a></li>
    </ul>
</li>
<li class="@dropdownClass">
    @if (isMobile)
    {
        <a href="#" class="@topLinkClass">Page</a>
    }
    else
    {
        <a class="@topLinkClass" href="javascript:void(0)">Page</a>
    }
    <ul class="@pageSubmenuClass">
        <li><a class="@childClass" asp-controller="Blog" asp-action="Index">Blog</a></li>
        <li><a class="@childClass" asp-controller="Faq" asp-action="Index">FAQ</a></li>
        <li><a class="@childClass" asp-controller="Calculator" asp-action="Index">Calculator</a></li>
        <li><a class="@childClass" asp-controller="Team" asp-action="Index">Team</a></li>
        <li><a class="@childClass" asp-controller="Account" asp-action="Index">Account</a></li>
    </ul>
</li>
<li class="@itemClass">
    <a class="@topLinkClass" asp-controller="Shop" asp-action="Index">Shop</a>
</li>
<partial name="_ExploreNav" model="@(isMobile ? "mobile" : "desktop")" />
<li class="@itemClass">
    <a class="@topLinkClass" asp-controller="Contact" asp-action="Index">Contact</a>
</li>
