<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content(Site.Current.FaviconPath)">
    <title>@(string.IsNullOrWhiteSpace(ViewData["Title"] as string) ? Site.Current.DefaultSeoTitle : ViewData["Title"])</title>
    <meta name="description" content="@(string.IsNullOrWhiteSpace(ViewData["MetaDescription"] as string) ? Site.Current.DefaultMetaDescription : ViewData["MetaDescription"])">
    
    <!-- Autovault CSS -->
    <link rel="stylesheet" href="~/assets/css/plugins/plugins.css">
    <link rel="stylesheet" href="~/assets/css/plugins/magnifying-popup.css">
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/fonts/rt-icon.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/css/showroom-shop.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/contact-form.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/add-new-dropdown.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <div class="loader-wrapper">
        <div class="loader"></div>
        <div class="loader-section section-left"></div>
        <div class="loader-section section-right"></div>
    </div>
    
    <div id="anywhere-home"></div>
    
    <div class="progress-wrap">
        <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
            <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" style="transition: stroke-dashoffset 10ms linear 0s; stroke-dasharray: 307.919, 307.919; stroke-dashoffset: 307.919;"></path>
        </svg>
    </div>
    
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            @if ((ViewData["HeaderStyle"] as string) == "three")
            {
                <partial name="_HeaderThree" />
            }
            else if ((ViewData["HeaderStyle"] as string) == "five")
            {
                <partial name="_HeaderFive" />
            }
            else if ((ViewData["HeaderStyle"] as string) == "six")
            {
                <partial name="_HeaderSix" />
            }
            else
            {
            <header class="header-one header--sticky">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="header-wrapper-1">
                            <div class="logo-area-start">
                                <a asp-controller="Home" asp-action="Index" class="logo">
                                    <img src="@Url.Content(Site.Current.LogoPath)" alt="@Site.Current.SiteName Logo">
                                </a>
                            </div>
                            <div class="header-right d-block">
                                <div class="top">
                                    <div class="left d-flex align-items-center">
                                        <div class="map-area">
                                            <div class="icon">
                                                <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M15.9688 12.1562L15.2188 15.3125C15.125 15.7812 14.75 16.0938 14.2812 16.0938C6.40625 16.0625 0 9.65625 0 1.78125C0 1.3125 0.28125 0.9375 0.75 0.84375L3.90625 0.09375C4.34375 0 4.8125 0.25 5 0.65625L6.46875 4.0625C6.625 4.46875 6.53125 4.9375 6.1875 5.1875L4.5 6.5625C5.5625 8.71875 7.3125 10.4688 9.5 11.5312L10.875 9.84375C11.125 9.53125 11.5938 9.40625 12 9.5625L15.4062 11.0312C15.8125 11.25 16.0625 11.7188 15.9688 12.1562Z" fill="#FF3600" />
                                                </svg>
                                            </div>
                                            <div class="text">
                                                <p>Call Us Now</p>
                                                <a href="@Site.Contact.TelHref" aria-label="Call AutoVault at @Site.Contact.DisplayPhone">@Site.Contact.DisplayPhone</a>
                                            </div>
                                        </div>
                                        <div class="map-area">
                                            <div class="icon">
                                                <svg width="16" height="12" viewBox="0 0 16 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M14.5 0C15.3125 0 16 0.6875 16 1.5C16 2 15.75 2.4375 15.375 2.71875L8.59375 7.8125C8.21875 8.09375 7.75 8.09375 7.375 7.8125L0.59375 2.71875C0.21875 2.4375 0 2 0 1.5C0 0.6875 0.65625 0 1.5 0H14.5ZM6.78125 8.625C7.5 9.15625 8.46875 9.15625 9.1875 8.625L16 3.5V10C16 11.125 15.0938 12 14 12H2C0.875 12 0 11.125 0 10V3.5L6.78125 8.625Z" fill="#FF3600" />
                                                </svg>
                                            </div>
                                            <div class="text">
                                                <p>Send US Email</p>
                                                <a href="@Site.Contact.MailtoHref">@Site.Contact.Email</a>
                                            </div>
                                        </div>
                                        <div class="map-area">
                                            <div class="icon">
                                                <svg width="12" height="17" viewBox="0 0 12 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M5.25 15.625C3.625 13.5938 0 8.75 0 6C0 2.6875 2.65625 0 6 0C9.3125 0 12 2.6875 12 6C12 8.75 8.34375 13.5938 6.71875 15.625C6.34375 16.0938 5.625 16.0938 5.25 15.625ZM6 8C7.09375 8 8 7.125 8 6C8 4.90625 7.09375 4 6 4C4.875 4 4 4.90625 4 6C4 7.125 4.875 8 6 8Z" fill="#FF3600" />
                                                </svg>
                                            </div>
                                            <div class="text">
                                                <p>Our Location</p>
                                                <a href="@Site.Contact.MapsHref" target="_blank" rel="noopener">@Site.Contact.AddressLine</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="bottom d-flex align-items-center justify-content-between">
                                    <div class="nav-area">
                                        <ul class="">
                                            <partial name="_PublicNav" model="@("desktop")" />
                                        </ul>
                                    </div>
                                    <div class="bottom-right">
                                        <div class="button-area">
                                            <div class="account-notify-wrap">
                                                <partial name="_AccountHeaderButtons" model='@("rts-btn btn-border radius-small icon")' />
                                                @if (User.Identity?.IsAuthenticated == true)
                                                {
                                                    <a asp-controller="Account"
                                                       asp-action="Notifications"
                                                       id="nav-notification-badge"
                                                       class="nav-notification-badge"
                                                       hidden
                                                       title="View notifications"
                                                       aria-label="Unread notifications">0</a>
                                                }
                                            </div>
                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <form asp-controller="Account" asp-action="SignOut" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="rts-btn btn-border radius-small">Sign Out</button>
                                                </form>
                                            }

                                            <partial name="_AddNewDropdown" />
                                        </div>
                                        <div class="menu-btn" id="menu-btn">
                                            <svg width="55" height="55" viewBox="0 0 55 55" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect width="55" height="55" rx="15" fill="#FF3600" />
                                                <rect x="18" y="33" width="10" height="2" fill="#ffffff" />
                                                <rect x="18" y="26" width="20" height="2" fill="#ffffff" />
                                                <rect x="18" y="19" width="10" height="2" fill="#ffffff" />
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            }
            
            @RenderBody()
        </div>
    </div>

    @if ((ViewData["FooterStyle"] as string) == "wash")
    {
        <partial name="_FooterWash" />
    }
    else if ((ViewData["FooterStyle"] as string) == "repair")
    {
        <partial name="_FooterRepair" />
    }
    else
    {
    <div class="rts-footer-area footer-bg-1" id="rts-footer">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="footer-wrapper-style-between">
                                <div class="single-wized logo-area">
                                    <a asp-controller="Home" asp-action="Index" class="logo">
                                        <img src="@Url.Content(Site.Current.FooterLogoPath)" width="99" alt="@Site.Current.SiteName">
                                    </a>
                                    <p class="desc">@Site.Current.FooterText</p>
                                    @if (Site.Current.HasSocialLinks)
                                    {
                                        <div class="d-flex flex-wrap gap-2 mt-3">
                                            @if (!string.IsNullOrWhiteSpace(Site.Current.FacebookUrl))
                                            {
                                                <a href="@Site.Current.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook">Facebook</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(Site.Current.InstagramUrl))
                                            {
                                                <a href="@Site.Current.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(Site.Current.YoutubeUrl))
                                            {
                                                <a href="@Site.Current.YoutubeUrl" target="_blank" rel="noopener noreferrer" aria-label="YouTube">YouTube</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(Site.Current.TwitterUrl))
                                            {
                                                <a href="@Site.Current.TwitterUrl" target="_blank" rel="noopener noreferrer" aria-label="Twitter">Twitter</a>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="single-wized">
                                    <div class="wized-title">
                                        <h5 class="title">Quick Links</h5>
                                    </div>
                                    <div class="wized-body">
                                        <ul class="menu-nav">
                                            <li><a asp-controller="Home" asp-action="Index">Dealership</a></li>
                                            <li><a asp-controller="About" asp-action="Index">About Us</a></li>
                                            <li><a asp-controller="Cars" asp-action="Index">Listing</a></li>
                                            <li><a asp-controller="Shop" asp-action="Index">Spare Parts</a></li>
                                            <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="single-wized">
                                    <div class="wized-title">
                                        <h5 class="title">Contact Info</h5>
                                    </div>
                                    <div class="wized-body">
                                        <div class="contact-inner">
                                            <div class="single-contact">
                                                <i class="rt-icon-phone"></i>
                                                <div class="content">
                                                    <span>Call the store</span>
                                                    <a class="number" href="@Site.Contact.TelHref" aria-label="Call AutoVault at @Site.Contact.DisplayPhone">@Site.Contact.DisplayPhone</a>
                                                </div>
                                            </div>
                                            <div class="single-contact">
                                                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
                                                <div class="content">
                                                    <span>WhatsApp</span>
                                                    <a class="number"
                                                       href="@Site.Contact.WhatsAppHref"
                                                       data-contact-action="whatsapp"
                                                       target="_blank"
                                                       rel="noopener noreferrer"
                                                       aria-label="Open a WhatsApp chat with AutoVault (not a phone call)">WhatsApp</a>
                                                </div>
                                            </div>
                                            <div class="single-contact">
                                                <i class="rt-icon-mail"></i>
                                                <div class="content">
                                                    <span>Email</span>
                                                    <a class="number" href="@Site.Contact.MailtoHref">@Site.Contact.Email</a>
                                                </div>
                                            </div>
                                            <div class="single-contact">
                                                <i class="rt-icon-location"></i>
                                                <div class="content">
                                                    <span>Location</span>
                                                    <a class="number" href="@Site.Contact.MapsHref" target="_blank" rel="noopener">@Site.Contact.AddressLine</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="copyright-area">
                    <div class="container">
                        <div class="copyright-area-inner d-flex align-items-center justify-content-between">
                            <p>@Site.Current.FormatCopyright(DateTime.Now.Year)</p>
                            <div class="menu">
                                <ul>
                                    <li><a asp-controller="Home" asp-action="Terms">Terms & Conditions</a></li>
                                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
    </div>
    }

    @if ((ViewData["HeaderStyle"] as string) == "five")
    {
        <partial name="_WashSidebar" />
    }
    else if ((ViewData["HeaderStyle"] as string) == "six")
    {
        <partial name="_RepairSidebar" />
    }
    else
    {
    <div id="side-bar" class="side-bar header-two">
        <button class="close-icon-menu"><i class="far fa-times"></i></button>
        <div class="mobile-menu-main">
            <nav class="nav-main mainmenu-nav mt--30">
                <ul class="mainmenu metismenu" id="mobile-menu-active">
                    <partial name="_PublicNav" model="@("mobile")" />
                </ul>
            </nav>
        </div>
    </div>
    }

    <script src="~/assets/js/plugins/jquery.js"></script>
    <script src="~/assets/js/plugins/jquery-ui.js"></script>
    <script src="~/assets/js/vendor/waw.js"></script>
    <script src="~/assets/js/plugins/counter-up.js"></script>
    <script src="~/assets/js/plugins/contact-form.js" asp-append-version="true"></script>
    <script src="~/assets/js/plugins/swiper.js"></script>
    <script src="~/assets/js/plugins/metismenu.js"></script>
    <script src="~/assets/js/vendor/jarallax.js"></script>
    <script src="~/assets/js/plugins/smooth-scroll.js"></script>
    <script src="~/assets/js/plugins/magnifying-popup.js"></script>
    <script src="~/assets/js/vendor/bootstrap.min.js"></script>
    <script src="~/assets/js/vendor/waypoint.js"></script>
    <script src="~/assets/js/main.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    
    <script src="~/js/plugins/add-new-dropdown.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .account-notify-wrap { position:relative; display:inline-flex; align-items:center; gap:10px; overflow:visible; }
    .nav-notification-badge {
        position:absolute; top:-10px; right:-10px; min-width:22px; height:22px; padding:0 7px;
        border-radius:999px; background:#e11d48; color:#fff !important; font-size:11px; font-weight:700;
        line-height:22px; text-align:center; text-decoration:none; z-index:20;
        box-shadow:0 0 0 2px #fff; pointer-events:auto; cursor:pointer;
    }
    .nav-notification-badge[hidden] { display:none !important; }
    .nav-notification-badge:hover,
    .nav-notification-badge:focus { color:#fff !important; background:#be123c; outline:none; }
    .header-two .header-top .left { width:100%; justify-content:flex-start; }
</style>
