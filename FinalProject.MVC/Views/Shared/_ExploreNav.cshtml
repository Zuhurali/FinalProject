}
else
{
    <li class="main-nav has-dropdown">
        <a class="main-menu" href="javascript:void(0)">Explore</a>
        <ul class="submenu parent-nav">
            <li><a asp-controller="Cars" asp-action="MostViewed">Most Viewed Cars</a></li>
            <li><a asp-controller="Cars" asp-action="MostFavorited">Most Favorited Cars</a></li>
            <li><a asp-controller="Cars" asp-action="Latest">Latest Arrivals</a></li>
        </ul>
    </li>
