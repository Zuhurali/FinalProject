@model string
@if (Model == "mobile")
{
    <li class="has-droupdown">
        <a href="#" class="main">Explore</a>
        <ul class="submenu mm-collapse">
            <li><a class="mobile-menu-link" asp-controller="Cars" asp-action="MostViewed">Most Viewed Cars</a></li>
            <li><a class="mobile-menu-link" asp-controller="Cars" asp-action="MostFavorited">Most Favorited Cars</a></li>
            <li><a class="mobile-menu-link" asp-controller="Cars" asp-action="Latest">Latest Arrivals</a></li>
        </ul>
