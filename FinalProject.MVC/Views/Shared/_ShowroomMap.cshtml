@model int
@{
    var height = Model > 0 ? Model : 250;
    var contact = ContactPage.Current;
}
<div class="contact-map-area-fluid">
    <iframe class="contact-map" height="@height" title="@contact.MapTitle" src="@contact.MapEmbedUrl" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>
<p>@Site.Contact.AddressLine</p>
<a href="@Site.Contact.MapsHref" target="_blank" rel="noopener">Open in Maps</a>
