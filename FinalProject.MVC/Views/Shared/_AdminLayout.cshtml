<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        body.admin-shell { background:#f4f6f8; }
        .admin-sidebar { background:#111827; min-height:100vh; color:#fff; padding:24px 16px; }
        .admin-sidebar a { display:block; color:#d1d5db; padding:10px 12px; border-radius:8px; }
        .admin-sidebar a:hover, .admin-sidebar a.active { background:#1f2937; color:#fff; }
        .admin-main { padding:28px; }
        .admin-card { background:#fff; border-radius:12px; padding:18px; box-shadow:0 1px 3px rgba(0,0,0,.08); }
        .admin-stat { font-size:28px; font-weight:700; }
    </style>
</head>
<body class="admin-shell">
    <div class="container-fluid">
        <div class="row">
            <aside class="col-lg-2 admin-sidebar">
                <h4 class="mb-4">AutoVault</h4>
                <a asp-controller="Admin" asp-action="Index">Dashboard</a>
                <a asp-controller="AdminCars" asp-action="Index">Cars</a>
                <a asp-controller="AdminParts" asp-action="Index">Parts</a>
                <a asp-controller="AdminCampaigns" asp-action="Index">Campaigns</a>
                <a asp-controller="AdminSales" asp-action="Index">In-Store Sales</a>
                <a asp-controller="AdminBrands" asp-action="Index">Brands</a>
                <a asp-controller="AdminCategories" asp-action="Index">Categories</a>
                <a asp-controller="AdminRatings" asp-action="Index">Ratings</a>
                <a asp-controller="AdminReviews" asp-action="Index">Reviews</a>
                <a asp-controller="AdminRequests" asp-action="Index">Purchase Requests</a>
                <a asp-controller="AdminInquiries" asp-action="Index">Questions</a>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <a asp-controller="Admin" asp-action="Users">Users</a>
                }
                <a asp-controller="Home" asp-action="Index">View Site</a>
                <form asp-controller="Account" asp-action="SignOut" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            </aside>
            <main class="col-lg-10 admin-main">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" aria-label="Close" onclick="this.parentElement.remove()"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" aria-label="Close" onclick="this.parentElement.remove()"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
</body>
@await RenderSectionAsync("Scripts", required: false)
</html>
