<header class="header-three header--sticky">
    <div class="header-top">
        <div class="container">
            <div class="header-top-inner d-flex align-items-center justify-content-between">
                <div class="left d-flex align-items-center">
                    <div class="map-area">
                        <i class="rt-icon-phone-flip"></i>
                        <a href="@DealershipContactOptions.Value.TelHref" aria-label="Call AutoVault at @DealershipContactOptions.Value.DisplayPhone">@DealershipContactOptions.Value.DisplayPhone</a>
                    </div>
                    <div class="map-area">
                        <i class="rt-icon-envelope"></i>
                        <a href="@DealershipContactOptions.Value.MailtoHref">@DealershipContactOptions.Value.Email</a>
                    </div>
                    <div class="map-area">
                        <i class="rt-icon-marker"></i>
                        <a href="@DealershipContactOptions.Value.MapsHref" target="_blank" rel="noopener">@DealershipContactOptions.Value.AddressLine</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="header-bottom">
            <div class="row">
                <div class="col-lg-12">
                    <div class="header-wrapper-1">
                        <div class="logo-area-start">
                            <a asp-controller="Home" asp-action="Index" class="logo">
                                <img src="~/assets/images/logo/logo.svg" width="99" alt="logo_area">
                            </a>
                        </div>
                        <div class="header-right d-block">
                            <div class="bottom d-flex align-items-center justify-content-between">
                                <div class="nav-area">
                                    <ul>
                                        <partial name="_PublicNav" model="@("desktop")" />
                                    </ul>
                                </div>
                                <div class="bottom-right">
                                    <div class="button-area">
                                        <a asp-controller="Account" asp-action="@(User.Identity?.IsAuthenticated == true ? "Index" : "SignIn")" class="rts-btn btn-border radius-small icon" title="@(User.Identity?.IsAuthenticated == true ? User.Identity?.Name : null)">
                                            @(User.Identity?.IsAuthenticated == true ? "Account" : "Sign In")
                                            <partial name="_SignInIcon" />
                                        </a>
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <form asp-controller="Account" asp-action="SignOut" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="rts-btn btn-border radius-small">Sign Out</button>
                                            </form>
                                        }

                                        <partial name="_AddNewDropdown" />
                                    </div>
                                    <div class="menu-btn radius-small" id="menu-btn">
                                        <svg width="55" height="55" viewBox="0 0 55 55" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <rect width="55" height="55" rx="15" fill="#FF3600" />
                                            <rect x="18" y="33" width="10" height="2" fill="#ffffff" />
                                            <rect x="18" y="26" width="20" height="2" fill="#ffffff" />
                                            <rect x="18" y="19" width="10" height="2" fill="#ffffff" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
