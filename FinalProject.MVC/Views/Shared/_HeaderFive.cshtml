            <header class="header-five header--sticky">
                <div class="header-top">
                    <div class="container">
                        <div class="inner">
                            <div class="logo-area">
                                <a asp-controller="Home" asp-action="Index"><img src="~/assets/images/logo/logo.svg" width="99" alt=""></a>
                            </div>
                            <div class="get-touch-area">
                                <div class="map-area">
                                    <div class="icon">
                                        <i class="rt-icon-phone-flip"></i>
                                    </div>
                                    <div class="text">
                                        <p>Call Us Now</p>
                                        <a href="@DealershipContactOptions.Value.TelHref" aria-label="Call AutoVault at @DealershipContactOptions.Value.DisplayPhone">@DealershipContactOptions.Value.DisplayPhone</a>
                                    </div>
                                </div>
                                <div class="map-area">
                                    <div class="icon">
                                        <i class="rt-icon-envelope"></i>
                                    </div>
                                    <div class="text">
                                        <p>Send US Email</p>
                                        <a href="@DealershipContactOptions.Value.MailtoHref">@DealershipContactOptions.Value.Email</a>
                                    </div>
                                </div>
                                <div class="map-area">
                                    <div class="icon">
                                        <i class="rt-icon-marker"></i>
                                    </div>
                                    <div class="text">
                                        <p>Our Location</p>
                                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Baku%20Auto%20Mall%2C%20Babek%20Prospekti%2022-24%2C%20Baku%2C%20Azerbaijan" target="_blank" rel="noopener">Babek Prospekti 22–24, Baku, Azerbaijan</a>
                                    </div>
                                </div>
                            </div>
                            <div class="button-area d-flex">
                                <a asp-controller="Account" asp-action="@(User.Identity?.IsAuthenticated == true ? "Index" : "SignIn")" class="rts-btn btn-border icon" title="@(User.Identity?.IsAuthenticated == true ? User.Identity?.Name : null)">
                                    @(User.Identity?.IsAuthenticated == true ? "Account" : "Sign In")
                                    <partial name="_SignInIcon" />
                                </a>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Account" asp-action="SignOut" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="rts-btn btn-border icon">Sign Out</button>
                                    </form>
                                }

                                <partial name="_AddNewDropdown" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="header-wrapper-5">
                                <div class="header-right d-block">
                                    <div class="bottom d-flex align-items-center justify-content-between">
                                        <div class="logo-area">
                                            <a asp-controller="Home" asp-action="Index"><img src="~/assets/images/logo/logo-w.svg" width="99" alt=""></a>
                                        </div>
                                        <div class="nav-area">
                                            <ul class="">
                                                <partial name="_PublicNav" model="@("desktop")" />
                                            </ul>
                                        </div>
                                        <div class="bottom-right">
                                            <div class="social-area-transparent">
                                                <div class="search-area">
                                                    <a href="JavaScript:void(0)" class="search"><img src="~/assets/images/icon/search-w.svg" alt=""></a>
                                                </div>
                                            </div>
                                            <div class="menu-btn" id="menu-btn">
                                                <svg width="20" height="16" viewBox="0 0 20 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <rect y="14" width="20" height="2" fill="#FF3600"></rect>
                                                    <rect y="7" width="20" height="2" fill="#FF3600"></rect>
                                                    <rect width="20" height="2" fill="#FF3600"></rect>
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
