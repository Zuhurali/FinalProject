@model Car
@using FinalProject.MVC.Commerce
@{
    var imagePath = string.IsNullOrWhiteSpace(Model.ImagePath) ? string.Empty : Model.ImagePath;
    var conditionBadge = HomeCarShowcase.ConditionBadge(Model);
    var stockBadge = HomeCarShowcase.StockBadge(Model);
    var stockClass = HomeCarShowcase.IsInStock(Model) ? "in-stock" : "out-of-stock";
    var stockOnlyBadges = ViewData["StockOnlyBadges"] is true;
    var hideStockBadge = ViewData["HideStockBadge"] is true;
}
<div class="project-wrapper3 home-car-card">
    <div class="image-area">
        <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id">
            @if (!string.IsNullOrWhiteSpace(imagePath))
            {
                <img src="@Url.Content(imagePath)" alt="@Model.Name">
            }
        </a>
        <div class="home-car-badges" aria-label="@(stockOnlyBadges ? "Vehicle availability" : hideStockBadge ? "Vehicle condition" : "Vehicle condition and availability")">
            @if (!stockOnlyBadges)
            {
                <span class="home-car-badge condition">@conditionBadge</span>
            }
            @if (!hideStockBadge)
            {
                <span class="home-car-badge stock @stockClass">@stockBadge</span>
            }
        </div>
        <span class="home-car-brand">@Model.Make</span>
        <span class="price">$@Model.Price.ToString("N0")</span>
    </div>
    <div class="content-area">
        <h6 class="title">
            <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
        </h6>
        <ul class="feature-area">
            <li><img src="~/assets/images/portfolio/feature-icon/01.svg" alt=""> @Model.MileageText</li>
            <li><img src="~/assets/images/portfolio/feature-icon/02.svg" alt=""> @Model.Fuel</li>
            <li><img src="~/assets/images/portfolio/feature-icon/03.svg" alt=""> @Model.Transmission</li>
        </ul>
        <div class="button-area">
            <p>@Model.Year</p>
            <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id" class="rts-btn btn-primary radius-small">View Details</a>
        </div>
    </div>
</div>
