@model TeamMemberEditViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Edit team member"; }
<h1 class="h3 mb-4">Edit team member</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-card">
    @Html.AntiForgeryToken()
    <partial name="_TeamForm" />
    <button type="submit" class="btn btn-dark mt-3">Save</button>
</form>
