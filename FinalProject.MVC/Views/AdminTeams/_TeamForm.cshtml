@model TeamMemberEditViewModel
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Position" class="form-label"></label><input asp-for="Position" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Experience" class="form-label"></label><input asp-for="Experience" class="form-control" /></div>
    <div class="col-12"><label asp-for="Biography" class="form-label"></label><textarea asp-for="Biography" class="form-control" rows="4"></textarea></div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" inputmode="tel" autocomplete="tel" spellcheck="false" pattern="^(0[0-9]{9}|\+994[0-9]{9})$" title="@AzerbaijanPhoneNumber.ErrorMessage" data-team-phone="true" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control" /></div>
    <div class="col-md-4 d-flex align-items-end"><div class="form-check"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label"></label></div></div>
    <div class="col-md-6"><label class="form-label">Photo</label><input type="hidden" asp-for="ImagePath" />@if (!string.IsNullOrWhiteSpace(Model.ImagePath)) { <img src="@Url.Content(Model.ImagePath)" alt="" style="max-height:64px;display:block;" /> }<input type="file" name="image" class="form-control mt-1" accept="image/*" /><span asp-validation-for="ImagePath" class="text-danger"></span></div>
</div>
<script src="~/js/team-member-phone.js" asp-append-version="true"></script>
