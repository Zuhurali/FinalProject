@model CarDiscoveryStatisticsDto
@{
    Layout = "_AdminLayout";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Car statistics</h1>
        <p class="text-muted mb-0">Views, favorites, and the last 14 days of detail-page opens. Today and the last 7 days use the Baku calendar.</p>
    </div>
</div>
@if (ViewData["ServiceUnavailable"] != null)
{
    <div class="alert alert-warning">Car statistics are temporarily unavailable.</div>
}
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="admin-card"><div class="text-muted">All views</div><div class="admin-stat">@Model.TotalViews</div></div></div>
    <div class="col-md-3"><div class="admin-card"><div class="text-muted">Views today</div><div class="admin-stat">@Model.ViewsToday</div></div></div>
    <div class="col-md-3"><div class="admin-card"><div class="text-muted">Last 7 days</div><div class="admin-stat">@Model.ViewsLast7Days</div></div></div>
    <div class="col-md-3"><div class="admin-card"><div class="text-muted">Current favorites</div><div class="admin-stat">@Model.TotalFavorites</div></div></div>
</div>
<div class="row g-3">
    <div class="col-lg-5">
        <div class="admin-card">
            <h2 class="h5">Daily views</h2>
            <table class="table table-sm mb-0">
                <thead><tr><th>Date</th><th class="text-end">Views</th></tr></thead>
                <tbody>
                @foreach (var day in Model.DailyViews)
                {
                    <tr><td>@day.Date</td><td class="text-end">@day.Views</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="admin-card mb-3">
            <h2 class="h5">Most viewed</h2>
            @if (Model.MostViewed.Count == 0)
            {
                <p class="mb-0 text-muted">No views yet.</p>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var item in Model.MostViewed)
                    {
                        <li>@item.Car.Brand?.Name @item.Car.Model — @item.Count</li>
                    }
                </ul>
            }
        </div>
        <div class="admin-card">
            <h2 class="h5">Most favorited</h2>
            @if (Model.MostFavorited.Count == 0)
            {
                <p class="mb-0 text-muted">No favorites yet.</p>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var item in Model.MostFavorited)
                    {
                        <li>@item.Car.Brand?.Name @item.Car.Model — @item.Count</li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
