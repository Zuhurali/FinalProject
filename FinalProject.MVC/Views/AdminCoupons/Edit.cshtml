@model Coupon
@{
    Layout = "_AdminLayout";
    var products = (IEnumerable<SelectListItem>)ViewBag.Products;
    var isEdit = Model.Id > 0;
}
<h1 class="h3 mb-4">@(isEdit ? "Edit coupon" : "Create coupon")</h1>
<form asp-action="Save" method="post" class="admin-card">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedAt" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Code" class="form-label">Code</label>
            <input asp-for="Code" class="form-control" maxlength="50" required />
        </div>
        <div class="col-md-8">
            <label asp-for="Name" class="form-label">Display name</label>
            <input asp-for="Name" class="form-control" maxlength="200" required />
        </div>
        <div class="col-md-3">
            <label asp-for="DiscountPercent" class="form-label">Discount %</label>
            <input asp-for="DiscountPercent" class="form-control" type="number" min="0.01" max="100" step="0.01" required />
        </div>
        <div class="col-md-3">
            <label asp-for="MinimumPurchaseAmount" class="form-label">Min purchase</label>
            <input asp-for="MinimumPurchaseAmount" class="form-control" type="number" min="0" step="0.01" />
        </div>
        <div class="col-md-3">
            <label asp-for="MaxUsesPerUser" class="form-label">Max uses / user</label>
            <input asp-for="MaxUsesPerUser" class="form-control" type="number" min="1" />
        </div>
        <div class="col-md-3">
            <label asp-for="MaxTotalUses" class="form-label">Max total uses</label>
            <input asp-for="MaxTotalUses" class="form-control" type="number" min="1" />
            <div class="form-text">Leave blank for unlimited.</div>
        </div>
        <div class="col-md-4">
            <label asp-for="ExpiresAt" class="form-label">Expires at (UTC)</label>
            <input asp-for="ExpiresAt" class="form-control" type="datetime-local" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Scope</label>
            <select asp-for="AppliesToAllParts" class="form-select" id="coupon-scope">
                <option value="true">All spare parts</option>
                <option value="false">Single part</option>
            </select>
        </div>
        <div class="col-md-4" id="coupon-product-wrap">
            <label asp-for="ProductId" class="form-label">Product</label>
            <select asp-for="ProductId" class="form-select" asp-items="products">
                <option value="">Select a part</option>
            </select>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
<script>
(() => {
    const scope = document.getElementById('coupon-scope');
    const wrap = document.getElementById('coupon-product-wrap');
    const sync = () => {
        const all = scope?.value === 'true';
        if (wrap) wrap.style.display = all ? 'none' : '';
    };
    scope?.addEventListener('change', sync);
    sync();
})();
</script>
