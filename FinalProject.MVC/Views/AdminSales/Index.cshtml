@model IReadOnlyList<InPersonSale>
@{
    Layout = "_AdminLayout";
    var products = (IReadOnlyList<ShopProduct>)ViewBag.Products;
}
<h1 class="h3 mb-4">In-person sales</h1>
<p class="text-muted">If a spare-parts campaign is Live, the unit price below uses the campaign discount automatically. Car sales are not recorded here.</p>
<form method="post" class="admin-card mb-4" id="sale-form">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-5">
            <label>Product</label>
            <select name="productId" id="sale-product" class="form-control">
                @foreach (var product in products)
                {
                    var priceLabel = product.HasOffer
                        ? $"{product.Price:C} → {product.SalePrice:C} ({product.DiscountPercent}% OFF)"
                        : product.Price.ToString("C");
                    <option value="@product.Id"
                            data-list="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-sale="@product.EffectivePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-offer="@(product.HasOffer ? "1" : "0")"
                            data-percent="@(product.DiscountPercent?.ToString() ?? "")">
                        @product.Name — @priceLabel — @product.StockStatus (@product.Quantity)
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label>Quantity</label>
            <input name="quantity" type="number" min="1" value="1" class="form-control" required />
        </div>
        <div class="col-md-5">
            <label>Note</label>
            <input name="note" class="form-control" maxlength="500" />
        </div>
        <div class="col-12">
            <div class="alert alert-light border mb-0" id="sale-price-preview">Select a part to see the unit price that will be recorded.</div>
        </div>
    </div>
    <button class="btn btn-primary mt-3" type="submit">Record in-store sale</button>
</form>
<div class="admin-card">
    <table class="table">
        <thead><tr><th>When (UTC)</th><th>Product</th><th>Qty</th><th>List</th><th>Unit charged</th><th>Campaign</th><th>Source</th><th>Note</th></tr></thead>
        <tbody>
        @foreach (var sale in Model)
        {
            <tr>
                <td>@sale.SoldAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(sale.Product?.Name ?? $"Product #{sale.ProductId}")</td>
                <td>@sale.Quantity</td>
                <td>@(sale.ListUnitPrice > 0 ? sale.ListUnitPrice.ToString("C") : "—")</td>
                <td>@sale.UnitPrice.ToString("C")</td>
                <td>
                    @if (sale.CampaignDiscountPercent.HasValue)
                    {
                        <text>@($"{sale.CampaignDiscountPercent:0.#}% OFF")</text>
                        @if (!string.IsNullOrWhiteSpace(sale.Campaign?.Name))
                        {
                            <div class="small text-muted">@sale.Campaign.Name</div>
                        }
                    }
                    else
                    {
                        <text>—</text>
                    }
                </td>
                <td>@(sale.IsDemo ? "Demo (simulated)" : "Recorded sale")</td>
                <td>@sale.Note</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<script>
(() => {
    const select = document.getElementById('sale-product');
    const preview = document.getElementById('sale-price-preview');
    const money = (value) => new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' }).format(value);
    const update = () => {
        const option = select?.selectedOptions?.[0];
        if (!option) return;
        const list = Number(option.dataset.list || 0);
        const sale = Number(option.dataset.sale || 0);
        const offer = option.dataset.offer === '1';
        const percent = option.dataset.percent;
        preview.innerHTML = offer
            ? `Live campaign: list ${money(list)} → charged <strong>${money(sale)}</strong> (${percent}% OFF). Stock will decrease by the quantity entered.`
            : `No live campaign. Charged unit price: <strong>${money(sale)}</strong>.`;
    };
    select?.addEventListener('change', update);
    update();
})();
</script>
<div class="admin-card mt-4">
    <h2 class="h4">Popular Items ranking</h2>
    <p>@ViewBag.Formula The ranking score is this formula's result. It is shown here so the order can be checked. Customers do not see it.</p>
    <table class="table">
        <thead>
            <tr>
                <th>Rank</th>
                <th>Part</th>
                <th>Added (UTC)</th>
                <th>Average</th>
                <th>Ratings</th>
                <th>Reviews</th>
                <th>Recorded sales</th>
                <th>Demo sales (simulated)</th>
                <th>Ranking score</th>
            </tr>
        </thead>
        <tbody>
        @{
            var rank = 1;
            var ranking = (IReadOnlyList<ShopProduct>)ViewBag.Ranking;
        }
        @foreach (var product in ranking)
        {
            <tr>
                <td>@rank</td>
                <td>@product.Name</td>
                <td>@product.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>@product.Rating.ToString("0.00")</td>
                <td>@product.RatingCount</td>
                <td>@product.ReviewCount</td>
                <td>@product.RealSalesCount</td>
                <td>@product.DemoSalesCount</td>
                <td>@product.PopularityScore.ToString("0.000")</td>
            </tr>
            rank++;
        }
        </tbody>
    </table>
</div>
