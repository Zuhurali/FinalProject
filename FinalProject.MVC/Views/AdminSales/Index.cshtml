@model IReadOnlyList<InPersonSale>
@{
    Layout = "_AdminLayout";
    var products = (IReadOnlyList<ShopProduct>)ViewBag.Products;
    var submissionKey = (Guid)ViewBag.SubmissionKey;
}
<h1 class="h3 mb-4">In-person sales</h1>
<p class="text-muted">AutoVault does not take online payment. Record store counter sales here (SQL <code>InPersonSales</code> + stock). Live campaigns adjust unit price automatically.</p>
<form method="post" class="admin-card mb-4" id="sale-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="submissionKey" value="@submissionKey" />
    <div class="row g-3">
        <div class="col-md-5">
            <label>Product</label>
            <select name="productId" id="sale-product" class="form-control">
                @foreach (var product in products)
                {
                    var priceLabel = product.HasOffer
                        ? $"{product.Price:C} → {product.SalePrice:C} ({product.DiscountPercent}% OFF)"
                        : product.Price.ToString("C");
                    <option value="@product.Id"
                            data-list="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-sale="@product.EffectivePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-offer="@(product.HasOffer ? "1" : "0")"
                            data-percent="@(product.DiscountPercent?.ToString() ?? "")"
                            data-stock="@product.Quantity">
                        @product.Name — @priceLabel — @product.StockStatus (@product.Quantity)
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label>Quantity</label>
            <input name="quantity" id="sale-quantity" type="number" min="1" value="1" class="form-control" required />
        </div>
        <div class="col-md-5">
            <label>Note</label>
            <input name="note" class="form-control" maxlength="500" />
        </div>
        <div class="col-12">
            <div class="alert alert-light border mb-0" id="sale-price-preview">Select a part to see the unit price that will be recorded.</div>
        </div>
    </div>
    <button class="btn btn-primary mt-3" type="submit" id="sale-submit">Record in-store sale</button>
</form>
<div class="admin-card">
    <h2 class="h5">Recorded sales</h2>
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No recorded in-store sales yet. Demo/simulated sales are not listed here.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>#</th><th>When (UTC)</th><th>Product</th><th>Qty</th><th>List</th><th>Unit charged</th><th>Campaign</th><th>Note</th><th></th></tr></thead>
            <tbody>
            @foreach (var sale in Model)
            {
                <tr>
                    <td>@sale.Id</td>
                    <td>@sale.SoldAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(sale.Product?.Name ?? $"Product #{sale.ProductId}")</td>
                    <td>@sale.Quantity</td>
                    <td>@(sale.ListUnitPrice > 0 ? sale.ListUnitPrice.ToString("C") : "—")</td>
                    <td>@sale.UnitPrice.ToString("C")</td>
                    <td>
                        @if (sale.CampaignDiscountPercent.HasValue)
                        {
                            <text>@($"{sale.CampaignDiscountPercent:0.#}% OFF")</text>
                            @if (!string.IsNullOrWhiteSpace(sale.Campaign?.Name))
                            {
                                <div class="small text-muted">@sale.Campaign.Name</div>
                            }
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </td>
                    <td>@sale.Note</td>
                    <td>
                        <form asp-action="Void"
                              asp-route-id="@sale.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Void sale #@sale.Id and restore @sale.Quantity to stock?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Void</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
<script>
(() => {
    const form = document.getElementById('sale-form');
    const select = document.getElementById('sale-product');
    const quantity = document.getElementById('sale-quantity');
    const preview = document.getElementById('sale-price-preview');
    const submit = document.getElementById('sale-submit');
    const money = (value) => new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' }).format(value);
    const update = () => {
        const option = select?.selectedOptions?.[0];
        if (!option) return;
        const list = Number(option.dataset.list || 0);
        const sale = Number(option.dataset.sale || 0);
        const offer = option.dataset.offer === '1';
        const percent = option.dataset.percent;
        const stock = Number(option.dataset.stock || 0);
        quantity.max = String(Math.max(1, stock));
        preview.innerHTML = offer
            ? `Live campaign: list ${money(list)} → charged <strong>${money(sale)}</strong> (${percent}% OFF). Stock will decrease by the quantity entered (available: ${stock}).`
            : `No live campaign. Charged unit price: <strong>${money(sale)}</strong>. Stock available: ${stock}.`;
    };
    select?.addEventListener('change', update);
    form?.addEventListener('submit', () => {
        if (submit) {
            submit.disabled = true;
            submit.textContent = 'Recording…';
        }
    });
    update();
})();
</script>
<div class="admin-card mt-4">
    <h2 class="h4">Popular Items ranking</h2>
    <p class="mb-3">@ViewBag.Formula</p>
    <p class="text-muted small">Average / Ratings / Reviews come from genuine customer submissions. Recorded sales are genuine in-store quantities only. Products with no activity show 0.</p>
    <table class="table">
        <thead>
            <tr>
                <th>Rank</th>
                <th>Part</th>
                <th>Added (UTC)</th>
                <th>Average</th>
                <th>Ratings</th>
                <th>Reviews</th>
                <th>Recorded sales</th>
                <th>Ranking score</th>
            </tr>
        </thead>
        <tbody>
        @{
            var rank = 1;
            var ranking = (IReadOnlyList<ShopProduct>)ViewBag.Ranking;
        }
        @foreach (var product in ranking)
        {
            <tr>
                <td>@rank</td>
                <td>@product.Name</td>
                <td>@product.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>@(product.RatingCount > 0 ? product.Rating.ToString("0.00") : "—")</td>
                <td>@product.RatingCount</td>
                <td>@product.ReviewCount</td>
                <td>@product.RealSalesCount</td>
                <td>@product.PopularityScore.ToString("0.000")</td>
            </tr>
            rank++;
        }
        </tbody>
    </table>
</div>
