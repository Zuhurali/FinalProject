@model FinalProject.MVC.Models.DealerDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Dealer.Name} - AutoVault";
    var dealer = Model.Dealer;
}

<div class="rts-portfolio-area inner pt--80">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <!-- rts breadcrumb area start -->
                <div class="rts-breadcrumb-area portfolio-details2 jarallax pt--0">
                    <div class="container">
                        <div class="breadcrumb-area-wrapper">
                            <div class="left">
                                <div class="nav-bread-crumb mb--25">
                                    <a asp-controller="Home" asp-action="Index">Home</a>
                                    <a asp-controller="Dealer" asp-action="Index" class="current">Dealer</a>
                                </div>
                                <h1 class="title">@dealer.Name</h1>
                                <ul class="feature-area dealer">
                                    <li>
                                        <img src="~/assets/images/portfolio/feature-icon/17.svg" alt="">
                                        <a href="@DealershipContactSettings.TelHrefFor(dealer.Phone)">@dealer.Phone</a>
                                    </li>
                                    <li>
                                        <img src="~/assets/images/portfolio/feature-icon/18.svg" alt="">
                                        <a href="mailto:@dealer.Email">@dealer.Email</a>
                                    </li>
                                    <li>
                                        <img src="~/assets/images/portfolio/feature-icon/19.svg" alt="">
                                        @dealer.Address
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="brand-image-area">
                            <img src="@Url.Content(dealer.DetailImage)" alt="@dealer.Name">
                        </div>
                    </div>
                </div>
                <!-- rts breadcrumb area end -->
                <div class="portfolio-details-area">
                    <h2 class="mb--30">Company Description</h2>
                    <p class="mb--30">@dealer.Description</p>
                    <p>@dealer.DescriptionExtra</p>
                    <h2 class="mb--30">Company Features</h2>
                    <ul class="feature-list mb--40">
                        <li><i class="fa-regular fa-circle-check"></i> Engine Type</li>
                        <li><i class="fa-regular fa-circle-check"></i> Horsepower</li>
                        <li><i class="fa-regular fa-circle-check"></i> Automatic Climate Control</li>
                        <li><i class="fa-regular fa-circle-check"></i> Touchscreen Display</li>
                        <li><i class="fa-regular fa-circle-check"></i> Navigation System</li>
                        <li><i class="fa-regular fa-circle-check"></i> Fog Lights</li>
                        <li><i class="fa-regular fa-circle-check"></i> Start-Stop Technology</li>
                        <li><i class="fa-regular fa-circle-check"></i> Automatic Headlights</li>
                        <li><i class="fa-regular fa-circle-check"></i> Navigation System</li>
                    </ul>
                    <h2 class="mb--30">Key Specs</h2>
                    <ul class="specs-list mb--40">
                        <li>
                            <span class="number">1</span>
                            <div class="text">
                                <h6>Car Transmission</h6>
                                <p>@dealer.SpecTransmission</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">2</span>
                            <div class="text">
                                <h6>@dealer.ChargingTime</h6>
                                <p>Level Two Charging</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">3</span>
                            <div class="text">
                                <h6>@dealer.BatteryCapacity</h6>
                                <p>Battery Capacity</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">4</span>
                            <div class="text">
                                <h6>@dealer.FastCharge</h6>
                                <p>Dc Fast Changing</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">5</span>
                            <div class="text">
                                <h6>Battery</h6>
                                <p>@dealer.BatteryWarranty</p>
                            </div>
                        </li>
                        <li>
                            <span class="number">6</span>
                            <div class="text">
                                <h6>Powertrain</h6>
                                <p>@dealer.PowertrainWarranty</p>
                            </div>
                        </li>
                    </ul>
                    <h2 class="mb--30">Car Engine </h2>
                    <ul class="feature-list2 mb--40">
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Displacement</p>
                                <p>@dealer.Displacement</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Torque</p>
                                <p>@dealer.Torque</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Horespower</p>
                                <p>@dealer.Horsepower</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Number of cylinders</p>
                                <p>@dealer.Cylinders</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Engine Layout</p>
                                <p>@dealer.EngineLayout</p>
                            </div>
                        </li>
                        <li>
                            <i class="fa-regular fa-circle-check"></i>
                            <div class="text">
                                <p>Engine Configurations</p>
                                <p>@dealer.EngineConfig</p>
                            </div>
                        </li>
                    </ul>
                    <form action="#" class="message-form mb--100" id="dealerMessageForm">
                        <h2>Send Message</h2>
                        <div class="form-inner">
                            <div class="input-wrapper">
                                <input type="text" name="Name" placeholder="Your Name" required>
                                <input type="email" name="Email" placeholder="Your Email*" required>
                                <input type="text" name="Phone" placeholder="Phone" required>
                            </div>
                            <textarea name="message" id="message" placeholder="Type a message*"></textarea>
                            <div class="form-bottom">
                                <label class="checkbox-label">
                                    <input type="checkbox" />
                                    <span>I accept The <a href="#">Privacy Policy</a></span>
                                </label>
                                <button class="rts-btn btn-primary radius-small" type="submit"><img src="~/assets/images/portfolio/send.svg" alt="">Submit Message</button>
                            </div>
                        </div>
                    </form>
                    <div class="related-project">
                        <h3 class="mb--40 text-center">Related listings</h3>
                        @if (ViewData["CarApiError"] is string carApiError)
                        {
                            <h3 class="title text-center">@carApiError</h3>
                        }
                        <div class="row">
                            @foreach (var car in Model.RelatedCars)
                            {
                                <div class="col-lg-6">
                                    <div class="project-wrapper2">
                                        <div class="image-area">
                                            <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id"><img src="@Url.Content(car.ImagePath)" alt="@car.Name"></a>
                                            <span class="tag">@car.Badge</span>
                                            <a href="#" class="wishlist"><i class="fa-regular fa-heart"></i></a>
                                            <a href="@Url.Content(car.ImagePath)" class="gallery-image">
                                                <img src="~/assets/images/icon/image.svg" alt="">
                                                @car.ImageCount
                                            </a>
                                        </div>
                                        <span class="price">@($"{car.Price:N0}$")</span>
                                        <div class="content-area">
                                            <h6 class="title "><a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id">@car.Name</a></h6>
                                            <ul class="feature-area">
                                                <li>
                                                    <img src="~/assets/images/portfolio/feature-icon/01.svg" alt="">
                                                    @($"{car.Mileage:N0} Miles")
                                                </li>
                                                <li>
                                                    <img src="~/assets/images/portfolio/feature-icon/02.svg" alt="">
                                                    @car.Fuel
                                                </li>
                                                <li>
                                                    <img src="~/assets/images/portfolio/feature-icon/03.svg" alt="">
                                                    @car.Transmission
                                                </li>
                                            </ul>
                                            <div class="button-area">
                                                <p class="">@($"${car.Price:N0}")</p>
                                                <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" class="rts-btn btn-primary radius-small">View Details</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="sticky-top">
                    <div class="left-side-bar">
                        <div class="overview side-box">
                            <h2>Car Overview</h2>
                            <ul class="feature-list2 mb--40">
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/09.svg" alt="">
                                    <div class="text">
                                        <p>Car Type</p>
                                        <p>@dealer.CarType</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/10.svg" alt="">
                                    <div class="text">
                                        <p>Mileage</p>
                                        <p>@dealer.Mileage</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/11.svg" alt="">
                                    <div class="text">
                                        <p>Fuel Type</p>
                                        <p>@dealer.FuelType</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/12.svg" alt="">
                                    <div class="text">
                                        <p>Transmission</p>
                                        <p>@dealer.Transmission</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/13.svg" alt="">
                                    <div class="text">
                                        <p>Person</p>
                                        <p>@dealer.Person</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/14.svg" alt="">
                                    <div class="text">
                                        <p>Drive Type</p>
                                        <p>@dealer.DriveType</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/15.svg" alt="">
                                    <div class="text">
                                        <p>Engine</p>
                                        <p>@dealer.Engine</p>
                                    </div>
                                </li>
                                <li>
                                    <img src="~/assets/images/portfolio/feature-icon/16.svg" alt="">
                                    <div class="text">
                                        <p>Color</p>
                                        <p>@dealer.Color</p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="map-area side-box">
                            <h2>Location</h2>
                            <partial name="_ShowroomMap" model="250" />
                        </div>
                        <div class="contact side-box">
                            <h2>Contacts</h2>
                            <div class="contact-inner">
                                <div class="author-img">
                                    <img src="~/assets/images/portfolio/author.webp" alt="">
                                </div>
                                <h5>@dealer.ContactName</h5>
                                <p>@dealer.ContactRole</p>
                                <div class="contact-button-area">
                                    <partial name="_DealershipContactButtons" />
                                    <a href="#dealerMessageForm" class="rts-btn radius-small telegram"><img src="~/assets/images/portfolio/send.svg" alt=""> Send Message</a>
                                </div>
                            </div>
                        </div>
                        <div class="social-area side-box">
                            <h2>Share</h2>
                            <ul>
                                <li><i class="fa-brands fa-facebook-f"></i></li>
                                <li><i class="fa-brands fa-twitter"></i></li>
                                <li><i class="fa-brands fa-instagram"></i></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_DealershipCallCta" />

@section Scripts {
    <script>
        document.getElementById("dealerMessageForm")?.addEventListener("submit", function (event) {
            event.preventDefault();
        });
    </script>
}
