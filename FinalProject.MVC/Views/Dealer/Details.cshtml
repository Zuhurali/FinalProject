@{
    ViewData["Title"] = "Dealer Details - AutoVault";
}

<!-- Content based on car-dealer-details.html -->
<div class="rts-breadcrumb-area service jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Dealer Details</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Dealer" asp-action="Index">Dealers</a>
                <a href="#" class="current">Details</a>
            </div>
        </div>
    </div>
</div>

<section class="rts-section-gap">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="dealer-details-area">
                    <div class="image-area">
                        <img src="~/assets/images/about/03.webp" alt="">
                    </div>
                    <h3>AutoVault Central Dealership</h3>
                    <p>Welcome to AutoVault Central, your premier automotive destination in Toronto. We offer a comprehensive range of vehicles and services.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="dealer-info-sidebar">
                    <h4>Contact Information</h4>
                    <div class="contact-info">
                        <p><i class="rt-icon-phone"></i> +994 50 354 67 67</p>
                        <p><i class="rt-icon-mail"></i> info@autovault.com</p>
                        <p><i class="rt-icon-location"></i> Toronto.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>