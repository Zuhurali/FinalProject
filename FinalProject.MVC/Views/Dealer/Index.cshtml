@model IReadOnlyList<FinalProject.MVC.Models.Dealer>
@{
    ViewData["Title"] = "Dealer List - AutoVault";
    var total = Model.Count;
}

<!-- rts breadcrumb area start -->
<div class="rts-breadcrumb-area portfolio-3 jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">Dealer List</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">Dealer</a>
            </div>
        </div>
    </div>
</div>
<!-- rts breadcrumb area end -->

<div class="rts-shop-area inner rts-section-gapTop">
    <div class="container">
        <div class="shop-filter-area">
            <p>Showing 1-@total of @total results</p>
            <div class="select-area">
                <form class="select-2" id="dealerSortForm" action="#" method="get" accept-charset="utf-8">
                    <select name="my_select2" class="my_select2">
                        <option value="2" selected>Sort By Latest</option>
                        <option value="10">Top</option>
                        <option value="1">Price low to high</option>
                        <option value="13">Price high to low</option>
                        <option value="14">Best Matching</option>
                    </select>
                </form>
            </div>
        </div>
        <div class="row g-5">
            @foreach (var dealer in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="dealer-wrapper">
                        <div class="image-area">
                            <a asp-controller="Dealer" asp-action="Details" asp-route-id="@dealer.Id">
                                <img src="@Url.Content(dealer.CardImage)" alt="@dealer.Name">
                            </a>
                        </div>
                        <div class="content-area">
                            <h6 class="title "><a asp-controller="Dealer" asp-action="Details" asp-route-id="@dealer.Id">@dealer.Name</a></h6>
                            <p>@dealer.Summary</p>
                            <div class="button-area">
                                <a asp-controller="Dealer" asp-action="Details" asp-route-id="@dealer.Id" class="rts-btn btn-primary radius-small">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <a href="#" class="rts-btn load-more-btn btn-border" id="dealerLoadMore">Load More</a>
    </div>
</div>

<partial name="_DealershipCallCta" />

@section Scripts {
    <script>
        document.getElementById("dealerLoadMore")?.addEventListener("click", function (event) {
            event.preventDefault();
        });
        document.getElementById("dealerSortForm")?.addEventListener("submit", function (event) {
            event.preventDefault();
        });
    </script>
}
