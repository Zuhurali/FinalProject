@model IReadOnlyList<FinalProject.MVC.Models.Dealer>
@{
    var cms = ViewData["DealerPage"] as DealerPagePublicContent ?? DealerPage.Current;
    ViewData["Title"] = cms.SeoTitle;
    ViewData["MetaDescription"] = cms.SeoDescription;
    var total = Model.Count;
}

<!-- rts breadcrumb area start -->
<div class="rts-breadcrumb-area portfolio-3 jarallax">
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">@cms.PageTitle</h1>
            <div class="nav-bread-crumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#" class="current">@cms.BreadcrumbTitle</a>
            </div>
        </div>
    </div>
</div>
<!-- rts breadcrumb area end -->

<div class="rts-shop-area inner rts-section-gapTop">
    <div class="container">
        <div class="shop-filter-area">
            <p>Showing 1-@total of @total results</p>
        </div>
        <div class="row g-5">
            @foreach (var dealer in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="dealer-wrapper">
                        <div class="image-area">
                            <a asp-controller="Dealer" asp-action="Details" asp-route-id="@dealer.Id">
                                <img src="@Url.Content(dealer.CardImage)" alt="@dealer.Name">
                            </a>
                        </div>
                        <div class="content-area">
                            <h6 class="title "><a asp-controller="Dealer" asp-action="Details" asp-route-id="@dealer.Id">@dealer.Name</a></h6>
                            <p>@dealer.Summary</p>
                            <div class="button-area">
                                <a asp-controller="Dealer" asp-action="Details" asp-route-id="@dealer.Id" class="rts-btn btn-primary radius-small">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<partial name="_DealershipCallCta" />
